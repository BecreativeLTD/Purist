  const resultDownload = document.getElementById('ag-result-download') as HTMLAnchorElement;

  generateBtn.addEventListener('click', async () => {
    errorEl.classList.add('hidden');
    const prompt = promptInput.value.trim();
    const email = (document.getElementById('ag-email') as HTMLInputElement).value.trim();
    const aspectRatio = (document.getElementById('ag-aspect') as HTMLSelectElement).value;
    const negative = (document.getElementById('ag-negative') as HTMLInputElement).value.trim();
    const usingOwnKey = keyOwnBtn.classList.contains('is-active');
    const apiKey = usingOwnKey ? (document.getElementById('ag-apikey') as HTMLInputElement).value.trim() : '';

    if (!prompt) { errorEl.textContent = 'Write or pick a prompt first.'; errorEl.classList.remove('hidden'); return; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { errorEl.textContent = 'Enter a valid email to continue.'; errorEl.classList.remove('hidden'); return; }
