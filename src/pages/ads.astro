<ShopLayout
  title="AI Ad Creative Gallery by Industry, Workflow Automation Ads by Purist"
  description="65 production-ready ad creatives generated entirely by the Purist automation stack. Browse by industry. n8n workflows, Claude AI Skills, GPT Image-2. Brief in. Campaign out."
  noindex={false}
>
  <div class="ads-page bg-brand-black min-h-screen">

    <!-- Hero -->
    <section class="pt-24 sm:pt-28 pb-12 sm:pb-16 px-4 sm:px-6 lg:px-16 max-w-7xl mx-auto">
      <div class="hero-line mb-10">
        <span class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full text-[10px] tracking-[0.2em] uppercase font-medium px-4 py-1.5 text-white/40">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-pink inline-block"></span>
          Creative Showcase · Purist.online
        </span>
      </div>

      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-12 mb-14">
        <div class="max-w-2xl">
          <h1 class="hero-title font-display text-[2.8rem] sm:text-5xl md:text-6xl lg:text-8xl text-white leading-[0.9] tracking-tight">
            Made by AI.<br />
            <em class="text-white/35 font-medium">For every industry.</em>
          </h1>
        </div>
        <div class="hero-desc lg:max-w-xs">
          <p class="text-[14px] text-white/45 leading-relaxed mb-6">
            Every visual was generated entirely by our automation stack.
            No agency. No retainer. No designer on payroll.
            Just a brief, an n8n workflow, and Claude AI Skills.
          </p>
          <div class="flex flex-wrap gap-2">
            {['n8n', 'Claude Skills', 'GPT Image-2', 'Under 4 min'].map(t => (
              <span class="text-[10px] tracking-widest uppercase text-white/30 border border-white/10 rounded-full px-3 py-1">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <!-- Stats bar -->
      <div class="hero-stats grid grid-cols-2 sm:grid-cols-4 gap-px border border-white/8 rounded-xl sm:rounded-2xl overflow-hidden">
        {[
          { n: `${ads.length}`, label: 'Creatives' },
          { n: '< 4 min', label: 'Per creative' },
          { n: '£0', label: 'Agency fees' },
          { n: '50+', label: 'Industries' },
        ].map(s => (
          <div class="bg-white/[0.03] px-4 sm:px-6 py-4 sm:py-6">
            <div class="text-2xl sm:text-3xl font-display text-white mb-1 tracking-tight">{s.n}</div>
            <div class="text-[9px] sm:text-[10px] text-white/25 uppercase tracking-[0.15em]">{s.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         AI AD STUDIO — model gallery + prompt library + generator
    ════════════════════════════════════════════════ -->
    <section class="px-4 sm:px-6 lg:px-16 max-w-7xl mx-auto mb-16">
      <div class="rounded-[24px] overflow-hidden" style="background:#0d0d0d;border:1px solid rgba(255,255,255,0.08);">

        <div class="px-6 sm:px-8 py-6 border-b flex items-center justify-between flex-wrap gap-3" style="border-color:rgba(255,255,255,0.07);">
          <div>
            <p class="text-[9.5px] uppercase tracking-[0.22em] font-bold mb-1.5" style="color:rgba(232,180,176,0.75);">AI Ad Studio · powered by KIE AI</p>
            <h2 class="font-display text-xl sm:text-2xl text-white">Pick a model. Pick a prompt. Generate.</h2>
          </div>
          <div class="flex gap-2">
            <span class="text-[10px] uppercase tracking-[0.14em] px-3 py-1.5 rounded-full" style="background:rgba(255,255,255,0.05);color:rgba(255,255,255,0.4);">16 models</span>
            <span class="text-[10px] uppercase tracking-[0.14em] px-3 py-1.5 rounded-full" style="background:rgba(255,255,255,0.05);color:rgba(255,255,255,0.4);">22 industries</span>
            <span class="text-[10px] uppercase tracking-[0.14em] px-3 py-1.5 rounded-full" style="background:rgba(255,255,255,0.05);color:rgba(255,255,255,0.4);">Image · v1</span>
          </div>
        </div>

        <!-- ① Model gallery -->
        <div class="p-6 sm:p-8" style="border-bottom:1px solid rgba(255,255,255,0.07);">
          <p class="text-[11px] uppercase tracking-widest font-semibold mb-3" style="color:rgba(255,255,255,0.35);">1 · Choose a model</p>

          <div class="flex flex-wrap gap-1.5 mb-2" id="model-provider-filter">
            <button class="model-filter-btn is-active" data-provider="all">All providers</button>
            {['Google','OpenAI','Qwen','ByteDance','Black Forest Labs','Grok'].map(p => (
              <button class="model-filter-btn" data-provider={p}>{p}</button>
            ))}
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-4" id="model-gallery"></div>
          <p class="text-[10.5px] mt-3" style="color:rgba(255,255,255,0.28);">16 of KIE AI's 31 text-to-image models, individually tested live against a real account. The rest need per-model parameters we're still mapping. <a href="https://kie.ai/market" target="_blank" rel="noopener" class="underline" style="color:rgba(255,255,255,0.4);">Browse all 100+ KIE AI models →</a></p>
        </div>

        <!-- ② Prompt library -->
        <div class="p-6 sm:p-8" style="border-bottom:1px solid rgba(255,255,255,0.07);">
          <p class="text-[11px] uppercase tracking-widest font-semibold mb-3" style="color:rgba(255,255,255,0.35);">2 · Start from a prompt, or write your own</p>

          <div class="flex flex-wrap gap-1.5 mb-3" id="prompt-category-filter">
            {['SaaS & Tech','E-commerce','Real Estate','Restaurant & Food','Health & Wellness','Finance','Local Services','Legal','Dental & Healthcare','Marketing Agencies','Construction & Trades','Automotive','Fitness & Wellness','Education & Coaching','Insurance','Hotels & Hospitality','HR & Recruitment','Property Management','Beauty & Salons','Med Spa & Aesthetics','IT Services & MSP','Home Improvement'].map((c, i) => (
              <button class={`prompt-cat-btn${i===0?' is-active':''}`} data-cat={c}>{c}</button>
            ))}
          </div>
          <div class="grid sm:grid-cols-2 gap-2.5" id="prompt-library"></div>

          <div class="mt-5">
            <label class="text-[11px] uppercase tracking-widest font-semibold block mb-2" style="color:rgba(255,255,255,0.35);">Your prompt</label>
            <textarea id="ag-prompt" rows="3" placeholder="Pick a prompt above, or write your own: describe the subject, style, palette, and where headline space should go…"
              class="w-full px-4 py-3 rounded-lg text-[13.5px] leading-relaxed outline-none resize-none" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);color:#fff;"></textarea>
          </div>
        </div>

        <!-- ③ Fine-tune + generate -->
        <div class="grid lg:grid-cols-[1fr_420px] gap-0">
          <div class="p-6 sm:p-8 space-y-5" style="border-right:1px solid rgba(255,255,255,0.07);">
            <p class="text-[11px] uppercase tracking-widest font-semibold" style="color:rgba(255,255,255,0.35);">3 · Fine-tune for a precise result</p>

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="text-[10.5px] uppercase tracking-widest font-semibold block mb-2" style="color:rgba(255,255,255,0.3);">Aspect ratio</label>
                <select id="ag-aspect" class="w-full px-4 py-2.5 rounded-lg text-[13px] outline-none" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);color:#fff;">
                  <option value="landscape">Landscape (ad banner, 16:9)</option>
                  <option value="square">Square (social post, 1:1)</option>
                  <option value="portrait">Portrait (story/reel, 9:16)</option>
                </select>
              </div>
              <div>
                <label class="text-[10.5px] uppercase tracking-widest font-semibold block mb-2" style="color:rgba(255,255,255,0.3);">Style precision</label>
                <select id="ag-precision" class="w-full px-4 py-2.5 rounded-lg text-[13px] outline-none" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);color:#fff;">
                  <option value="standard">Standard</option>
                  <option value="high">High detail (slower)</option>
                </select>
              </div>
            </div>

            <div>
              <label class="text-[10.5px] uppercase tracking-widest font-semibold block mb-2" style="color:rgba(255,255,255,0.3);">Negative prompt <span style="color:rgba(255,255,255,0.25);">(optional, what to avoid)</span></label>
              <input id="ag-negative" type="text" placeholder="e.g. text artifacts, watermark, blurry, extra limbs" class="w-full px-4 py-2.5 rounded-lg text-[12.5px] outline-none" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);color:#fff;"/>
            </div>

            <div class="field-divider" style="height:1px;background:rgba(255,255,255,0.07);"></div>

            <div>
              <p class="text-[11px] uppercase tracking-widest font-semibold mb-2.5" style="color:rgba(255,255,255,0.35);">API key</p>
              <div class="flex gap-2 mb-3">
                <button type="button" id="ag-key-own" class="ag-key-tab is-active">Use my own KIE AI key</button>
                <button type="button" id="ag-key-shared" class="ag-key-tab">Use PURIST's shared key</button>
              </div>
              <div id="ag-key-own-panel">
                <input id="ag-apikey" type="password" placeholder="Your KIE AI API key" class="w-full px-4 py-2.5 rounded-lg font-mono text-[12.5px] outline-none" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);color:#fff;"/>
