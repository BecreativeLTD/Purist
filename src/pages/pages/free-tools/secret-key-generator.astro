---
import ToolPageShell from '~/components/tools/ToolPageShell.astro';

const howItWorks = [
  { title: 'Cryptographically secure randomness', body: 'Uses the browser\'s crypto.getRandomValues(), the same secure random source used by password managers, not Math.random() which is predictable and unsuitable for secrets.' },
  { title: 'Real entropy math, not a green bar', body: 'Calculates actual entropy in bits from your chosen character set and length, then estimates realistic crack time against both an offline GPU attack and an online rate-limited attack, two very different threat models.' },
  { title: 'Format presets for real use cases', body: 'Generate a webhook signing secret, an API key, a UUID-style token, or a memorable passphrase, each using the character set and length appropriate for that specific use.' },
];

const faqs = [
  { q: 'Why does entropy matter more than just "looks random"?', a: 'Entropy in bits measures how many attempts a brute-force attack needs on average, mathematically, not just visually. A 12-character password using only lowercase letters has far less entropy than an 8-character one mixing upper, lower, digits and symbols, even though the first looks longer.' },
  { q: 'What is the difference between the offline and online crack time estimates?', a: 'An offline attack (attacker has the hashed secret and unlimited local compute) can try billions of guesses per second on modern hardware. An online attack (guessing against a live login form) is limited by rate limiting and network latency, typically to a handful of attempts per second. The gap between these two numbers is often enormous for the same secret.' },
  { q: 'Should I use a passphrase or a random string for a webhook secret?', a: 'For a machine-to-machine secret (webhook signing key, API key) that nothing ever needs to type or remember, always use the longest random string the receiving system allows. Passphrases exist specifically to be human-memorable, which is irrelevant for a secret only software will ever handle.' },
  { q: 'Is this tool storing or transmitting the secrets I generate?', a: 'No, generation happens entirely in your browser using the Web Crypto API. Nothing is transmitted, logged, or stored, closing this tab clears it completely.' },
  { q: 'How long should an API secret actually be?', a: 'For anything machine-to-machine, 32 characters (roughly 190 bits of entropy with a full alphanumeric-plus-symbol set) is a reasonable default that exceeds what any realistic attack could brute-force within the lifetime of the universe. Some systems impose their own length limits, always defer to the receiving system\'s documented requirement first.' },
];

const PRESETS = [
  { id: 'strong', label: 'Strong password', length: 20, charset: 'upper+lower+digits+symbols' },
  { id: 'apikey', label: 'API key / webhook secret', length: 40, charset: 'upper+lower+digits' },
  { id: 'hex', label: 'Hex token', length: 32, charset: 'hex' },
  { id: 'pin', label: 'Numeric PIN', length: 6, charset: 'digits' },
];
---

<ToolPageShell
  slug="secret-key-generator"
  name="Password & API Secret Generator"
  tagline="Generate cryptographically random secrets with real entropy math and realistic crack-time estimates, not just a green strength bar."
  category="Development"
  metaTitle="Secure Password & API Secret Generator, Free Tool | PURIST"
  metaDescription="Free cryptographically secure password and API secret generator with real entropy calculation and crack-time estimates for offline and online attacks."
  howItWorks={howItWorks}
  faqs={faqs}
>
  <div class="max-w-2xl mx-auto rounded-2xl border overflow-hidden" style="border-color:rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);">
    <div class="px-6 py-4 border-b" style="border-color:rgba(255,255,255,0.06);">
      <span class="text-[11px] uppercase tracking-widest font-semibold" style="color:rgba(232,180,176,0.7);">Configuration</span>
    </div>
    <div class="p-6 space-y-5">
      <div class="flex flex-wrap gap-2" id="sk-presets">
        {PRESETS.map(p => (
          <button type="button" class="sk-preset" data-id={p.id} data-length={p.length} data-charset={p.charset} style="font-size:11.5px;padding:7px 14px;border-radius:999px;border:1px solid rgba(255,255,255,0.12);background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.6);">{p.label}</button>
        ))}
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="text-[11px] uppercase tracking-widest font-semibold block mb-2" style="color:rgba(255,255,255,0.35);">Length: <span id="sk-length-val">20</span></label>
          <input id="sk-length" type="range" min="6" max="64" value="20" class="w-full"/>
        </div>
        <div class="flex flex-col justify-end gap-1.5 text-[12px]" style="color:rgba(255,255,255,0.6);">
          <label class="flex items-center gap-2"><input type="checkbox" id="sk-upper" checked/> Uppercase (A-Z)</label>
          <label class="flex items-center gap-2"><input type="checkbox" id="sk-lower" checked/> Lowercase (a-z)</label>
          <label class="flex items-center gap-2"><input type="checkbox" id="sk-digits" checked/> Digits (0-9)</label>
          <label class="flex items-center gap-2"><input type="checkbox" id="sk-symbols" checked/> Symbols (!@#$...)</label>
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label class="text-[11px] uppercase tracking-widest font-semibold" style="color:rgba(255,255,255,0.35);">Generated secret</label>
          <div class="flex gap-2">
            <button id="sk-regenerate" class="text-[11px] px-3 py-1 rounded-full border" style="border-color:rgba(255,255,255,0.15);color:rgba(255,255,255,0.5);">Regenerate</button>
            <button id="sk-copy" class="text-[11px] px-3 py-1 rounded-full border" style="border-color:rgba(255,255,255,0.15);color:rgba(255,255,255,0.5);">Copy</button>
          </div>
        </div>
        <input id="sk-output" type="text" readonly class="w-full px-4 py-3 rounded-lg font-mono text-[14px] outline-none" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);color:#E8B4B0;"/>
      </div>

      <div class="grid grid-cols-3 gap-3">
        <div style="background:rgba(255,255,255,0.04);border-radius:10px;padding:12px;text-align:center;">
          <p id="sk-entropy" class="font-display text-lg" style="color:#fff;"></p>
          <p style="font-size:9px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-top:2px;">bits of entropy</p>
        </div>
        <div style="background:rgba(255,255,255,0.04);border-radius:10px;padding:12px;text-align:center;">
          <p id="sk-offline" class="font-display text-[13px]" style="color:#4ADE80;"></p>
          <p style="font-size:9px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-top:2px;">offline crack time</p>
        </div>
        <div style="background:rgba(255,255,255,0.04);border-radius:10px;padding:12px;text-align:center;">
          <p id="sk-online" class="font-display text-[13px]" style="color:#4ADE80;"></p>
          <p style="font-size:9px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-top:2px;">online crack time</p>
        </div>
      </div>
    </div>
  </div>
</ToolPageShell>

<script is:inline>
(function() {
  var SETS = {
    upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', lower: 'abcdefghijklmnopqrstuvwxyz',
    digits: '0123456789', symbols: '!@#$%^&*()-_=+[]{}',
    hex: '0123456789abcdef',
  };

  function buildCharset() {
    var charset = '';
    if (document.getElementById('sk-upper').checked) charset += SETS.upper;
    if (document.getElementById('sk-lower').checked) charset += SETS.lower;
    if (document.getElementById('sk-digits').checked) charset += SETS.digits;
    if (document.getElementById('sk-symbols').checked) charset += SETS.symbols;
    return charset || SETS.lower;
  }

  function generate(length, charset) {
    var arr = new Uint32Array(length);
    crypto.getRandomValues(arr);
    var out = '';
    for (var i = 0; i < length; i++) out += charset[arr[i] % charset.length];
    return out;
  }

  function fmtDuration(seconds) {
    var units = [
      ['year', 31536000], ['day', 86400], ['hour', 3600], ['minute', 60], ['second', 1],
    ];
    if (seconds > 31536000 * 1e6) return 'longer than the age of the universe';
    if (seconds > 31536000 * 1000) return (seconds / 31536000).toExponential(1) + ' years';
    for (var i = 0; i < units.length; i++) {
      var val = seconds / units[i][1];
      if (val >= 1) return Math.round(val).toLocaleString() + ' ' + units[i][0] + (val >= 2 ? 's' : '');
    }
    return 'instantly';
  }

  var output = document.getElementById('sk-output');
  var lengthInput = document.getElementById('sk-length');
  var lengthVal = document.getElementById('sk-length-val');

  function render(regen) {
    var length = parseInt(lengthInput.value);
    lengthVal.textContent = length;
    var charset = buildCharset();
    if (regen !== false) output.value = generate(length, charset);

    var entropy = length * Math.log2(charset.length);
    document.getElementById('sk-entropy').textContent = Math.round(entropy);

    // offline: 10^12 guesses/sec (modern GPU cluster), online: 10 guesses/sec (rate-limited)
    var totalGuesses = Math.pow(2, entropy);
    var offlineSeconds = totalGuesses / 2 / 1e12;
    var onlineSeconds = totalGuesses / 2 / 10;
    document.getElementById('sk-offline').textContent = fmtDuration(offlineSeconds);
    document.getElementById('sk-online').textContent = fmtDuration(onlineSeconds);
  }

  document.querySelectorAll('#sk-upper, #sk-lower, #sk-digits, #sk-symbols').forEach(function(cb) {
    cb.addEventListener('change', function() { render(true); });
  });
  lengthInput.addEventListener('input', function() { render(true); });

  document.querySelectorAll('.sk-preset').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var charsetName = btn.getAttribute('data-charset');
      document.getElementById('sk-upper').checked = charsetName.indexOf('upper') !== -1;
      document.getElementById('sk-lower').checked = charsetName.indexOf('lower') !== -1 || charsetName === 'hex';
      document.getElementById('sk-digits').checked = charsetName.indexOf('digits') !== -1 || charsetName === 'hex';
      document.getElementById('sk-symbols').checked = charsetName.indexOf('symbols') !== -1;
      if (charsetName === 'hex') {
        // override with pure hex charset via direct generation
        var len = parseInt(btn.getAttribute('data-length'));
        lengthInput.value = len;
        output.value = generate(len, SETS.hex);
        lengthVal.textContent = len;
        var entropy = len * Math.log2(16);
        document.getElementById('sk-entropy').textContent = Math.round(entropy);
        var totalGuesses = Math.pow(2, entropy);
        document.getElementById('sk-offline').textContent = fmtDuration(totalGuesses/2/1e12);
        document.getElementById('sk-online').textContent = fmtDuration(totalGuesses/2/10);
        return;
      }
      lengthInput.value = btn.getAttribute('data-length');
      render(true);
    });
  });

  document.getElementById('sk-regenerate').addEventListener('click', function() { render(true); });
  document.getElementById('sk-copy').addEventListener('click', function() {
    navigator.clipboard.writeText(output.value);
    var btn = document.getElementById('sk-copy');
    var orig = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = orig; }, 1200);
  });

  render(true);
})();
</script>
