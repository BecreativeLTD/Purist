---
import ToolPageShell from '~/components/tools/ToolPageShell.astro';

const howItWorks = [
  { title: 'Structural validation first', body: 'Confirms your pasted JSON is valid, then checks it has the two required top-level keys any n8n workflow needs: nodes and connections.' },
  { title: 'Orphan and dangling-reference detection', body: 'Flags any node never referenced in connections (excluding triggers), and any connection pointing to a node name that no longer exists, the single most common cause of a broken import after a rename.' },
  { title: 'Best-practice checks, not just structural ones', body: 'Beyond "does it import," checks for missing error handling on external calls, generic unedited node names, hardcoded-looking secrets in parameters, and whether the workflow is documented with sticky notes.' },
  { title: 'A weighted health score', body: 'Every finding is weighted by real-world impact (a dangling connection costs more than a generic node name) and rolled into a single 0-100 score so you can judge workflow quality at a glance, not just read a list.' },
];

const faqs = [
  { q: 'Does this tool send my workflow anywhere?', a: 'No. Validation runs entirely in your browser with client-side JavaScript. Your workflow JSON, which may contain business logic or internal system names, never leaves your device.' },
  { q: 'Can this tool detect missing credentials?', a: 'It flags nodes of types that typically require credentials (HTTP Request, database nodes, most app-specific nodes) when no credential reference is present in the node, but it cannot verify the credential itself is valid or has the right permissions, since that requires connecting to n8n directly.' },
  { q: 'What does the health score actually measure?', a: 'It is a weighted composite: structural issues (broken imports) count most heavily, missing error handling and credential gaps count moderately, and cosmetic issues like generic node names or missing documentation count lightly. A 100 means no findings at all; scores below 60 usually mean the workflow needs real attention before production use.' },
  { q: 'Why does my workflow show an "orphaned node" that I know is connected?', a: 'This usually means the connection references the node by a name that does not match its current name, most often after a node was renamed in the n8n editor without the connections being remapped. Re-saving the workflow in n8n typically fixes this automatically.' },
  { q: 'Why does it flag a hardcoded secret when I did not put one in?', a: 'The heuristic looks for parameter values matching common secret patterns (long alphanumeric strings after words like "key," "token," or "secret," or bearer-token-shaped strings) directly in node parameters rather than as a credential reference. It can produce a false positive on a genuinely random-looking but non-secret value, review the flagged field to confirm.' },
  { q: 'Can I validate a workflow exported from Make or Zapier?', a: 'No, this tool is specific to n8n\'s JSON schema (nodes array with type/parameters/position, connections keyed by node name). Make and Zapier use entirely different internal formats that are not interchangeable.' },
];
---

<ToolPageShell
  slug="n8n-workflow-validator"
  name="n8n Workflow JSON Validator"
  tagline="Paste your exported n8n workflow JSON to get a full health score: structural issues, missing error handling, security hygiene, and documentation, not just import errors."
  category="n8n"
  metaTitle="n8n Workflow JSON Validator & Health Score, Free Tool | PURIST"
  metaDescription="Free n8n workflow validator with a weighted health score. Catches orphaned nodes, dangling connections, missing error handling, hardcoded secrets, and undocumented workflows."
  howItWorks={howItWorks}
  faqs={faqs}
>
  <div class="grid lg:grid-cols-2 gap-6">
    <div class="rounded-2xl border overflow-hidden" style="border-color:rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);">
      <div class="px-5 py-3.5 border-b flex items-center justify-between" style="border-color:rgba(255,255,255,0.06);">
        <span class="text-[11px] uppercase tracking-widest font-semibold" style="color:rgba(232,180,176,0.7);">Your workflow JSON</span>
        <button id="v-load-example" class="text-[11px] px-3 py-1 rounded-full border" style="border-color:rgba(255,255,255,0.15);color:rgba(255,255,255,0.5);">Load example</button>
      </div>
      <textarea id="v-input" rows="18" placeholder="Paste the full JSON exported from n8n here..."
        class="w-full bg-transparent resize-none px-5 py-4 font-mono text-[12px] leading-relaxed outline-none" style="color:rgba(255,255,255,0.75);min-height:420px;"></textarea>
      <div class="px-5 py-3 border-t flex justify-end" style="border-color:rgba(255,255,255,0.06);">
        <button id="v-validate" class="px-6 py-2.5 rounded-lg text-[13px] font-semibold" style="background:#E8B4B0;color:#0a0a0a;">Analyze workflow →</button>
      </div>
    </div>

    <div class="rounded-2xl border overflow-hidden" style="border-color:rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);">
      <div class="px-5 py-3.5 border-b" style="border-color:rgba(255,255,255,0.06);">
        <span class="text-[11px] uppercase tracking-widest font-semibold" style="color:rgba(232,180,176,0.7);">Analysis</span>
      </div>
      <div id="v-results" class="p-5">
        <p class="text-[13px]" style="color:rgba(255,255,255,0.35);">Paste a workflow and click Analyze to see the full report here.</p>
      </div>
    </div>
  </div>
</ToolPageShell>

<script is:inline>
(function() {
  var CREDENTIAL_TYPE_HINTS = ['httpRequest', 'postgres', 'mysql', 'mongoDb', 'slack', 'gmail', 'googleSheets', 'hubspot', 'salesforce', 'stripe', 'airtable', 'notion'];
  var GENERIC_NAME_RE = /^(HTTP Request|Set|IF|Switch|Code|Webhook|NoOp|Merge|Wait|Function)\d*$/i;
  var SECRET_KEY_RE = /(key|token|secret|password|bearer)/i;
  var SECRET_VALUE_RE = /^[A-Za-z0-9_\-]{20,}$/;

  function scanParamsForSecrets(obj, nodeName, findings, path) {
    if (!obj || typeof obj !== 'object') return;
    Object.keys(obj).forEach(function(key) {
      var val = obj[key];
      if (typeof val === 'string') {
        if (SECRET_KEY_RE.test(key) && SECRET_VALUE_RE.test(val) && val.indexOf('{{') === -1) {
          findings.push({ node: nodeName, field: (path ? path + '.' : '') + key, value: val.slice(0,6) + '…' });
        }
      } else if (typeof val === 'object') {
        scanParamsForSecrets(val, nodeName, findings, (path ? path + '.' : '') + key);
      }
    });
  }

  function analyze(json) {
    var critical = [];  // broken structure
    var warnings = [];  // functional risk
    var suggestions = []; // best practice / polish
    var positives = [];

    if (!Array.isArray(json.nodes)) { critical.push({ msg: 'Missing or invalid "nodes" array at the top level.' }); return finalize(critical, warnings, suggestions, positives, null); }
    if (typeof json.connections !== 'object' || json.connections === null) { critical.push({ msg: 'Missing or invalid "connections" object at the top level.' }); return finalize(critical, warnings, suggestions, positives, null); }

    var nodeNames = json.nodes.map(function(n) { return n.name; });
    var nodeNameSet = {};
    nodeNames.forEach(function(n) { nodeNameSet[n] = true; });

    var duplicates = nodeNames.filter(function(n, i) { return nodeNames.indexOf(n) !== i; });
    if (duplicates.length) critical.push({ msg: 'Duplicate node name(s): ' + Array.from(new Set(duplicates)).join(', ') + '. Node names must be unique.' });

    var referencedTargets = {};
    Object.keys(json.connections).forEach(function(sourceName) {
      if (!nodeNameSet[sourceName]) critical.push({ msg: 'Connection source "' + sourceName + '" does not match any node name in the workflow.' });
      var outputs = json.connections[sourceName].main || [];
      outputs.forEach(function(branch) {
        (branch || []).forEach(function(conn) {
          referencedTargets[conn.node] = true;
          if (!nodeNameSet[conn.node]) critical.push({ msg: 'Connection target "' + conn.node + '" (from "' + sourceName + '") does not match any node name in the workflow.' });
        });
      });
    });

    var triggerTypeHints = ['trigger', 'webhook', 'cron', 'schedule', 'manualTrigger'];
    var stickyCount = 0;
    var hasErrorTrigger = false;
    var externalCallNodes = [];
    var genericNamedNodes = [];
    var secretFindings = [];

    json.nodes.forEach(function(n) {
      var typeLower = (n.type || '').toLowerCase();
      var isTrigger = triggerTypeHints.some(function(h) { return typeLower.indexOf(h.toLowerCase()) !== -1; });
      var hasOutgoing = !!json.connections[n.name];
      var hasIncoming = !!referencedTargets[n.name];

      if (typeLower.indexOf('stickynote') !== -1) { stickyCount++; return; }
      if (typeLower.indexOf('errortrigger') !== -1) hasErrorTrigger = true;

      if (!isTrigger && !hasIncoming && !hasOutgoing) {
        warnings.push({ msg: 'Node "' + n.name + '" (' + n.type + ') has no incoming or outgoing connections, it will never execute.' });
      } else if (!isTrigger && !hasIncoming) {
        warnings.push({ msg: 'Node "' + n.name + '" has no incoming connection. If this is not meant to be a trigger, it will never run.' });
      }

      var looksLikeCredNode = CREDENTIAL_TYPE_HINTS.some(function(h) { return typeLower.indexOf(h.toLowerCase()) !== -1; });
      if (looksLikeCredNode) {
        externalCallNodes.push(n.name);
        if (!n.credentials) warnings.push({ msg: 'Node "' + n.name + '" (' + n.type + ') looks like it needs credentials, but none are attached in the exported JSON. Often normal for exports (credentials are excluded for security), but confirm it is connected before running.' });
        if (n.onError === undefined && n.continueOnFail === undefined) {
          suggestions.push({ msg: 'Node "' + n.name + '" makes an external call with no error handling configured (no "Continue On Fail" or error output). A transient failure here will halt the entire workflow.' });
        }
      }

      if (GENERIC_NAME_RE.test(n.name)) genericNamedNodes.push(n.name);
      scanParamsForSecrets(n.parameters, n.name, secretFindings, '');
    });

    if (genericNamedNodes.length >= 3) {
      suggestions.push({ msg: genericNamedNodes.length + ' nodes still use their default generic name (e.g. "' + genericNamedNodes[0] + '"). Renaming nodes to describe what they do makes the workflow far easier to maintain later.' });
    }
    if (stickyCount === 0 && json.nodes.length > 8) {
      suggestions.push({ msg: 'No Sticky Note documentation found on a ' + json.nodes.length + '-node workflow. Consider adding setup notes and credential requirements directly on the canvas for whoever maintains this next.' });
    } else if (stickyCount > 0) {
      positives.push(stickyCount + ' documentation sticky note(s) found.');
    }
    if (!hasErrorTrigger && externalCallNodes.length >= 2) {
      suggestions.push({ msg: 'No Error Trigger node found despite ' + externalCallNodes.length + ' nodes making external calls. Without one, a failure produces no alert, it just silently stops.' });
    }
    secretFindings.forEach(function(f) {
      critical.push({ msg: 'Possible hardcoded secret in node "' + f.node + '", field "' + f.field + '" (value starts "' + f.value + '"). Move this into an n8n credential instead of a plain parameter.' });
    });

    var typeCount = {};
    json.nodes.forEach(function(n) { typeCount[n.type] = (typeCount[n.type] || 0) + 1; });
    var connectionCount = Object.keys(json.connections).reduce(function(sum, k) {
      return sum + (json.connections[k].main || []).reduce(function(s, b) { return s + (b ? b.length : 0); }, 0);
    }, 0);
    if (json.nodes.length > 5 && connectionCount < json.nodes.length - 2) {
      warnings.push({ msg: 'Connection count (' + connectionCount + ') is low relative to node count (' + json.nodes.length + '). Can be normal for parallel branches, but worth double-checking for an incomplete export.' });
    }

    var stats = {
      nodeCount: json.nodes.length,
      typeCount: typeCount,
      connectionCount: connectionCount,
    };

    return finalize(critical, warnings, suggestions, positives, stats);
  }

  function finalize(critical, warnings, suggestions, positives, stats) {
    var score = 100 - critical.length*20 - warnings.length*8 - suggestions.length*4;
    score = Math.max(0, Math.min(100, score));
    return { critical: critical, warnings: warnings, suggestions: suggestions, positives: positives, stats: stats, score: score };
  }

  function scoreColor(score) {
    if (score >= 85) return '#4ADE80';
    if (score >= 60) return '#E8B4B0';
    return '#f87171';
  }
  function scoreLabel(score) {
    if (score >= 85) return 'Production-ready';
    if (score >= 60) return 'Usable, needs attention';
    return 'Needs real work before production';
  }

  function section(title, items, color) {
    if (!items.length) return '';
    return '<p style="color:' + color + ';font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:16px 0 8px;">' + title + ' (' + items.length + ')</p>'
      + '<div style="display:flex;flex-direction:column;gap:8px;">' + items.map(function(i) {
        return '<div style="background:rgba(255,255,255,0.04);border-left:3px solid ' + color + ';border-radius:6px;padding:10px 12px;font-size:12.5px;color:rgba(255,255,255,0.75);line-height:1.5;">' + i.msg + '</div>';
      }).join('') + '</div>';
  }

  function renderResults(r, err) {
    var el = document.getElementById('v-results');
    if (err) {
      el.innerHTML = '<div style="background:rgba(248,113,113,0.1);border:1px solid rgba(248,113,113,0.3);border-radius:10px;padding:14px;"><p style="color:#f87171;font-size:13px;">Invalid JSON: ' + err + '</p></div>';
      return;
    }

    var color = scoreColor(r.score);
    var html = '<div style="display:flex;align-items:center;gap:16px;padding-bottom:16px;border-bottom:1px solid rgba(255,255,255,0.08);margin-bottom:4px;">'
      + '<div style="width:72px;height:72px;border-radius:50%;border:4px solid ' + color + ';display:flex;align-items:center;justify-content:center;flex-shrink:0;">'
      + '<span style="font-family:\'Fraunces\',Georgia,serif;font-size:24px;color:' + color + ';">' + r.score + '</span></div>'
      + '<div><p style="font-size:14.5px;font-weight:600;color:#fff;">' + scoreLabel(r.score) + '</p>'
      + '<p style="font-size:11.5px;color:rgba(255,255,255,0.4);margin-top:2px;">' + r.critical.length + ' critical · ' + r.warnings.length + ' warning' + (r.warnings.length!==1?'s':'') + ' · ' + r.suggestions.length + ' suggestion' + (r.suggestions.length!==1?'s':'') + '</p></div>'
      + '</div>';

    if (r.stats) {
      var types = Object.keys(r.stats.typeCount).sort(function(a,b){return r.stats.typeCount[b]-r.stats.typeCount[a];});
      html += '<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:14px 0;">'
        + '<div style="background:rgba(255,255,255,0.04);border-radius:8px;padding:10px;text-align:center;"><p style="font-family:\'Fraunces\',Georgia,serif;font-size:20px;color:#fff;">' + r.stats.nodeCount + '</p><p style="font-size:9px;text-transform:uppercase;color:rgba(255,255,255,0.35);margin-top:2px;">nodes</p></div>'
        + '<div style="background:rgba(255,255,255,0.04);border-radius:8px;padding:10px;text-align:center;"><p style="font-family:\'Fraunces\',Georgia,serif;font-size:20px;color:#fff;">' + types.length + '</p><p style="font-size:9px;text-transform:uppercase;color:rgba(255,255,255,0.35);margin-top:2px;">node types</p></div>'
        + '<div style="background:rgba(255,255,255,0.04);border-radius:8px;padding:10px;text-align:center;"><p style="font-family:\'Fraunces\',Georgia,serif;font-size:20px;color:#fff;">' + r.stats.connectionCount + '</p><p style="font-size:9px;text-transform:uppercase;color:rgba(255,255,255,0.35);margin-top:2px;">connections</p></div>'
        + '</div>';
      html += '<div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:4px;">' + types.slice(0,8).map(function(t) {
        var shortName = t.replace('n8n-nodes-base.', '');
        return '<span style="font-size:10.5px;padding:3px 9px;border-radius:999px;background:rgba(255,255,255,0.05);color:rgba(255,255,255,0.5);">' + shortName + ' ×' + r.stats.typeCount[t] + '</span>';
      }).join('') + '</div>';
    }

    html += section('Critical', r.critical, '#f87171');
    html += section('Warnings', r.warnings, '#E8B4B0');
    html += section('Suggestions', r.suggestions, '#60a5fa');
    if (r.positives.length) {
      html += '<div style="margin-top:14px;padding:10px 12px;background:rgba(74,222,128,0.08);border:1px solid rgba(74,222,128,0.2);border-radius:8px;">' + r.positives.map(function(p) {
        return '<p style="font-size:12px;color:#4ADE80;">✓ ' + p + '</p>';
      }).join('') + '</div>';
    }
    if (r.critical.length === 0 && r.warnings.length === 0 && r.suggestions.length === 0) {
      html += '<div style="margin-top:14px;padding:12px;background:rgba(74,222,128,0.1);border:1px solid rgba(74,222,128,0.25);border-radius:10px;"><p style="color:#4ADE80;font-size:13px;font-weight:600;">No issues found at all. Clean workflow.</p></div>';
    }
    el.innerHTML = html;
  }

  document.getElementById('v-validate').addEventListener('click', function() {
    var raw = document.getElementById('v-input').value.trim();
    if (!raw) { renderResults(null, 'Paste a workflow JSON first.'); return; }
    try {
      var json = JSON.parse(raw);
      renderResults(analyze(json), null);
    } catch (e) {
      renderResults(null, e.message);
    }
  });

  document.getElementById('v-load-example').addEventListener('click', function() {
    var example = {
      nodes: [
        { id: '1', name: 'Webhook', type: 'n8n-nodes-base.webhook', typeVersion: 2, position: [0,0], parameters: {} },
        { id: '2', name: 'Set1', type: 'n8n-nodes-base.set', typeVersion: 3, position: [220,0], parameters: {} },
        { id: '3', name: 'HTTP Request', type: 'n8n-nodes-base.httpRequest', typeVersion: 4, position: [440,0], parameters: { url: 'https://api.example.com', headerParameters: { apiKey: 'REPLACE-WITH-EXAMPLE-NOT-A-REAL-TOKEN-000000' } } },
        { id: '4', name: 'Send to Slack', type: 'n8n-nodes-base.slack', typeVersion: 2, position: [660,0], parameters: {}, credentials: { slackApi: { id: '1', name: 'Slack' } } },
        { id: '5', name: 'Unused Node', type: 'n8n-nodes-base.noOp', typeVersion: 1, position: [220,200], parameters: {} }
      ],
      connections: {
        'Webhook': { main: [[{ node: 'Set1', type: 'main', index: 0 }]] },
        'Set1': { main: [[{ node: 'HTTP Request', type: 'main', index: 0 }]] },
        'HTTP Request': { main: [[{ node: 'Send To Slack', type: 'main', index: 0 }]] }
      }
    };
    document.getElementById('v-input').value = JSON.stringify(example, null, 2);
  });
})();
</script>
