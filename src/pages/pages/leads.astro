      <div class="pi-kpi"><div class="num">{avgScore}</div><div class="label">Avg. score</div></div>
      <div class="pi-kpi"><div class="num">{newThisWeek}</div><div class="label">New this week</div></div>
      <div class="pi-kpi"><div class="num">{hotLeads.length}</div><div class="label">Hot leads (50+)</div></div>
      <div class="pi-kpi"><div class="num">{auditRequests}</div><div class="label">Audit requests</div></div>
      <div class="pi-kpi"><div class="num" style="font-size:16px;">{topCategory}</div><div class="label">Top category</div></div>
    </div>

    {error && <p style="color:var(--danger);margin-top:20px;">Could not load leads: {error.message}</p>}

    {totalLeads === 0 ? (
      <div class="pi-empty">
        <h2>No leads recorded yet</h2>
        <p>Once someone downloads a guide, uses the ROI calculator, requests an audit, or downloads the State of Automation report, they will appear here automatically.</p>
      </div>
    ) : (
      <>
        <div class="pi-panels">
          <div class="pi-panel">
            <h3>Funnel by action</h3>
            {EVENT_ORDER.map((k) => (
              <div class="pi-bar-row">
                <span class="lbl">{EVENT_LABELS[k]}</span>
                <span class="track"><span class="fill" style={`width:${(funnelCounts[k] / maxFunnelCount) * 100}%`}></span></span>
                <span class="val">{funnelCounts[k]}</span>
              </div>
            ))}
          </div>
          <div class="pi-panel">
            <h3>Top sources</h3>
            {topSources.length === 0 ? <p class="pi-empty-panel">No event data yet.</p> : topSources.map(([src, c]) => (
              <div class="pi-bar-row">
                <span class="lbl">{src}</span>
                <span class="track"><span class="fill alt" style={`width:${(c / maxSourceCount) * 100}%`}></span></span>
                <span class="val">{c}</span>
              </div>
            ))}
          </div>
          <div class="pi-panel">
            <h3>Top profession pages</h3>
            {topProfessions.length === 0 ? <p class="pi-empty-panel">No profession data yet.</p> : topProfessions.map(([prof, c]) => (
              <div class="pi-bar-row">
                <span class="lbl">{prof}</span>
                <span class="track"><span class="fill" style={`width:${(c / maxProfessionCount) * 100}%`}></span></span>
                <span class="val">{c}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="pi-panel" style="margin-top:12px;">
          <h3>Score distribution</h3>
          <div style="display:flex;align-items:flex-end;gap:14px;height:80px;padding-top:10px;">
            {scoreDistribution.map((b) => (
              <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;height:100%;justify-content:flex-end;">
                <span style="font-size:11px;font-weight:600;color:var(--text-2);">{b.count}</span>
                <div style={`width:100%;max-width:56px;border-radius:6px 6px 2px 2px;background:${b.label === '75+' ? 'var(--danger)' : b.label === '50-74' ? 'var(--warning)' : 'var(--accent-2)'};height:${Math.max(4, (b.count / maxScoreBucket) * 46)}px;`}></div>
                <span style="font-size:10.5px;color:var(--text-3);">{b.label}</span>
              </div>
            ))}
          </div>
        </div>

        {!crmColumnsAvailable && (
          <div class="pi-notice">
            <strong>CRM fields not set up yet.</strong> Run <code>supabase-schema-v3-crm.sql</code> in the Supabase SQL editor to enable phone, tags, company size, last-contacted date, the activity timeline, and duplicate detection.
          </div>
        )}

        <div class="pi-controls">
          <input id="pi-search" type="text" placeholder="Search email, name, or company..." />
          <select id="pi-filter-cat">
            <option value="">All categories</option>
            {categories.map((c) => <option value={c as string}>{c}</option>)}
          </select>
          <select id="pi-filter-status">
            <option value="">All statuses</option>
