              <option value="">All tags</option>
              {allTags.map((t) => <option value={t as string}>{t}</option>)}
            </select>
          )}
          <label class="chk"><input type="checkbox" id="pi-filter-hot" /> Hot leads only</label>
          <button class="pi-export" id="pi-export">Export CSV ↓</button>
          {crmColumnsAvailable && <button class="pi-export" id="pi-toggle-new-contact">+ New contact</button>}
          {crmColumnsAvailable && <button class="pi-export" id="pi-toggle-import">Import CSV</button>}
          {crmColumnsAvailable && <button class="pi-export" id="pi-toggle-duplicates">Find duplicates</button>}
        </div>

        {crmColumnsAvailable && (
          <div class="pi-compose" id="new-contact-panel" style="display:none;">
            <h3>New contact</h3>
            <div class="pi-compose-grid" style="grid-template-columns:1fr 1fr;">
              <input id="nc-email" type="email" placeholder="Email *" />
              <input id="nc-name" type="text" placeholder="Name" />
              <input id="nc-phone" type="text" placeholder="Phone" />
              <input id="nc-company" type="text" placeholder="Company" />
              <input id="nc-company-size" type="text" placeholder="Company size (e.g. 1-10, 50-200)" />
              <input id="nc-tags" type="text" placeholder="Tags, comma-separated" />
            </div>
            <button class="pi-btn-primary" id="nc-submit" style="margin-top:10px;">Save contact</button>
            <div class="pi-feedback" id="nc-feedback"></div>
          </div>
        )}

        {crmColumnsAvailable && (
          <div class="pi-compose" id="import-panel" style="display:none;">
            <h3>Import contacts from CSV</h3>
            <p style="font-size:12px;color:var(--text-2);margin:0 0 10px;">Header row required: <code>email,name,phone,company,tags</code> (tags separated by <code>;</code>). Paste the CSV content below.</p>
            <textarea id="import-csv" placeholder="email,name,phone,company,tags&#10;jane@acme.com,Jane Doe,+15551234567,Acme Inc,vip;webinar" style="min-height:140px;"></textarea>
            <button class="pi-btn-primary" id="import-submit" style="margin-top:10px;">Import</button>
            <div class="pi-feedback" id="import-feedback"></div>
          </div>
        )}

        {crmColumnsAvailable && (
          <div class="pi-panel" id="duplicates-panel" style="display:none;margin-bottom:16px;">
            <h3>Possible duplicate contacts (matching phone number)</h3>
            <div id="duplicates-list"><p class="pi-empty-panel">Loading…</p></div>
          </div>
        )}

        <div class="pi-table-scroll">
          <table class="pi-table" id="pi-table">
            <thead>
              <tr>
                <th></th>
                <th data-sort="email">Email</th>
                <th data-sort="company">Company</th>
                {crmColumnsAvailable && <th>Phone</th>}
                {crmColumnsAvailable && <th>Tags</th>}
                <th data-sort="category">Category</th>
                <th data-sort="score">Score</th>
                <th data-sort="touch_count">Touches</th>
                <th data-sort="status">Status</th>
                <th data-sort="last_seen_at">Last seen</th>
              </tr>
            </thead>
            <tbody>
              {leads.map((l) => {
                const leadEvents = eventsByLead[l.id] ?? [];
                const leadSeqs = sequencesByLead[l.id] ?? [];
                const leadActivities = activitiesByLead[l.id] ?? [];
                const isHot = (l.score ?? 0) >= 50;
                // Merge every source into one reverse-chronological timeline.
                const timeline = [
                  ...leadEvents.map((e) => ({ kind: 'event' as const, at: e.created_at, e })),
                  ...leadActivities.map((a) => ({ kind: 'activity' as const, at: a.created_at, a })),
                ].sort((x, y) => new Date(y.at).getTime() - new Date(x.at).getTime());
                const colCount = crmColumnsAvailable ? 10 : 8;
                return (
                  <>
                    <tr class="pi-row" data-lead-id={l.id} data-email={l.email.toLowerCase()} data-name={(l.name || '').toLowerCase()} data-company={(l.company || '').toLowerCase()} data-category={l.category || ''} data-status={l.status} data-score={l.score} data-touches={l.touch_count} data-last-seen={l.last_seen_at} data-hot={isHot ? '1' : '0'} data-tags={(l.tags || []).join(',')}>
                      <td style="width:20px;"><span class="pi-caret">▶</span></td>
                      <td>{isHot && <span class="pi-hot" title="Hot lead (score 50+)"></span>}{l.email}</td>
                      <td>{l.company || '-'}</td>
                      {crmColumnsAvailable && <td>{l.phone || '-'}</td>}
                      {crmColumnsAvailable && <td>{(l.tags || []).length ? (l.tags || []).map((t: string) => <span class="pi-status active" style="margin-right:4px;">{t}</span>) : '-'}</td>}
                      <td>{l.category || '-'}</td>
                      <td class="pi-score">{l.score}</td>
                      <td>{l.touch_count}</td>
                      <td><span class={`pi-status ${l.status}`}>{l.status}</span></td>
                      <td>{fmtDate(l.last_seen_at)}</td>
                    </tr>
                    <tr class="pi-detail" data-detail-for={l.id}>
                      <td colspan={colCount} class="pi-detail-cell">
                        <div class="pi-detail-inner">
                          <div class="pi-detail-grid">
                            <div>
                              <p class="pi-detail-h">Timeline ({timeline.length})</p>
                              {timeline.length === 0 ? <p class="pi-empty-panel">No activity recorded.</p> : (
                                <ul class="pi-timeline">
                                  {timeline.map((t) => t.kind === 'event' ? (
                                    <li>
                                      <span class="ev-type">{EVENT_LABELS[t.e.event_type] ?? t.e.event_type}</span>
                                      <span class="ev-meta">{t.e.page || t.e.source || '—'} · {fmtDateTime(t.e.created_at)}</span>
                                      <span class="ev-pts">+{t.e.points}</span>
                                    </li>
                                  ) : (
                                    <li>
                                      <span class="ev-type" style="text-transform:capitalize;">{t.a.type}{t.a.subject ? `: ${t.a.subject}` : ''}</span>
                                      <span class="ev-meta">{t.a.body || '—'} · {fmtDateTime(t.a.created_at)}</span>
                                      <span class="ev-pts"></span>
                                    </li>
                                  ))}
                                </ul>
                              )}
                              {crmColumnsAvailable && (
                                <div style="margin-top:12px;display:flex;gap:6px;flex-wrap:wrap;">
                                  <select class="activity-type" style="font-size:11.5px;padding:6px 8px;border-radius:6px;border:1px solid var(--border);">
                                    <option value="call">Call</option>
                                    <option value="meeting">Meeting</option>
                                    <option value="note">Note</option>
                                  </select>
                                  <input class="activity-text" type="text" placeholder="What happened..." style="flex:1;min-width:140px;font-size:11.5px;padding:6px 8px;border-radius:6px;border:1px solid var(--border);" />
                                  <button class="pi-btn-small activity-add" data-lead-for-activity={l.id}>Log</button>
                                </div>
                              )}
                            </div>
                            <div>
                              <p class="pi-detail-h">Nurture sequence</p>
                              {leadSeqs.length === 0 ? <p class="pi-empty-panel">Not scheduled.</p> : (
                                <ul class="pi-seq">
                                  {leadSeqs.map((s) => (
                                    <li>
                                      <span>{SEQUENCE_LABELS[s.step] ?? `Step ${s.step}`}</span>
                                      <span class={`pi-seq-badge ${s.status}`}>{s.status}</span>
                                    </li>
                                  ))}
                                </ul>
                              )}
                              {crmColumnsAvailable && l.last_contacted_at && (
                                <p style="font-size:11px;color:var(--text-3);margin-top:10px;">Last contacted: {fmtDate(l.last_contacted_at)}</p>
                              )}
                              <button class="pi-btn-small" style="margin-top:10px;" data-goto-email={l.id}>Compose email →</button>
                            </div>
                          </div>
                        </div>
                      </td>
                    </tr>
                  </>
                );
              })}
            </tbody>
          </table>
        </div>
        <p id="pi-count" style="font-size:12px;color:var(--text-3);margin-top:10px;">{totalLeads} leads</p>
      </>
    )}
  </section>

  <!-- ══════════════════ PIPELINE ══════════════════ -->
  <section class="pi-panel-view" data-panel="pipeline">
    {!dealsAvailable ? (
      <div class="pi-notice">
        <strong>Pipeline not set up yet.</strong> Run <code>supabase-schema-v4-pipeline.sql</code> in the Supabase SQL editor to enable deals, stages, and forecasting.
      </div>
    ) : (
      <>
        <div class="pi-ring-row">
          <div class="pi-panel pi-ring-card">
            <div class="pi-ring-wrap">
              <canvas id="pipeline-win-ring" data-won={wonCount} data-lost={lostCount}></canvas>
              <div class="pi-ring-center">
                <span class="pi-ring-num">{winRate}%</span>
                <span class="pi-ring-label">Win rate</span>
              </div>
            </div>
            <div class="pi-ring-side">
              <p class="pi-ring-side-h">Closed deals</p>
              <p class="pi-ring-side-stat"><span class="dot won"></span>{wonCount} won</p>
              <p class="pi-ring-side-stat"><span class="dot lost"></span>{lostCount} lost</p>
              <p class="pi-ring-side-stat">{fmtMoney(avgDealSize)} avg. deal size</p>
            </div>
          </div>
          <div class="pi-kpis" style="flex:1;">
            <div class="pi-kpi"><div class="num">{fmtMoney(openPipelineValue)}</div><div class="label">Open pipeline value</div></div>
            <div class="pi-kpi"><div class="num">{fmtMoney(weightedForecast)}</div><div class="label">Weighted forecast</div></div>
            <div class="pi-kpi"><div class="num">{fmtMoney(mrr)}</div><div class="label">MRR (recurring, closed won)</div></div>
            <div class="pi-kpi"><div class="num">{openDeals.length}</div><div class="label">Open deals</div></div>
            <div class="pi-kpi"><div class="num">{dealsWonThisMonth.length}</div><div class="label">Won this month</div></div>
          </div>
        </div>

        <div class="pi-controls" style="margin-top:16px;">
          <button class="pi-export" id="pi-toggle-new-deal">+ New deal</button>
        </div>

        <div class="pi-compose" id="new-deal-panel" style="display:none;">
          <h3>New deal</h3>
          <div class="pi-compose-grid" style="grid-template-columns:1fr 1fr;">
            <select id="nd-lead">
              <option value="">Select a lead...</option>
              {leads.map((l) => <option value={l.id}>{l.email}{l.company ? ` — ${l.company}` : ''}</option>)}
            </select>
            <input id="nd-title" type="text" placeholder="Deal title (e.g. Automation setup — Acme Inc)" />
            <input id="nd-value" type="number" min="0" step="1" placeholder="Value (EUR)" />
            <select id="nd-stage">
              {STAGE_ORDER.filter((s) => s !== 'closed_won' && s !== 'closed_lost').map((s) => <option value={s}>{STAGE_LABELS[s]}</option>)}
            </select>
            <input id="nd-close-date" type="date" placeholder="Expected close date" />
            <label class="chk"><input type="checkbox" id="nd-recurring" /> Recurring revenue</label>
          </div>
          <button class="pi-btn-primary" id="nd-submit" style="margin-top:10px;">Create deal</button>
          <div class="pi-feedback" id="nd-feedback"></div>
        </div>

        <div class="pi-pipeline-board">
          {STAGE_ORDER.map((stage) => (
            <div class="pi-pipeline-col">
              <div class="pi-pipeline-col-head">
                <span>{STAGE_LABELS[stage]}</span>
                <span class="pi-pipeline-count">{dealsByStage[stage].length}</span>
              </div>
              <div class="pi-pipeline-col-total">{fmtMoney(dealsByStage[stage].reduce((s, d) => s + Number(d.value || 0), 0))}</div>
              <div class="pi-pipeline-cards">
                {dealsByStage[stage].length === 0 ? <p class="pi-empty-panel" style="font-size:11px;">No deals.</p> : dealsByStage[stage].map((d) => {
                  const lead = leadsById[d.lead_id];
                  return (
                    <div class="pi-deal-card" data-deal-id={d.id}>
                      <p class="pi-deal-title">{d.title}</p>
                      <p class="pi-deal-lead">{lead?.email ?? '—'}</p>
                      <p class="pi-deal-value">{fmtMoney(Number(d.value || 0))}{d.recurring && <span class="pi-status active" style="margin-left:6px;">MRR</span>}</p>
                      {d.expected_close_date && <p class="pi-deal-date">Close: {fmtDate(d.expected_close_date)}</p>}
                      <select class="pi-deal-stage-select" data-deal-for-stage={d.id}>
                        {STAGE_ORDER.map((s) => <option value={s} selected={s === stage}>{STAGE_LABELS[s]}</option>)}
                      </select>
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </>
    )}
  </section>

  <!-- ══════════════════ EMAILS ══════════════════ -->
  <section class="pi-panel-view" data-panel="emails">
    <div class="pi-kpis" style="grid-template-columns:repeat(3,1fr);">
      <div class="pi-kpi"><div class="num" style="color:var(--success);">{emailsSent}</div><div class="label">Sent</div></div>
      <div class="pi-kpi"><div class="num">{emailsPending}</div><div class="label">Pending</div></div>
      <div class="pi-kpi"><div class="num" style="color:var(--danger);">{emailsFailed}</div><div class="label">Failed</div></div>
    </div>

    <div class="pi-compose">
      <h3>Send an email to a lead</h3>
      <div class="pi-compose-grid">
        <select id="email-lead-select">
          <option value="">Select a lead...</option>
          {leads.map((l) => <option value={l.id}>{l.email}{l.company ? ` — ${l.company}` : ''} (score {l.score})</option>)}
        </select>
        <input id="email-subject" type="text" placeholder="Subject" />
        <textarea id="email-message" placeholder="Message..."></textarea>
        <button class="pi-btn-primary" id="email-send-btn">Send email</button>
        <div class="pi-feedback" id="email-feedback"></div>
      </div>
    </div>

    <h2 class="pi-section-h">Nurture sequence status</h2>
    <div class="pi-table-scroll" style="margin-top:12px;">
      <table class="pi-table">
        <thead><tr><th>Lead</th><th>Step</th><th>Status</th><th>Scheduled</th><th>Sent</th><th></th></tr></thead>
        <tbody id="sequences-tbody">
          {sequences.map((s) => {
            const lead = leadsById[s.lead_id];
            return (
              <tr>
                <td>{lead?.email ?? '—'}</td>
                <td>{SEQUENCE_LABELS[s.step] ?? `Step ${s.step}`}</td>
                <td><span class={`pi-seq-badge ${s.status}`}>{s.status}</span></td>
                <td>{s.scheduled_at ? fmtDate(s.scheduled_at) : '—'}</td>
                <td>{s.sent_at ? fmtDate(s.sent_at) : '—'}</td>
                <td>
                  {(s.status === 'pending' || s.status === 'failed') && s.step !== 0 ? (
                    <button class="pi-btn-small" data-resend-seq={s.id}>Send now</button>
                  ) : null}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>
  </div>
</div>

<script>
  // A `define:vars` script below is inlined as plain (non-module) JS, so it
  // cannot use `import` itself, that throws a SyntaxError and silently kills
  // the whole inline script. This separate script tag has no define:vars,
  // so Astro bundles it as a real module: it loads Chart.js and hands it to
  // the inline script via a global + event, order-independent either way.
  import Chart from 'chart.js/auto';
  window.Chart = Chart;
  window.dispatchEvent(new Event('chartjs-ready'));
</script>

<script define:vars={{ clientData }}>
 function __piBoot() {
  // ── Human-readable date labels. GA4 returns raw "YYYYMMDD" (date
  // dimension) or "YYYYWW" (yearWeek dimension); GSC returns "YYYY-MM-DD".
  // Hour-of-day labels ("00:00") are already human-readable and pass through.
  const MONTH_ABBR = ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'];
  function formatChartLabel(label) {
    if (typeof label !== 'string') return String(label);
    if (/^\d{8}$/.test(label)) {
      const y = label.slice(0, 4), m = Number(label.slice(4, 6)), d = Number(label.slice(6, 8));
      return `${d} ${MONTH_ABBR[m - 1]}`;
    }
    if (/^\d{4}-\d{2}-\d{2}$/.test(label)) {
      const [y, m, d] = label.split('-').map(Number);
      return `${d} ${MONTH_ABBR[m - 1]}`;
    }
    if (/^\d{6}$/.test(label)) {
      const y = label.slice(0, 4), w = Number(label.slice(4, 6));
      return `Sem. ${w}`;
    }
    return label;
  }

  // ── Realtime active users (GA4 Realtime API), polled every 20s ──
  async function pollRealtime() {
    const countEl = document.getElementById('pi-live-count');
    if (!countEl) return;
    try {
      const res = await fetch('/api/admin/realtime');
      const data = await res.json();
      countEl.textContent = data.available ? String(data.activeUsers) : '—';
    } catch {
      countEl.textContent = '—';
    }
  }
  pollRealtime();
  setInterval(pollRealtime, 20000);

  // ── Tab switching ──
  const tabs = document.querySelectorAll('.pi-tab');
  const panels = document.querySelectorAll('.pi-panel-view');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.classList.remove('active'));
      panels.forEach((p) => p.classList.remove('active'));
      tab.classList.add('active');
      document.querySelector(`.pi-panel-view[data-panel="${tab.dataset.tab}"]`)?.classList.add('active');
    });
  });

  // ── "Compose email" shortcut from a lead's detail row ──
  document.querySelectorAll('[data-goto-email]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const leadId = btn.getAttribute('data-goto-email');
      tabs.forEach((t) => t.classList.remove('active'));
      panels.forEach((p) => p.classList.remove('active'));
      document.querySelector('.pi-tab[data-tab="emails"]')?.classList.add('active');
      document.querySelector('.pi-panel-view[data-panel="emails"]')?.classList.add('active');
      const select = document.getElementById('email-lead-select');
      if (select) select.value = leadId;
      window.scrollTo({ top: document.querySelector('.pi-compose')?.getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' });
    });
  });

  // ── Real charting via Chart.js (chart.js/auto self-registers every
  // controller/scale/plugin it needs). Replaces the earlier hand-rolled SVG
  // renderer: native tooltips, correct scaling at any size, no more
  // preserveAspectRatio distortion class of bug. ──
  const chartInstances = new Map();

  function destroyChart(canvasId) {
    const existing = chartInstances.get(canvasId);
    if (existing) { existing.destroy(); chartInstances.delete(canvasId); }
  }

  // Main dashboard line chart: gradient fill, native hover tooltip, peak
  // annotated via a distinct point radius (Chart.js has no simple "biggest
  // point" primitive, so the peak index just gets a bigger/white-ringed dot).
  function renderBars(canvasId, labelsId, points, formatLabel) {
    const canvas = document.getElementById(canvasId);
    if (!canvas || !points.length) return;
    destroyChart(canvasId);
    const tipLabel = formatLabel || ((l) => l);
    const peakIdx = points.reduce((best, p, i) => (p.value > points[best].value ? i : best), 0);
    const ctx = canvas.getContext('2d');
    const gradient = ctx.createLinearGradient(0, 0, 0, canvas.clientHeight || 130);
    gradient.addColorStop(0, 'rgba(108,92,231,0.20)');
    gradient.addColorStop(1, 'rgba(30,79,214,0)');

    const chart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: points.map((p) => tipLabel(p.label)),
        datasets: [{
          data: points.map((p) => p.value),
          borderColor: '#6C5CE7',
          backgroundColor: gradient,
          borderWidth: 2.5,
          fill: true,
          tension: 0.35,
          pointRadius: points.map((_, i) => (i === peakIdx ? 5 : 0)),
          pointBackgroundColor: '#fff',
          pointBorderColor: '#6C5CE7',
          pointBorderWidth: 2.5,
          pointHoverRadius: 5,
          pointHoverBackgroundColor: '#fff',
          pointHoverBorderColor: '#6C5CE7',
          pointHoverBorderWidth: 2.5,
        }],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 650, easing: 'easeOutQuart' },
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#0A0A0A',
            padding: 10,
            cornerRadius: 8,
            titleFont: { family: "'Inter', sans-serif", size: 11.5 },
            bodyFont: { family: "'Fira Code', monospace", size: 13, weight: '600' },
            displayColors: false,
            callbacks: { label: (item) => item.parsed.y.toLocaleString() },
          },
        },
        scales: {
          x: { grid: { display: false }, ticks: { color: '#A3A29A', font: { family: "'Inter', sans-serif", size: 10.5 }, maxRotation: 0, autoSkip: true, maxTicksLimit: 8 } },
          y: { beginAtZero: true, grid: { color: 'rgba(108,92,231,0.08)' }, ticks: { color: '#A3A29A', font: { family: "'Fira Code', monospace", size: 10 }, maxTicksLimit: 4 } },
        },
      },
    });
    chartInstances.set(canvasId, chart);

    // The old separate three-label strip under the SVG is now redundant,
    // Chart.js draws its own x-axis ticks.
    if (labelsId) { const el = document.getElementById(labelsId); if (el) el.innerHTML = ''; }
  }

  // Hero card sparkline: no axes, no tooltip chrome, just the trend + a
  // stats strip computed alongside it (avg/peak/total).
  function renderHero(canvasId, statsId, points, unitLabel, color) {
    const canvas = document.getElementById(canvasId);
    if (!canvas || !points.length) return;
    destroyChart(canvasId);
    const lineColor = color || '#6C5CE7';
    const peakIdx = points.reduce((best, p, i) => (p.value > points[best].value ? i : best), 0);
    const ctx = canvas.getContext('2d');
    const gradient = ctx.createLinearGradient(0, 0, 0, canvas.clientHeight || 68);
    gradient.addColorStop(0, lineColor + '26');
    gradient.addColorStop(1, lineColor + '00');

    const chart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: points.map((p) => formatChartLabel(p.label)),
        datasets: [{
          data: points.map((p) => p.value),
          borderColor: lineColor,
          backgroundColor: gradient,
          borderWidth: 2,
          fill: true,
          tension: 0.35,
          pointRadius: points.map((_, i) => (i === peakIdx ? 3.5 : 0)),
          pointBackgroundColor: '#fff',
          pointBorderColor: lineColor,
          pointBorderWidth: 2,
          pointHoverRadius: 4,
          pointHoverBackgroundColor: '#fff',
          pointHoverBorderColor: lineColor,
        }],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 500 },
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: 'rgba(10,10,10,0.9)',
            padding: 8,
            cornerRadius: 6,
            bodyFont: { family: "'Fira Code', monospace", size: 12 },
            displayColors: false,
          },
        },
        scales: { x: { display: false }, y: { display: false } },
      },
    });
    chartInstances.set(canvasId, chart);

    const statsEl = document.getElementById(statsId);
    if (statsEl) {
      const total = points.reduce((s, p) => s + p.value, 0);
      const avg = points.length ? Math.round(total / points.length) : 0;
      const peak = points[peakIdx]?.value ?? 0;
      statsEl.innerHTML = `<span>Avg/day<b>${avg}</b></span><span>Peak day<b>${peak}</b></span><span>Total ${unitLabel}<b>${total}</b></span>`;
    }
  }

  let trafficDailyPoints = (clientData.trafficDaily || []).map((d) => ({ label: d.date, value: d.sessions }));
  let searchDailyPoints = (clientData.searchDaily || []).map((d) => ({ label: d.date, value: d.clicks }));
  let trafficChartPoints = trafficDailyPoints;
  let searchChartPoints = searchDailyPoints;
  renderHero('hero-sessions', 'hero-sessions-stats', trafficDailyPoints, 'sessions', '#6C5CE7');
  renderHero('hero-clicks', 'hero-clicks-stats', searchDailyPoints, 'clicks', '#22B07D');
  renderBars('traffic-chart', 'traffic-chart-labels', trafficChartPoints, formatChartLabel);
  renderBars('search-chart', 'search-chart-labels', searchChartPoints, formatChartLabel);
  // No manual resize handling needed, Chart.js's `responsive: true` already
  // observes its canvas's container size and redraws itself correctly.

  // ── Date range switching: re-fetches overview + charts, no page reload ──
  function renderBarRowsInto(containerId, items, labelKey, valueKey, altClass) {
    const el = document.getElementById(containerId);
    if (!el) return;
    if (!items || items.length === 0) {
      el.innerHTML = '<p class="pi-empty-panel">No data for this range.</p>';
      return;
    }
    const max = Math.max(1, ...items.map((i) => i[valueKey]));
    el.innerHTML = items.map((i) => `
      <div class="pi-bar-row">
        <span class="lbl" title="${String(i[labelKey]).replace(/"/g, '')}">${i[labelKey]}</span>
        <span class="track"><span class="fill${altClass ? ' alt' : ''}" style="width:${(i[valueKey] / max) * 100}%"></span></span>
        <span class="val">${i[valueKey]}</span>
      </div>`).join('');
  }

  function renderTableInto(tbodyId, items, cols) {
    const el = document.getElementById(tbodyId);
    if (!el) return;
    el.innerHTML = items.map((row) => `<tr>${cols.map((c) => `<td${c.title ? ` title="${row[c.key]}"` : ''}>${c.fmt ? c.fmt(row[c.key]) : row[c.key]}</td>`).join('')}</tr>`).join('');
  }

  function deltaHtml(current, previous, invert) {
    if (previous === 0) return '';
    let pct = ((current - previous) / previous) * 100;
    if (invert) pct = -pct;
    const dir = pct > 0.5 ? 'up' : pct < -0.5 ? 'down' : 'flat';
    const arrow = dir === 'up' ? '↑' : dir === 'down' ? '↓' : '–';
    return `<span class="pi-delta ${dir}">${arrow} ${pct > 0 ? '+' : ''}${pct.toFixed(0)}%</span>`;
  }

  const rangeGroup = document.getElementById('pi-range');
  const rangeStatus = document.getElementById('pi-range-status');
  rangeGroup?.querySelectorAll('button[data-days]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const days = btn.dataset.days;
      rangeGroup.querySelectorAll('button[data-days]').forEach((b) => { b.classList.remove('active'); b.disabled = true; });
      btn.classList.add('active');
      rangeStatus.textContent = 'Loading…';
      try {
        const [res, bingRes] = await Promise.all([
          fetch(`/api/admin/overview?days=${days}`),
          fetch(`/api/admin/bing?days=${days}`),
        ]);
        const data = await res.json();
        const { traffic, search } = data;
        const { bing } = await bingRes.json();
        const rangeText = days == 7 ? '7d' : days == 30 ? '30d' : days == 90 ? '90d' : days == 365 ? '12mo' : '16mo';
        document.querySelectorAll('.range-label').forEach((el) => (el.textContent = rangeText));

        document.getElementById('kpi-sessions').textContent = traffic.available ? traffic.sessions.toLocaleString() : '—';
        document.getElementById('kpi-users').textContent = traffic.available ? traffic.users.toLocaleString() : '—';
        document.getElementById('kpi-clicks').textContent = search.available ? search.clicks.toLocaleString() : '—';
        document.getElementById('kpi-position').textContent = search.available ? search.avgPosition.toFixed(1) : '—';
        document.getElementById('kpi-sessions-delta').innerHTML = traffic.available ? deltaHtml(traffic.sessions, traffic.prevSessions, false) : '';
        document.getElementById('kpi-users-delta').innerHTML = traffic.available ? deltaHtml(traffic.users, traffic.prevUsers, false) : '';
        document.getElementById('kpi-clicks-delta').innerHTML = search.available ? deltaHtml(search.clicks, search.prevClicks, false) : '';
        document.getElementById('kpi-position-delta').innerHTML = search.available ? deltaHtml(search.avgPosition, search.prevAvgPosition, true) : '';
        const bounceEl = document.getElementById('kpi-bounce'); if (bounceEl) bounceEl.textContent = traffic.available ? `${(traffic.bounceRate * 100).toFixed(0)}%` : '—';
        const engEl = document.getElementById('kpi-engagement'); if (engEl) engEl.textContent = traffic.available ? fmtDuration(traffic.avgEngagementSec) : '—';
        const newRetEl = document.getElementById('kpi-new-returning');
        if (newRetEl) {
          const rawNewPct = traffic.available && traffic.users > 0 ? Math.round((traffic.newUsers / traffic.users) * 100) : 0;
          const newPct = Math.max(0, Math.min(100, rawNewPct));
          newRetEl.textContent = traffic.available ? `${newPct}% / ${100 - newPct}%` : '—';
        }
        const brandEl = document.getElementById('kpi-brand');
        if (brandEl) {
          const bt = search.brandClicks + search.nonBrandClicks;
          brandEl.textContent = search.available && bt > 0 ? `${Math.round((search.brandClicks / bt) * 100)}%` : '—';
        }
        const ppsEl = document.getElementById('kpi-pages-session'); if (ppsEl) ppsEl.textContent = traffic.available ? traffic.pagesPerSession.toFixed(1) : '—';
        const spuEl = document.getElementById('kpi-sessions-user'); if (spuEl) spuEl.textContent = traffic.available ? traffic.sessionsPerUser.toFixed(2) : '—';

        const bingClicksEl = document.getElementById('kpi-bing-clicks');
        if (bingClicksEl) {
          bingClicksEl.textContent = bing.available ? bing.clicks.toLocaleString() : '—';
          document.getElementById('kpi-bing-clicks-delta').innerHTML = bing.available ? deltaHtml(bing.clicks, bing.prevClicks, false) : '';
          document.getElementById('kpi-bing-impressions').textContent = bing.available ? bing.impressions.toLocaleString() : '—';
          document.getElementById('kpi-bing-impressions-delta').innerHTML = bing.available ? deltaHtml(bing.impressions, bing.prevImpressions, false) : '';
          const bingQueriesEl = document.getElementById('table-bing-queries');
          if (bingQueriesEl) {
            bingQueriesEl.innerHTML = (bing.topQueries || []).map((q) => `
              <tr><td title="${String(q.query).replace(/"/g, '')}">${q.query}</td><td>${q.clicks}</td><td>${q.impressions}</td><td>${q.position ? q.position.toFixed(1) : '—'}</td></tr>
            `).join('') || '<tr><td colspan="4">No queries yet.</td></tr>';
          }
        }
        const qtEl = document.getElementById('queries-tracked-label'); if (qtEl) qtEl.textContent = search.available ? `(${search.queriesTracked} queries tracked)` : '';

        function fmtDuration(sec) { const m = Math.floor(sec / 60); const s = Math.round(sec % 60); return `${m}:${String(s).padStart(2, '0')}`; }

        trafficDailyPoints = (traffic.daily || []).map((d) => ({ label: d.date, value: d.sessions }));
        searchDailyPoints = (search.daily || []).map((d) => ({ label: d.date, value: d.clicks }));
        trafficChartPoints = trafficDailyPoints;
        searchChartPoints = searchDailyPoints;
        renderHero('hero-sessions', 'hero-sessions-stats', trafficDailyPoints, 'sessions', '#6C5CE7');
        renderHero('hero-clicks', 'hero-clicks-stats', searchDailyPoints, 'clicks', '#22B07D');
        renderBars('traffic-chart', 'traffic-chart-labels', trafficChartPoints);
        renderBars('search-chart', 'search-chart-labels', searchChartPoints);

        renderBarRowsInto('panel-channels', traffic.channels, 'channel', 'sessions', false);
        renderBarRowsInto('panel-overview-queries', (search.topQueries || []).slice(0, 6), 'query', 'clicks', true);
        renderBarRowsInto('panel-toppages', traffic.topPages, 'page', 'sessions', false);
        renderBarRowsInto('panel-devices', traffic.devices, 'device', 'sessions', true);
        renderBarRowsInto('panel-countries', traffic.countries, 'country', 'sessions', false);
        renderTableInto('table-queries', search.topQueries || [], [{ key: 'query' }, { key: 'clicks' }, { key: 'impressions' }, { key: 'position', fmt: (v) => v.toFixed(1) }]);
        renderTableInto('table-search-pages', search.topPages || [], [{ key: 'page', title: true }, { key: 'clicks' }, { key: 'impressions' }, { key: 'position', fmt: (v) => v.toFixed(1) }]);
        renderBarRowsInto('panel-landing', traffic.topLandingPages, 'page', 'sessions', true);

        const posEl = document.getElementById('panel-position-buckets');
        if (posEl && search.positionBuckets && search.positionBuckets.length) {
          const total = Math.max(1, search.queriesTracked);
          const colorFor = (l) => l === 'Top 3' ? 'var(--success)' : l === '4-10' ? 'var(--accent)' : l === '11-20' ? 'var(--warning)' : 'var(--text-3)';
          posEl.innerHTML = `<div style="display:flex;gap:14px;">${search.positionBuckets.map((b) => `
            <div style="flex:1;">
              <div class="pi-bar-row" style="margin-bottom:4px;">
                <span class="lbl" style="flex:0 0 60px;">${b.label}</span>
                <span class="track"><span class="fill" style="width:${(b.queries / total) * 100}%;background:${colorFor(b.label)};"></span></span>
                <span class="val">${b.queries}</span>
              </div>
            </div>`).join('')}</div>`;
        }

        rangeStatus.textContent = '';
      } catch {
        rangeStatus.textContent = 'Failed to load.';
      } finally {
        rangeGroup.querySelectorAll('button[data-days]').forEach((b) => (b.disabled = false));
      }
    });
  });

  // ── Granularity switching via the metrics API (no page reload) ──
  document.querySelectorAll('.pi-gran').forEach((granGroup) => {
    const type = granGroup.dataset.granFor;
    granGroup.querySelectorAll('button').forEach((btn) => {
      btn.addEventListener('click', async () => {
        granGroup.querySelectorAll('button').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const granularity = btn.dataset.gran;
        const chartId = type === 'traffic' ? 'traffic-chart' : 'search-chart';
        const labelsId = type === 'traffic' ? 'traffic-chart-labels' : 'search-chart-labels';
        try {
          const res = await fetch(`/api/admin/metrics?type=${type}&granularity=${granularity}`);
          const data = await res.json();
          if (data.available) {
            if (type === 'traffic') trafficChartPoints = data.points; else searchChartPoints = data.points;
            renderBars(chartId, labelsId, data.points, formatChartLabel);
          } else {
            document.getElementById(chartId).innerHTML = '<p class="pi-empty-panel">No data for this view.</p>';
          }
        } catch {
          document.getElementById(chartId).innerHTML = '<p class="pi-empty-panel">Failed to load.</p>';
        }
      });
    });
  });

  // ── Leads table: search/filter/sort/export (unchanged behavior) ──
  const search = document.getElementById('pi-search');
  const filterCat = document.getElementById('pi-filter-cat');
  const filterStatus = document.getElementById('pi-filter-status');
  const filterHot = document.getElementById('pi-filter-hot');
  const table = document.getElementById('pi-table');
  const count = document.getElementById('pi-count');
  const exportBtn = document.getElementById('pi-export');

  if (table) {
    const tbody = table.tBodies[0];
    const rows = Array.from(tbody.querySelectorAll('tr.pi-row'));

    function detailFor(row) {
      return tbody.querySelector(`tr.pi-detail[data-detail-for="${row.dataset.leadId}"]`);
    }
    rows.forEach((row) => {
      row.addEventListener('click', () => {
        const detail = detailFor(row);
        if (!detail) return;
        const willOpen = !row.classList.contains('open');
        row.classList.toggle('open', willOpen);
        detail.classList.toggle('open', willOpen);
      });
    });

    const filterTagEl = document.getElementById('pi-filter-tag');
    function applyFilters() {
      const q = (search?.value || '').toLowerCase().trim();
      const cat = filterCat?.value || '';
      const status = filterStatus?.value || '';
      const hotOnly = filterHot?.checked || false;
      const tag = filterTagEl?.value || '';
      let visible = 0;
      rows.forEach((row) => {
        const rowTags = (row.dataset.tags || '').split(',').filter(Boolean);
        const matches =
          (!q || row.dataset.email.includes(q) || row.dataset.name.includes(q) || row.dataset.company.includes(q)) &&
          (!cat || row.dataset.category === cat) &&
          (!status || row.dataset.status === status) &&
          (!hotOnly || row.dataset.hot === '1') &&
          (!tag || rowTags.includes(tag));
        row.style.display = matches ? '' : 'none';
        const detail = detailFor(row);
        if (detail && !matches) { detail.classList.remove('open'); row.classList.remove('open'); }
        if (detail) detail.style.display = matches ? '' : 'none';
        if (matches) visible++;
      });
      if (count) count.textContent = `${visible} lead${visible === 1 ? '' : 's'}`;
    }
    search?.addEventListener('input', applyFilters);
    filterCat?.addEventListener('change', applyFilters);
    filterStatus?.addEventListener('change', applyFilters);
    filterTagEl?.addEventListener('change', applyFilters);
    filterHot?.addEventListener('change', applyFilters);

    let sortKey = 'score', sortDir = -1;
    table.querySelectorAll('th[data-sort]').forEach((th) => {
      th.addEventListener('click', () => {
        const key = th.dataset.sort;
        sortDir = key === sortKey ? -sortDir : -1;
        sortKey = key;
        const attrKey = key === 'touch_count' ? 'touches' : key === 'last_seen_at' ? 'lastSeen' : key;
        rows.sort((a, b) => {
          const av = a.dataset[attrKey] ?? '', bv = b.dataset[attrKey] ?? '';
          const an = Number(av), bn = Number(bv);
          if (!isNaN(an) && !isNaN(bn) && av !== '' && bv !== '') return (an - bn) * sortDir;
          return String(av).localeCompare(String(bv)) * sortDir;
        });
        rows.forEach((r) => { const d = detailFor(r); tbody.appendChild(r); if (d) tbody.appendChild(d); });
      });
    });

    exportBtn?.addEventListener('click', () => {
      const header = ['Email', 'Company', 'Category', 'Score', 'Touches', 'Status', 'Last seen'];
      const lines = [header.join(',')];
      rows.forEach((row) => {
        if (row.style.display === 'none') return;
        const vals = [row.dataset.email, row.dataset.company, row.dataset.category, row.dataset.score, row.dataset.touches, row.dataset.status, row.dataset.lastSeen]
          .map((v) => `"${String(v || '').replace(/"/g, '""')}"`);
        lines.push(vals.join(','));
      });
      const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `purist-leads-${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  }

  // ── Email compose ──
  const sendBtn = document.getElementById('email-send-btn');
  const emailFeedback = document.getElementById('email-feedback');
  sendBtn?.addEventListener('click', async () => {
    const leadId = document.getElementById('email-lead-select').value;
    const subject = document.getElementById('email-subject').value.trim();
    const message = document.getElementById('email-message').value.trim();
    emailFeedback.className = 'pi-feedback';
    if (!leadId || !subject || !message) {
      emailFeedback.textContent = 'Please select a lead and fill in subject and message.';
      emailFeedback.className = 'pi-feedback err';
      return;
    }
    sendBtn.disabled = true;
    sendBtn.textContent = 'Sending...';
    try {
      const res = await fetch('/api/admin/send-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ leadId, subject, message }),
      });
      const data = await res.json();
      if (res.ok) {
        emailFeedback.textContent = `Sent to ${data.email}.`;
        emailFeedback.className = 'pi-feedback ok';
        document.getElementById('email-subject').value = '';
        document.getElementById('email-message').value = '';
      } else {
        emailFeedback.textContent = data.error || 'Failed to send.';
        emailFeedback.className = 'pi-feedback err';
      }
    } catch {
      emailFeedback.textContent = 'Network error, please try again.';
      emailFeedback.className = 'pi-feedback err';
    } finally {
      sendBtn.disabled = false;
      sendBtn.textContent = 'Send email';
    }
  });

  // ── Resend a pending/failed nurture step ──
  document.querySelectorAll('[data-resend-seq]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const sequenceId = btn.getAttribute('data-resend-seq');
      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = 'Sending...';
      try {
        const res = await fetch('/api/admin/resend-sequence', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sequenceId }),
        });
        const data = await res.json();
        if (res.ok) {
          btn.textContent = 'Sent ✓';
        } else {
          btn.textContent = 'Failed';
          btn.disabled = false;
          alert(data.error || 'Failed to send.');
        }
      } catch {
        btn.textContent = original;
        btn.disabled = false;
      }
    });
  });

  // ── CRM: toggle panels ──
  function wireToggle(btnId, panelId) {
    const btn = document.getElementById(btnId);
    const panel = document.getElementById(panelId);
    btn?.addEventListener('click', () => {
      const willShow = panel.style.display === 'none';
      panel.style.display = willShow ? 'block' : 'none';
      if (willShow && panelId === 'duplicates-panel') loadDuplicates();
    });
  }
  wireToggle('pi-toggle-new-contact', 'new-contact-panel');
  wireToggle('pi-toggle-import', 'import-panel');
  wireToggle('pi-toggle-duplicates', 'duplicates-panel');
  wireToggle('pi-toggle-new-deal', 'new-deal-panel');

  // ── Pipeline: win-rate donut ring ──
  const winRingCanvas = document.getElementById('pipeline-win-ring');
  if (winRingCanvas) {
    const won = Number(winRingCanvas.dataset.won || 0);
    const lost = Number(winRingCanvas.dataset.lost || 0);
    const total = won + lost;
    new Chart(winRingCanvas.getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: ['Won', 'Lost'],
        datasets: [{
          data: total > 0 ? [won, lost] : [1, 0],
          backgroundColor: total > 0 ? ['#22B07D', '#E0554F'] : ['#EDECF5'],
          borderWidth: 0,
        }],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '78%',
        animation: { duration: 600 },
        plugins: { legend: { display: false }, tooltip: { enabled: total > 0 } },
      },
    });
  }

  // ── Pipeline: new deal ──
  document.getElementById('nd-submit')?.addEventListener('click', async () => {
    const feedback = document.getElementById('nd-feedback');
    const leadId = document.getElementById('nd-lead').value;
    const title = document.getElementById('nd-title').value.trim();
    const value = document.getElementById('nd-value').value;
    const stage = document.getElementById('nd-stage').value;
    const expectedCloseDate = document.getElementById('nd-close-date').value;
    const recurring = document.getElementById('nd-recurring').checked;
    if (!leadId || !title) {
      feedback.textContent = 'Pick a lead and enter a title.';
      feedback.className = 'pi-feedback error';
      return;
    }
    feedback.textContent = 'Creating…';
    feedback.className = 'pi-feedback';
    try {
      const res = await fetch('/api/admin/create-deal', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ leadId, title, value, stage, expectedCloseDate, recurring }),
      });
      if (!res.ok) throw new Error('failed');
      feedback.textContent = 'Deal created. Reloading…';
      feedback.className = 'pi-feedback success';
      setTimeout(() => location.reload(), 500);
    } catch {
      feedback.textContent = 'Could not create the deal.';
      feedback.className = 'pi-feedback error';
    }
  });

  // ── Pipeline: change a deal's stage ──
  document.querySelectorAll('.pi-deal-stage-select').forEach((sel) => {
    sel.addEventListener('change', async () => {
      const dealId = sel.getAttribute('data-deal-for-stage');
      sel.disabled = true;
      try {
        await fetch('/api/admin/update-deal', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ dealId, stage: sel.value }),
        });
      } finally {
        location.reload();
      }
    });
  });

  // ── CRM: new contact ──
  document.getElementById('nc-submit')?.addEventListener('click', async () => {
    const feedback = document.getElementById('nc-feedback');
    const email = document.getElementById('nc-email').value.trim();
    if (!email) { feedback.textContent = 'Email is required.'; feedback.className = 'pi-feedback err'; return; }
    try {
      const res = await fetch('/api/admin/create-contact', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          name: document.getElementById('nc-name').value.trim(),
          phone: document.getElementById('nc-phone').value.trim(),
          company: document.getElementById('nc-company').value.trim(),
          companySize: document.getElementById('nc-company-size').value.trim(),
          tags: document.getElementById('nc-tags').value.trim(),
        }),
      });
      const data = await res.json();
      if (res.ok) {
        feedback.textContent = 'Saved. Reloading…';
        feedback.className = 'pi-feedback ok';
        setTimeout(() => location.reload(), 700);
      } else {
        feedback.textContent = data.error || 'Failed to save.';
        feedback.className = 'pi-feedback err';
      }
    } catch {
      feedback.textContent = 'Network error.';
      feedback.className = 'pi-feedback err';
    }
  });

  // ── CRM: CSV import ──
  document.getElementById('import-submit')?.addEventListener('click', async () => {
    const feedback = document.getElementById('import-feedback');
    const csv = document.getElementById('import-csv').value;
    if (!csv.trim()) { feedback.textContent = 'Paste CSV content first.'; feedback.className = 'pi-feedback err'; return; }
    try {
      const res = await fetch('/api/admin/import-contacts', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ csv }),
      });
      const data = await res.json();
      if (res.ok) {
        feedback.textContent = `Imported ${data.imported}, updated ${data.updated}, skipped ${data.skipped}. Reloading…`;
        feedback.className = 'pi-feedback ok';
        setTimeout(() => location.reload(), 1200);
      } else {
        feedback.textContent = data.error || 'Import failed.';
        feedback.className = 'pi-feedback err';
      }
    } catch {
      feedback.textContent = 'Network error.';
      feedback.className = 'pi-feedback err';
    }
  });

  // ── CRM: log a call/meeting/note from a lead's timeline ──
  document.querySelectorAll('.activity-add').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const row = btn.closest('.pi-detail-inner');
      const type = row.querySelector('.activity-type').value;
      const text = row.querySelector('.activity-text').value.trim();
      const leadId = btn.getAttribute('data-lead-for-activity');
      if (!text) return;
      btn.disabled = true;
      try {
        const res = await fetch('/api/admin/add-activity', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ leadId, type, activityBody: text }),
        });
        if (res.ok) location.reload();
        else { btn.disabled = false; alert('Failed to log activity.'); }
      } catch {
        btn.disabled = false;
      }
    });
  });

  // ── CRM: duplicate detection + merge ──
  const MERGE_FIELDS = ['name', 'phone', 'company', 'category', 'company_size'];
  function escapeAttr(v) { return String(v).replace(/"/g, '&quot;'); }

  async function loadDuplicates() {
    const list = document.getElementById('duplicates-list');
    try {
      const res = await fetch('/api/admin/find-duplicates');
      const data = await res.json();
      const groups = data.groups || [];
      if (groups.length === 0) {
        list.innerHTML = '<p class="pi-empty-panel">No duplicate phone numbers found.</p>';
        return;
      }
      list.innerHTML = groups.map((group, gi) => {
        const fieldPickers = MERGE_FIELDS.map((f) => {
          const values = [...new Set(group.map((l) => l[f]).filter((v) => v != null && v !== ''))];
          if (values.length <= 1) return '';
          return `<div style="margin:6px 0 0;">
            <span style="font-size:10.5px;color:var(--text-3);text-transform:uppercase;letter-spacing:0.04em;">${f.replace('_', ' ')}</span><br/>
            ${values.map((v, vi) => `<label style="margin-right:12px;font-size:12px;">
              <input type="radio" name="dup-field-${gi}-${f}" value="${escapeAttr(v)}" ${vi === 0 ? 'checked' : ''}/> ${v}
            </label>`).join('')}
          </div>`;
        }).join('');
        return `<div style="border:1px solid var(--border);border-radius:10px;padding:12px 14px;margin-bottom:10px;">
          <p style="font-size:11px;color:var(--text-2);margin:0 0 8px;">Matching phone: ${group[0].phone}</p>
          ${group.map((l, li) => `
            <label style="display:flex;align-items:center;gap:8px;font-size:12.5px;padding:4px 0;">
              <input type="radio" name="dup-keep-${gi}" value="${l.id}" ${li === 0 ? 'checked' : ''} />
              ${l.email} — ${l.name || 'no name'} — ${l.company || 'no company'} — score ${l.score}
            </label>`).join('')}
          ${fieldPickers ? `<div style="margin-top:6px;padding-top:8px;border-top:1px solid var(--border-soft);">
            <p style="font-size:10.5px;color:var(--text-3);margin:0 0 4px;">Fields differ, pick which value survives:</p>
            ${fieldPickers}
          </div>` : ''}
          <button class="pi-btn-small dup-merge" data-group="${gi}" style="margin-top:10px;">Merge into selected</button>
        </div>`;
      }).join('');

      list.querySelectorAll('.dup-merge').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const gi = btn.getAttribute('data-group');
          const group = groups[gi];
          const keepId = list.querySelector(`input[name="dup-keep-${gi}"]:checked`)?.value;
          const mergeIds = group.map((l) => l.id).filter((id) => id !== keepId);
          const fields = {};
          MERGE_FIELDS.forEach((f) => {
            const picked = list.querySelector(`input[name="dup-field-${gi}-${f}"]:checked`);
            if (picked) fields[f] = picked.value;
          });
          btn.disabled = true;
          btn.textContent = 'Merging…';
          for (const mergeId of mergeIds) {
            await fetch('/api/admin/merge-contacts', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ keepId, mergeId, fields }),
            });
          }
          loadDuplicates();
        });
      });
    } catch {
      list.innerHTML = '<p class="pi-empty-panel">Failed to load duplicates.</p>';
    }
  }
 }
 if (window.Chart) { __piBoot(); } else { window.addEventListener('chartjs-ready', __piBoot, { once: true }); }
</script>

</BaseLayout>
