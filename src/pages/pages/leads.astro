  .pi-kpi { background: var(--surface); border: 1px solid var(--border-soft); border-radius: 20px; padding: 16px 18px; box-shadow: var(--shadow); transition: box-shadow 0.25s cubic-bezier(0.22,1,0.36,1), transform 0.25s cubic-bezier(0.22,1,0.36,1); }
