            <div class="num" id="kpi-bing-impressions">{bing.impressions.toLocaleString()}</div>
            <div id="kpi-bing-impressions-delta">{bingImpressionsDelta !== null && <span class={`pi-delta ${bingImpressionsDelta > 0 ? 'up' : bingImpressionsDelta < 0 ? 'down' : 'flat'}`}>{bingImpressionsDelta > 0 ? '↑' : bingImpressionsDelta < 0 ? '↓' : '–'} {fmtDelta(bingImpressionsDelta)}</span>}</div>
            <div class="label">Bing impressions</div>
          </div>
        </div>
        <div class="pi-panel" style="margin-top:12px;">
          <h3>Top queries on Bing</h3>
