<script define:vars={{ clientData }}>
  // ── Tab switching ──
  const tabs = document.querySelectorAll('.pi-tab');
  const panels = document.querySelectorAll('.pi-panel-view');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.classList.remove('active'));
      panels.forEach((p) => p.classList.remove('active'));
      tab.classList.add('active');
      document.querySelector(`.pi-panel-view[data-panel="${tab.dataset.tab}"]`)?.classList.add('active');
    });
  });

  // ── "Compose email" shortcut from a lead's detail row ──
  document.querySelectorAll('[data-goto-email]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const leadId = btn.getAttribute('data-goto-email');
      tabs.forEach((t) => t.classList.remove('active'));
      panels.forEach((p) => p.classList.remove('active'));
      document.querySelector('.pi-tab[data-tab="emails"]')?.classList.add('active');
      document.querySelector('.pi-panel-view[data-panel="emails"]')?.classList.add('active');
      const select = document.getElementById('email-lead-select');
      if (select) select.value = leadId;
      window.scrollTo({ top: document.querySelector('.pi-compose')?.getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' });
    });
  });

  // ── Simple bar chart renderer with a peak-value callout pill ──
  function renderBars(containerId, labelsId, points, formatLabel) {
    const container = document.getElementById(containerId);
    if (!container) return;
    container.innerHTML = '';
    const max = Math.max(1, ...points.map((p) => p.value));
    const peakIdx = points.reduce((best, p, i) => (p.value > points[best].value ? i : best), 0);
    points.forEach((p, i) => {
      const bar = document.createElement('div');
      bar.className = 'pi-chart-bar' + (i === peakIdx && p.value > 0 ? ' peak' : '');
      bar.dataset.count = String(p.value);
      bar.style.height = Math.max(3, (p.value / max) * 100) + 'px';
      bar.title = `${p.label}: ${p.value}`;
      if (i === peakIdx && p.value > 0) {
        const pill = document.createElement('span');
        pill.className = 'pi-peak-pill';
        pill.textContent = String(p.value);
        bar.appendChild(pill);
      }
      container.appendChild(bar);
    });
    if (labelsId) {
      const labelsEl = document.getElementById(labelsId);
      if (labelsEl && points.length) {
        labelsEl.innerHTML = '';
        [points[0], points[Math.floor(points.length / 2)], points[points.length - 1]].forEach((p) => {
          const span = document.createElement('span');
          span.textContent = formatLabel ? formatLabel(p.label) : p.label;
          labelsEl.appendChild(span);
        });
      }
    }
  }

  function renderHero(containerId, statsId, points, unitLabel) {
    const container = document.getElementById(containerId);
    if (!container) return;
    container.innerHTML = '';
    const max = Math.max(1, ...points.map((p) => p.value));
    const peakIdx = points.reduce((best, p, i) => (p.value > points[best].value ? i : best), 0);
    points.forEach((p, i) => {
      const bar = document.createElement('div');
      bar.className = 'bar' + (i === peakIdx && p.value > 0 ? ' peak' : '');
      bar.style.height = Math.max(2, (p.value / max) * 64) + 'px';
      bar.title = `${p.label}: ${p.value}`;
      container.appendChild(bar);
    });
    const statsEl = document.getElementById(statsId);
    if (statsEl) {
      const total = points.reduce((s, p) => s + p.value, 0);
      const avg = points.length ? Math.round(total / points.length) : 0;
      const peak = points[peakIdx]?.value ?? 0;
      statsEl.innerHTML = `<span>Avg/day<b>${avg}</b></span><span>Peak day<b>${peak}</b></span><span>Total ${unitLabel}<b>${total}</b></span>`;
    }
  }

  const trafficDailyPoints = (clientData.trafficDaily || []).map((d) => ({ label: d.date, value: d.sessions }));
  const searchDailyPoints = (clientData.searchDaily || []).map((d) => ({ label: d.date, value: d.clicks }));
  renderHero('hero-sessions', 'hero-sessions-stats', trafficDailyPoints, 'sessions');
  renderHero('hero-clicks', 'hero-clicks-stats', searchDailyPoints, 'clicks');
  renderBars('traffic-chart', 'traffic-chart-labels', trafficDailyPoints);
  renderBars('search-chart', 'search-chart-labels', searchDailyPoints);

  // ── Date range switching: re-fetches overview + charts, no page reload ──
  function renderBarRowsInto(containerId, items, labelKey, valueKey, altClass) {
    const el = document.getElementById(containerId);
    if (!el) return;
    if (!items || items.length === 0) {
      el.innerHTML = '<p class="pi-empty-panel">No data for this range.</p>';
      return;
    }
    const max = Math.max(1, ...items.map((i) => i[valueKey]));
    el.innerHTML = items.map((i) => `
      <div class="pi-bar-row">
        <span class="lbl" title="${String(i[labelKey]).replace(/"/g, '')}">${i[labelKey]}</span>
        <span class="track"><span class="fill${altClass ? ' alt' : ''}" style="width:${(i[valueKey] / max) * 100}%"></span></span>
        <span class="val">${i[valueKey]}</span>
      </div>`).join('');
  }

  function renderTableInto(tbodyId, items, cols) {
    const el = document.getElementById(tbodyId);
    if (!el) return;
    el.innerHTML = items.map((row) => `<tr>${cols.map((c) => `<td${c.title ? ` title="${row[c.key]}"` : ''}>${c.fmt ? c.fmt(row[c.key]) : row[c.key]}</td>`).join('')}</tr>`).join('');
  }

  function deltaHtml(current, previous, invert) {
    if (previous === 0) return '';
    let pct = ((current - previous) / previous) * 100;
    if (invert) pct = -pct;
    const dir = pct > 0.5 ? 'up' : pct < -0.5 ? 'down' : 'flat';
    const arrow = dir === 'up' ? '↑' : dir === 'down' ? '↓' : '–';
    return `<span class="pi-delta ${dir}">${arrow} ${pct > 0 ? '+' : ''}${pct.toFixed(0)}%</span>`;
  }

  const rangeGroup = document.getElementById('pi-range');
  const rangeStatus = document.getElementById('pi-range-status');
  rangeGroup?.querySelectorAll('button[data-days]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const days = btn.dataset.days;
      rangeGroup.querySelectorAll('button[data-days]').forEach((b) => { b.classList.remove('active'); b.disabled = true; });
      btn.classList.add('active');
      rangeStatus.textContent = 'Loading…';
      try {
        const res = await fetch(`/api/admin/overview?days=${days}`);
        const data = await res.json();
        const { traffic, search } = data;
        const rangeText = days == 7 ? '7d' : days == 30 ? '30d' : days == 90 ? '90d' : days == 365 ? '12mo' : '16mo';
        document.querySelectorAll('.range-label').forEach((el) => (el.textContent = rangeText));

        document.getElementById('kpi-sessions').textContent = traffic.available ? traffic.sessions.toLocaleString() : '—';
        document.getElementById('kpi-users').textContent = traffic.available ? traffic.users.toLocaleString() : '—';
        document.getElementById('kpi-clicks').textContent = search.available ? search.clicks.toLocaleString() : '—';
        document.getElementById('kpi-position').textContent = search.available ? search.avgPosition.toFixed(1) : '—';
        document.getElementById('kpi-sessions-delta').innerHTML = traffic.available ? deltaHtml(traffic.sessions, traffic.prevSessions, false) : '';
        document.getElementById('kpi-users-delta').innerHTML = traffic.available ? deltaHtml(traffic.users, traffic.prevUsers, false) : '';
        document.getElementById('kpi-clicks-delta').innerHTML = search.available ? deltaHtml(search.clicks, search.prevClicks, false) : '';
        document.getElementById('kpi-position-delta').innerHTML = search.available ? deltaHtml(search.avgPosition, search.prevAvgPosition, true) : '';

        const newTrafficPoints = (traffic.daily || []).map((d) => ({ label: d.date, value: d.sessions }));
        const newSearchPoints = (search.daily || []).map((d) => ({ label: d.date, value: d.clicks }));
        renderHero('hero-sessions', 'hero-sessions-stats', newTrafficPoints, 'sessions');
        renderHero('hero-clicks', 'hero-clicks-stats', newSearchPoints, 'clicks');
        renderBars('traffic-chart', 'traffic-chart-labels', newTrafficPoints);
        renderBars('search-chart', 'search-chart-labels', newSearchPoints);

        renderBarRowsInto('panel-channels', traffic.channels, 'channel', 'sessions', false);
        renderBarRowsInto('panel-overview-queries', (search.topQueries || []).slice(0, 6), 'query', 'clicks', true);
        renderBarRowsInto('panel-toppages', traffic.topPages, 'page', 'sessions', false);
        renderBarRowsInto('panel-devices', traffic.devices, 'device', 'sessions', true);
        renderBarRowsInto('panel-countries', traffic.countries, 'country', 'sessions', false);
        renderTableInto('table-queries', search.topQueries || [], [{ key: 'query' }, { key: 'clicks' }, { key: 'impressions' }, { key: 'position', fmt: (v) => v.toFixed(1) }]);
        renderTableInto('table-search-pages', search.topPages || [], [{ key: 'page', title: true }, { key: 'clicks' }, { key: 'impressions' }, { key: 'position', fmt: (v) => v.toFixed(1) }]);

        rangeStatus.textContent = '';
      } catch {
        rangeStatus.textContent = 'Failed to load.';
      } finally {
        rangeGroup.querySelectorAll('button[data-days]').forEach((b) => (b.disabled = false));
      }
    });
  });

  // ── Granularity switching via the metrics API (no page reload) ──
  document.querySelectorAll('.pi-gran').forEach((granGroup) => {
    const type = granGroup.dataset.granFor;
    granGroup.querySelectorAll('button').forEach((btn) => {
      btn.addEventListener('click', async () => {
        granGroup.querySelectorAll('button').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const granularity = btn.dataset.gran;
        const chartId = type === 'traffic' ? 'traffic-chart' : 'search-chart';
        const labelsId = type === 'traffic' ? 'traffic-chart-labels' : 'search-chart-labels';
        try {
          const res = await fetch(`/api/admin/metrics?type=${type}&granularity=${granularity}`);
          const data = await res.json();
          if (data.available) {
            renderBars(chartId, labelsId, data.points);
          } else {
            document.getElementById(chartId).innerHTML = '<p class="pi-empty-panel">No data for this view.</p>';
          }
        } catch {
          document.getElementById(chartId).innerHTML = '<p class="pi-empty-panel">Failed to load.</p>';
        }
      });
    });
  });

  // ── Leads table: search/filter/sort/export (unchanged behavior) ──
  const search = document.getElementById('pi-search');
  const filterCat = document.getElementById('pi-filter-cat');
  const filterStatus = document.getElementById('pi-filter-status');
  const filterHot = document.getElementById('pi-filter-hot');
  const table = document.getElementById('pi-table');
  const count = document.getElementById('pi-count');
  const exportBtn = document.getElementById('pi-export');

  if (table) {
    const tbody = table.tBodies[0];
    const rows = Array.from(tbody.querySelectorAll('tr.pi-row'));

    function detailFor(row) {
      return tbody.querySelector(`tr.pi-detail[data-detail-for="${row.dataset.leadId}"]`);
    }
    rows.forEach((row) => {
      row.addEventListener('click', () => {
        const detail = detailFor(row);
        if (!detail) return;
        const willOpen = !row.classList.contains('open');
        row.classList.toggle('open', willOpen);
        detail.classList.toggle('open', willOpen);
      });
    });

    function applyFilters() {
      const q = (search?.value || '').toLowerCase().trim();
      const cat = filterCat?.value || '';
      const status = filterStatus?.value || '';
      const hotOnly = filterHot?.checked || false;
      let visible = 0;
      rows.forEach((row) => {
        const matches =
          (!q || row.dataset.email.includes(q) || row.dataset.name.includes(q) || row.dataset.company.includes(q)) &&
          (!cat || row.dataset.category === cat) &&
          (!status || row.dataset.status === status) &&
          (!hotOnly || row.dataset.hot === '1');
        row.style.display = matches ? '' : 'none';
        const detail = detailFor(row);
        if (detail && !matches) { detail.classList.remove('open'); row.classList.remove('open'); }
        if (detail) detail.style.display = matches ? '' : 'none';
        if (matches) visible++;
      });
      if (count) count.textContent = `${visible} lead${visible === 1 ? '' : 's'}`;
    }
    search?.addEventListener('input', applyFilters);
    filterCat?.addEventListener('change', applyFilters);
    filterStatus?.addEventListener('change', applyFilters);
    filterHot?.addEventListener('change', applyFilters);

    let sortKey = 'score', sortDir = -1;
    table.querySelectorAll('th[data-sort]').forEach((th) => {
      th.addEventListener('click', () => {
        const key = th.dataset.sort;
        sortDir = key === sortKey ? -sortDir : -1;
        sortKey = key;
        const attrKey = key === 'touch_count' ? 'touches' : key === 'last_seen_at' ? 'lastSeen' : key;
        rows.sort((a, b) => {
          const av = a.dataset[attrKey] ?? '', bv = b.dataset[attrKey] ?? '';
          const an = Number(av), bn = Number(bv);
          if (!isNaN(an) && !isNaN(bn) && av !== '' && bv !== '') return (an - bn) * sortDir;
          return String(av).localeCompare(String(bv)) * sortDir;
        });
        rows.forEach((r) => { const d = detailFor(r); tbody.appendChild(r); if (d) tbody.appendChild(d); });
      });
    });

    exportBtn?.addEventListener('click', () => {
      const header = ['Email', 'Company', 'Category', 'Score', 'Touches', 'Status', 'Last seen'];
      const lines = [header.join(',')];
      rows.forEach((row) => {
        if (row.style.display === 'none') return;
        const vals = [row.dataset.email, row.dataset.company, row.dataset.category, row.dataset.score, row.dataset.touches, row.dataset.status, row.dataset.lastSeen]
          .map((v) => `"${String(v || '').replace(/"/g, '""')}"`);
        lines.push(vals.join(','));
      });
      const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `purist-leads-${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  }

  // ── Email compose ──
  const sendBtn = document.getElementById('email-send-btn');
  const emailFeedback = document.getElementById('email-feedback');
  sendBtn?.addEventListener('click', async () => {
    const leadId = document.getElementById('email-lead-select').value;
    const subject = document.getElementById('email-subject').value.trim();
    const message = document.getElementById('email-message').value.trim();
    emailFeedback.className = 'pi-feedback';
    if (!leadId || !subject || !message) {
      emailFeedback.textContent = 'Please select a lead and fill in subject and message.';
      emailFeedback.className = 'pi-feedback err';
      return;
    }
    sendBtn.disabled = true;
    sendBtn.textContent = 'Sending...';
    try {
      const res = await fetch('/api/admin/send-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ leadId, subject, message }),
      });
      const data = await res.json();
      if (res.ok) {
        emailFeedback.textContent = `Sent to ${data.email}.`;
        emailFeedback.className = 'pi-feedback ok';
        document.getElementById('email-subject').value = '';
        document.getElementById('email-message').value = '';
      } else {
        emailFeedback.textContent = data.error || 'Failed to send.';
        emailFeedback.className = 'pi-feedback err';
      }
    } catch {
      emailFeedback.textContent = 'Network error, please try again.';
      emailFeedback.className = 'pi-feedback err';
    } finally {
      sendBtn.disabled = false;
      sendBtn.textContent = 'Send email';
    }
  });

  // ── Resend a pending/failed nurture step ──
  document.querySelectorAll('[data-resend-seq]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const sequenceId = btn.getAttribute('data-resend-seq');
      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = 'Sending...';
      try {
        const res = await fetch('/api/admin/resend-sequence', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sequenceId }),
        });
        const data = await res.json();
        if (res.ok) {
          btn.textContent = 'Sent ✓';
        } else {
          btn.textContent = 'Failed';
          btn.disabled = false;
          alert(data.error || 'Failed to send.');
        }
      } catch {
        btn.textContent = original;
        btn.disabled = false;
      }
    });
  });
</script>

</BaseLayout>
