              <div class="pi-bar-row" style="margin-bottom:4px;">
                <span class="lbl" style="flex:0 0 60px;">{b.label}</span>
                <span class="track"><span class="fill" style={`width:${(b.queries / Math.max(1, search.queriesTracked)) * 100}%;background:${b.label === 'Top 3' ? 'var(--success)' : b.label === '4-10' ? 'var(--accent)' : b.label === '11-20' ? 'var(--warning)' : 'var(--text-3)'};`}></span></span>
                <span class="val">{b.queries}</span>
