---
export const prerender = false;
import BaseLayout from '~/layouts/BaseLayout.astro';
import { createSupabaseAdminClient } from '~/lib/supabase-admin';
import { fetchTrafficOverview, fetchSearchOverview, pctChange } from '~/lib/site-metrics';

// This route is gated by src/middleware.ts (PROTECTED_ROUTES), a visitor
// only reaches this code after a valid Supabase Auth session was
// confirmed. Using the service-role client here is safe because of that
// gate, it is never exposed to the browser.
const db = createSupabaseAdminClient();

const { data: leadsRaw, error } = await db
  .from('leads')
  .select('id, email, name, company, category, profession_slug, source, page, status, score, touch_count, created_at, last_seen_at')
  .order('score', { ascending: false });

const leads = leadsRaw ?? [];
const leadIds = leads.map((l) => l.id);

const { data: eventsRaw } = leadIds.length
  ? await db
      .from('lead_events')
      .select('id, lead_id, event_type, source, page, metadata, points, created_at')
      .in('lead_id', leadIds)
      .order('created_at', { ascending: false })
  : { data: [] as any[] };
const events = eventsRaw ?? [];

const { data: sequencesRaw } = leadIds.length
  ? await db
      .from('email_sequences')
      .select('id, lead_id, step, scheduled_at, sent_at, status')
      .in('lead_id', leadIds)
      .order('scheduled_at', { ascending: false })
  : { data: [] as any[] };
const sequences = sequencesRaw ?? [];

// Defaults to the largest range Search Console's API actually retains
// (~16 months, its own hard limit, not a choice made here) so the page
// opens showing full available history rather than an arbitrary 30 days.
// The range pills below can narrow this down.
const DEFAULT_DAYS = 480;
const [traffic, search] = await Promise.all([fetchTrafficOverview(DEFAULT_DAYS), fetchSearchOverview(DEFAULT_DAYS)]);
const emailsSent = sequences.filter((s) => s.status === 'sent').length;
const emailsPending = sequences.filter((s) => s.status === 'pending').length;
const emailsFailed = sequences.filter((s) => s.status === 'failed').length;

const sessionsDelta = traffic.available ? pctChange(traffic.sessions, traffic.prevSessions) : null;
const usersDelta = traffic.available ? pctChange(traffic.users, traffic.prevUsers) : null;
const clicksDelta = search.available ? pctChange(search.clicks, search.prevClicks) : null;
const impressionsDelta = search.available ? pctChange(search.impressions, search.prevImpressions) : null;
const positionDelta = search.available ? (search.prevAvgPosition ? search.prevAvgPosition - search.avgPosition : null) : null;

const leadsById: Record<string, (typeof leads)[number]> = {};
leads.forEach((l) => (leadsById[l.id] = l));

// ── Group events and sequences per lead for the expandable detail row ──
const eventsByLead: Record<string, typeof events> = {};
events.forEach((e) => {
  (eventsByLead[e.lead_id] ??= []).push(e);
});
const sequencesByLead: Record<string, typeof sequences> = {};
sequences.forEach((s) => {
  (sequencesByLead[s.lead_id] ??= []).push(s);
});

// ── KPIs ──
const totalLeads = leads.length;
const avgScore = totalLeads ? Math.round(leads.reduce((sum, l) => sum + (l.score ?? 0), 0) / totalLeads) : 0;

const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
const newThisWeek = leads.filter((l) => new Date(l.created_at) >= sevenDaysAgo).length;

const hotLeads = leads.filter((l) => (l.score ?? 0) >= 50);
const auditRequests = events.filter((e) => e.event_type === 'audit_request').length;

const categoryCounts: Record<string, number> = {};
const categoryScores: Record<string, number[]> = {};
leads.forEach((l) => {
  const c = l.category || 'Unspecified';
  categoryCounts[c] = (categoryCounts[c] || 0) + 1;
  (categoryScores[c] ??= []).push(l.score ?? 0);
});
const topCategoryEntry = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1])[0];
const topCategory = topCategoryEntry ? topCategoryEntry[0] : 'None yet';
const categoryBreakdown = Object.entries(categoryCounts)
  .map(([cat, count]) => ({
    category: cat,
    count,
    avgScore: Math.round(categoryScores[cat].reduce((s, v) => s + v, 0) / categoryScores[cat].length),
  }))
  .sort((a, b) => b.count - a.count);

const categories = [...new Set(leads.map((l) => l.category).filter(Boolean))].sort();

// ── Funnel: event type breakdown (ordered by intent, matches lead-scoring.ts) ──
const EVENT_ORDER = ['newsletter_signup', 'guide_download', 'report_download', 'roi_calculator', 'audit_request'];
const EVENT_LABELS: Record<string, string> = {
  newsletter_signup: 'Newsletter signup',
  guide_download: 'Guide download',
  report_download: 'Report download',
  roi_calculator: 'ROI calculator',
  audit_request: 'Audit request',
};
const funnelCounts: Record<string, number> = {};
EVENT_ORDER.forEach((k) => (funnelCounts[k] = 0));
events.forEach((e) => {
  if (funnelCounts[e.event_type] !== undefined) funnelCounts[e.event_type]++;
});
const maxFunnelCount = Math.max(1, ...Object.values(funnelCounts));

function topN(items: (string | null | undefined)[], n: number) {
  const counts: Record<string, number> = {};
  items.forEach((v) => {
    const key = v || 'Direct / unknown';
    counts[key] = (counts[key] || 0) + 1;
  });
  return Object.entries(counts).sort((a, b) => b[1] - a[1]).slice(0, n);
}
const topSources = topN(events.map((e) => e.source), 6);
const maxSourceCount = Math.max(1, ...topSources.map(([, c]) => c));
const topProfessions = topN(leads.map((l) => l.profession_slug), 6);
const maxProfessionCount = Math.max(1, ...topProfessions.map(([, c]) => c));

// ── 30-day activity chart (events per day) ──
const DAYS = 30;
const dayBuckets: { date: string; label: string; count: number }[] = [];
for (let i = DAYS - 1; i >= 0; i--) {
  const d = new Date();
  d.setDate(d.getDate() - i);
  const key = d.toISOString().slice(0, 10);
  dayBuckets.push({ date: key, label: d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }), count: 0 });
}
const dayIndex: Record<string, number> = {};
dayBuckets.forEach((b, i) => (dayIndex[b.date] = i));
events.forEach((e) => {
  const key = new Date(e.created_at).toISOString().slice(0, 10);
  if (dayIndex[key] !== undefined) dayBuckets[dayIndex[key]].count++;
});

function fmtDate(d: string) {
  return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}
function fmtDateTime(d: string) {
  return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
}
function fmtDelta(v: number | null) {
  if (v === null) return null;
  const sign = v > 0 ? '+' : '';
  return `${sign}${v.toFixed(0)}%`;
}

const SEQUENCE_LABELS: Record<number, string> = { 0: 'J0', 2: 'J2', 5: 'J5' };

const hour = new Date().getUTCHours();
const greeting = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';

// Serialize small datasets for client-side JS (tab switching, granularity, email compose)
const clientData = {
  trafficDaily: traffic.daily,
  searchDaily: search.daily,
  leads: leads.map((l) => ({ id: l.id, email: l.email, company: l.company, score: l.score })),
  sequences: sequences.map((s) => ({ id: s.id, leadId: s.lead_id, step: s.step, status: s.status, sentAt: s.sent_at, scheduledAt: s.scheduled_at })),
};
---

<BaseLayout title="PURIST Intelligence | PURIST" description="Internal analytics and lead intelligence center." noindex>

<style>
  .pi {
    --bg: #EEF4FC;
    --bg-2: #E4EEFB;
    --surface: #FFFFFF;
    --border: #DCE7F7;
    --text-1: #0F1B33;
    --text-2: #5A6B8C;
    --text-3: #8B9BC0;
    --accent: #2563EB;
    --accent-2: #60A5FA;
    --accent-soft: #E8F0FE;
    --success: #17A673;
    --success-bg: #E3F6EE;
    --danger: #E0473F;
    --danger-bg: #FCEAE9;
    --warning: #D97F1E;
    --warning-bg: #FDF1E2;
    --shadow: 0 1px 2px rgba(15,27,51,0.04), 0 4px 16px rgba(15,27,51,0.05);
    max-width: 1320px;
    margin: 0 auto;
    padding: 28px 24px 100px;
    background: var(--bg);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    color: var(--text-1);
  }

  .pi-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .pi-h1 { font-size: 24px; font-weight: 600; color: var(--text-1); margin: 0; letter-spacing: -0.01em; }
  .pi-sub { color: var(--text-2); font-size: 13.5px; margin: 4px 0 0; }
  .pi-demo-link { font-size: 12.5px; font-weight: 500; color: var(--accent); text-decoration: none; border: 1px solid var(--border); border-radius: 10px; padding: 8px 16px; white-space: nowrap; background: var(--surface); box-shadow: var(--shadow); }
  .pi-demo-link:hover { background: var(--accent-soft); }

  /* Pill tab navigation */
  .pi-nav { display: flex; gap: 4px; background: var(--surface); border-radius: 14px; padding: 5px; margin-top: 20px; box-shadow: var(--shadow); width: fit-content; flex-wrap: wrap; }
  .pi-tab { border: none; background: transparent; font-size: 13px; font-weight: 500; color: var(--text-2); padding: 9px 18px; border-radius: 10px; cursor: pointer; font-family: inherit; white-space: nowrap; }
  .pi-tab.active { background: var(--text-1); color: #fff; }
  .pi-tab:not(.active):hover { background: var(--bg-2); color: var(--text-1); }
  .pi-panel-view { display: none; margin-top: 20px; }
  .pi-panel-view.active { display: block; }

  .pi-section-h { font-size: 14px; font-weight: 600; color: var(--text-1); margin: 28px 0 4px; }
  .pi-section-sub { font-size: 11px; color: var(--text-3); font-weight: 400; }
  .pi-notice { margin-top: 14px; padding: 12px 16px; border: 1px solid var(--warning-bg); border-radius: 12px; font-size: 12.5px; color: var(--text-2); background: var(--warning-bg); }
  .pi-notice code { background: rgba(15,27,51,0.06); padding: 1px 6px; border-radius: 4px; font-size: 11.5px; color: var(--text-1); }

  /* KPI grid */
  .pi-kpis { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; margin-top: 14px; }
  @media (max-width: 1000px) { .pi-kpis { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 560px) { .pi-kpis { grid-template-columns: repeat(2, 1fr); } }
  .pi-kpi { background: var(--surface); border-radius: 14px; padding: 16px 18px; box-shadow: var(--shadow); }
  .pi-kpi .num { font-size: 25px; font-weight: 600; color: var(--text-1); font-variant-numeric: tabular-nums; line-height: 1.1; }
  .pi-kpi .label { font-size: 11.5px; color: var(--text-2); margin-top: 5px; }
  .pi-kpi .range-label { text-transform: none; }
  .pi-delta { font-size: 10.5px; font-weight: 600; margin-top: 7px; display: inline-flex; align-items: center; gap: 3px; padding: 2px 8px; border-radius: 20px; }
  .pi-delta.up { color: var(--success); background: var(--success-bg); }
  .pi-delta.down { color: var(--danger); background: var(--danger-bg); }
  .pi-delta.flat { color: var(--text-3); background: var(--bg-2); }

  /* Hero gradient cards */
  .pi-hero-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px; }
  @media (max-width: 900px) { .pi-hero-row { grid-template-columns: 1fr; } }
  .pi-hero { border-radius: 18px; padding: 20px 22px; color: #fff; position: relative; overflow: hidden; box-shadow: var(--shadow); }
  .pi-hero.blue { background: linear-gradient(135deg, #1E4FD6 0%, #3B7CF0 100%); }
  .pi-hero.sky { background: linear-gradient(135deg, #2F6FE0 0%, #6FA8F5 100%); }
  .pi-hero-top { display: flex; justify-content: space-between; align-items: flex-start; }
  .pi-hero h3 { font-size: 12.5px; font-weight: 500; margin: 0; opacity: 0.85; }
  .pi-hero .hero-num { font-size: 26px; font-weight: 700; margin-top: 2px; }
  .pi-hero-chart { display: flex; align-items: flex-end; gap: 3px; height: 64px; margin-top: 16px; position: relative; }
  .pi-hero-chart .bar { flex: 1; min-width: 2px; background: rgba(255,255,255,0.35); border-radius: 2px 2px 0 0; }
  .pi-hero-chart .bar.peak { background: #fff; }
  .pi-hero-stats { display: flex; gap: 18px; margin-top: 14px; font-size: 11px; opacity: 0.9; }
  .pi-hero-stats b { display: block; font-size: 13px; font-weight: 600; }

  /* Panels */
  .pi-panels { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin-top: 16px; }
  @media (max-width: 900px) { .pi-panels { grid-template-columns: 1fr; } }
  .pi-panel { background: var(--surface); border-radius: 14px; padding: 18px 20px; box-shadow: var(--shadow); }
  .pi-panel h3 { font-size: 12.5px; font-weight: 600; color: var(--text-1); margin: 0 0 14px; }
  .pi-bar-row { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; font-size: 12.5px; }
  .pi-bar-row .lbl { flex: 0 0 130px; color: var(--text-1); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pi-bar-row .track { flex: 1; height: 7px; border-radius: 20px; background: var(--bg-2); overflow: hidden; }
  .pi-bar-row .fill { height: 100%; border-radius: 20px; background: var(--accent); }
  .pi-bar-row .fill.alt { background: var(--accent-2); }
  .pi-bar-row .val { flex: 0 0 32px; text-align: right; font-variant-numeric: tabular-nums; color: var(--text-2); font-size: 11.5px; font-weight: 500; }
  .pi-empty-panel { color: var(--text-3); font-size: 12.5px; }

  /* Date range pills */
  .pi-range { display: flex; align-items: center; gap: 3px; background: var(--surface); border-radius: 12px; padding: 5px; box-shadow: var(--shadow); }
  .pi-range button { border: none; background: transparent; font-size: 12px; font-weight: 500; color: var(--text-2); padding: 7px 13px; border-radius: 8px; cursor: pointer; font-family: inherit; }
  .pi-range button.active { background: var(--accent); color: #fff; }
  .pi-range button:not(.active):hover { background: var(--bg-2); color: var(--text-1); }
  .pi-range button:disabled { opacity: 0.5; cursor: wait; }
  .pi-range-status { font-size: 11px; color: var(--text-3); padding: 0 8px; }

  /* Granularity pills */
  .pi-gran { display: flex; gap: 4px; background: var(--bg-2); border-radius: 10px; padding: 3px; width: fit-content; }
  .pi-gran button { border: none; background: transparent; font-size: 11.5px; font-weight: 500; color: var(--text-2); padding: 6px 14px; border-radius: 8px; cursor: pointer; font-family: inherit; }
  .pi-gran button.active { background: var(--surface); color: var(--text-1); box-shadow: 0 1px 2px rgba(15,27,51,0.08); }

  .pi-chart { margin-top: 16px; background: var(--surface); border-radius: 14px; padding: 20px 20px 14px; box-shadow: var(--shadow); }
  .pi-chart-head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
  .pi-chart h3 { font-size: 13px; font-weight: 600; color: var(--text-1); margin: 0; }
  .pi-chart-bars { display: flex; align-items: flex-end; gap: 3px; height: 110px; overflow-x: auto; padding-bottom: 4px; position: relative; }
  .pi-chart-bar { flex: 1 0 6px; min-width: 6px; background: var(--accent-2); border-radius: 3px 3px 0 0; opacity: 0.75; position: relative; }
  .pi-chart-bar:hover, .pi-chart-bar.peak { opacity: 1; background: var(--accent); }
  .pi-chart-bar[data-count="0"] { background: var(--bg-2); }
  .pi-peak-pill { position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); background: var(--text-1); color: #fff; font-size: 10px; font-weight: 600; padding: 2px 7px; border-radius: 6px; margin-bottom: 4px; white-space: nowrap; }
  .pi-chart-labels { display: flex; justify-content: space-between; font-size: 10.5px; color: var(--text-3); margin-top: 8px; }

  .pi-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 24px 0 12px; }
  .pi-controls input, .pi-controls select { font-size: 13px; padding: 9px 13px; border-radius: 10px; border: 1px solid var(--border); background: var(--surface); color: var(--text-1); font-family: inherit; }
  .pi-controls input:focus, .pi-controls select:focus { outline: 2px solid var(--accent-soft); border-color: var(--accent); }
  .pi-controls input { flex: 1; min-width: 200px; }
  .pi-controls label.chk { display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-2); white-space: nowrap; }
  .pi-export { font-size: 12.5px; font-weight: 500; color: var(--accent); text-decoration: none; border: 1px solid var(--border); border-radius: 10px; padding: 8px 15px; white-space: nowrap; background: var(--surface); cursor: pointer; font-family: inherit; }
  .pi-export:hover { background: var(--accent-soft); }

  .pi-table-scroll { overflow-x: auto; background: var(--surface); border-radius: 14px; box-shadow: var(--shadow); }
  table.pi-table { width: 100%; border-collapse: collapse; font-size: 13px; white-space: nowrap; }
  table.pi-table th { text-align: left; font-size: 11px; font-weight: 600; color: var(--text-2); padding: 12px 16px; border-bottom: 1px solid var(--border); cursor: pointer; user-select: none; }
  table.pi-table th:hover { color: var(--accent); }
  table.pi-table td { padding: 11px 16px; border-bottom: 1px solid var(--bg-2); font-variant-numeric: tabular-nums; color: var(--text-1); }
  table.pi-table tbody tr.pi-row { cursor: pointer; }
  table.pi-table tbody tr.pi-row:hover { background: var(--accent-soft); }
  .pi-score { font-weight: 700; color: var(--accent); }
  .pi-status { font-size: 10.5px; font-weight: 600; padding: 3px 10px; border-radius: 20px; text-transform: capitalize; }
  .pi-status.active { background: var(--success-bg); color: var(--success); }
  .pi-status.converted { background: var(--accent-soft); color: var(--accent); }
  .pi-status.unsubscribed { background: var(--bg-2); color: var(--text-3); }
  .pi-hot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--danger); margin-right: 6px; vertical-align: middle; }
  .pi-caret { display: inline-block; transition: transform 0.15s; color: var(--text-3); margin-right: 8px; font-size: 10px; }
  tr.pi-row.open .pi-caret { transform: rotate(90deg); }

  .pi-detail-cell { background: var(--bg); padding: 0 !important; }
  .pi-detail-inner { padding: 16px 24px; display: none; white-space: normal; }
  tr.pi-detail.open .pi-detail-inner { display: block; }
  .pi-detail-grid { display: grid; grid-template-columns: 1fr 200px; gap: 24px; }
  @media (max-width: 700px) { .pi-detail-grid { grid-template-columns: 1fr; } }
  .pi-timeline { list-style: none; margin: 0; padding: 0; }
  .pi-timeline li { display: flex; gap: 10px; padding: 7px 0; border-bottom: 1px solid var(--border); font-size: 12.5px; }
  .pi-timeline li:last-child { border-bottom: none; }
  .pi-timeline .ev-type { font-weight: 500; color: var(--text-1); flex: 0 0 150px; }
  .pi-timeline .ev-meta { color: var(--text-3); flex: 1; }
  .pi-timeline .ev-pts { color: var(--accent); font-variant-numeric: tabular-nums; flex: 0 0 40px; text-align: right; }
  .pi-seq { list-style: none; margin: 0; padding: 0; }
  .pi-seq li { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; font-size: 12px; }
  .pi-seq-badge { font-size: 10px; font-weight: 600; text-transform: capitalize; padding: 3px 9px; border-radius: 20px; }
  .pi-seq-badge.sent { background: var(--success-bg); color: var(--success); }
  .pi-seq-badge.pending { background: var(--bg-2); color: var(--text-2); }
  .pi-seq-badge.failed { background: var(--danger-bg); color: var(--danger); }
  .pi-seq-badge.skipped { background: var(--bg-2); color: var(--text-3); }
  .pi-detail-h { font-size: 11px; font-weight: 600; color: var(--text-2); margin: 0 0 8px; }

  .pi-empty { text-align: center; padding: 60px 20px; color: var(--text-2); border-radius: 14px; margin-top: 24px; background: var(--surface); box-shadow: var(--shadow); }
  .pi-empty h2 { font-size: 16px; font-weight: 600; color: var(--text-1); margin: 0 0 8px; }

  /* Emails tab */
  .pi-compose { background: var(--surface); border-radius: 14px; padding: 20px 22px; box-shadow: var(--shadow); margin-top: 16px; }
  .pi-compose h3 { font-size: 13.5px; font-weight: 600; margin: 0 0 14px; }
  .pi-compose-grid { display: grid; gap: 12px; }
  .pi-compose select, .pi-compose input, .pi-compose textarea { width: 100%; font-size: 13px; padding: 10px 13px; border-radius: 10px; border: 1px solid var(--border); background: #fff; color: var(--text-1); font-family: inherit; }
  .pi-compose textarea { min-height: 110px; resize: vertical; }
  .pi-btn-primary { background: var(--accent); color: #fff; border: none; border-radius: 10px; padding: 10px 20px; font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; width: fit-content; }
  .pi-btn-primary:hover { background: #1D4ED8; }
  .pi-btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
  .pi-btn-small { background: var(--accent-soft); color: var(--accent); border: none; border-radius: 8px; padding: 5px 12px; font-size: 11px; font-weight: 600; cursor: pointer; font-family: inherit; }
  .pi-btn-small:hover { background: var(--accent); color: #fff; }
  .pi-btn-small:disabled { opacity: 0.5; cursor: not-allowed; }
  .pi-feedback { font-size: 12.5px; margin-top: 10px; padding: 8px 12px; border-radius: 8px; display: none; }
  .pi-feedback.ok { background: var(--success-bg); color: var(--success); display: block; }
  .pi-feedback.err { background: var(--danger-bg); color: var(--danger); display: block; }
</style>

<div class="pi">
  <div class="pi-header">
    <div>
      <h1 class="pi-h1">{greeting} — PURIST Intelligence</h1>
      <p class="pi-sub">Traffic, search performance, lead intelligence, and outreach, all in one place.</p>
    </div>
    <a href="/pages/dashboard" class="pi-demo-link">View client demo →</a>
  </div>

  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
    <nav class="pi-nav" id="pi-nav">
      <button class="pi-tab active" data-tab="overview">Overview</button>
      <button class="pi-tab" data-tab="traffic">Traffic</button>
      <button class="pi-tab" data-tab="search">Search</button>
