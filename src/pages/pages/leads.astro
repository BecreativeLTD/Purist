---
export const prerender = false;
import BaseLayout from '~/layouts/BaseLayout.astro';
import { createSupabaseAdminClient } from '~/lib/supabase-admin';
import { fetchTrafficOverview, fetchSearchOverview, pctChange } from '~/lib/site-metrics';
import { fetchBingOverview } from '~/lib/bing-metrics';

// This route is gated by src/middleware.ts (PROTECTED_ROUTES), a visitor
// only reaches this code after a valid Supabase Auth session was
// confirmed. Using the service-role client here is safe because of that
// gate, it is never exposed to the browser.
const db = createSupabaseAdminClient();

// The v3 CRM migration (supabase-schema-v3-crm.sql) adds phone/tags/
// company_size/last_contacted_at. If it hasn't been run yet, selecting
// those columns fails the whole query, so try the wide select first and
// fall back to the original column list, degrading the CRM-specific UI
// rather than breaking the page.
let crmColumnsAvailable = true;
let { data: leadsRaw, error } = await db
  .from('leads')
  .select('id, email, name, company, phone, tags, company_size, last_contacted_at, category, profession_slug, source, page, status, score, touch_count, created_at, last_seen_at')
  .order('score', { ascending: false });

if (error) {
  crmColumnsAvailable = false;
  ({ data: leadsRaw, error } = await db
    .from('leads')
    .select('id, email, name, company, category, profession_slug, source, page, status, score, touch_count, created_at, last_seen_at')
    .order('score', { ascending: false }));
}

const leads = (leadsRaw ?? []).map((l: any) => ({
  phone: null, tags: [] as string[], company_size: null, last_contacted_at: null, ...l,
}));
const leadIds = leads.map((l) => l.id);

const { data: eventsRaw } = leadIds.length
  ? await db
      .from('lead_events')
      .select('id, lead_id, event_type, source, page, metadata, points, created_at')
      .in('lead_id', leadIds)
      .order('created_at', { ascending: false })
  : { data: [] as any[] };
const events = eventsRaw ?? [];

const { data: sequencesRaw } = leadIds.length
  ? await db
      .from('email_sequences')
      .select('id, lead_id, step, scheduled_at, sent_at, status')
      .in('lead_id', leadIds)
      .order('scheduled_at', { ascending: false })
  : { data: [] as any[] };
const sequences = sequencesRaw ?? [];

const { data: activitiesRaw } = crmColumnsAvailable && leadIds.length
  ? await db
      .from('contact_activities')
      .select('id, lead_id, type, subject, body, created_at')
      .in('lead_id', leadIds)
      .order('created_at', { ascending: false })
  : { data: [] as any[] };
const activities = activitiesRaw ?? [];
const activitiesByLead: Record<string, typeof activities> = {};
activities.forEach((a) => { (activitiesByLead[a.lead_id] ??= []).push(a); });

const allTags = [...new Set(leads.flatMap((l) => l.tags || []))].sort();

// The v4 pipeline migration (supabase-schema-v4-pipeline.sql) adds the
// deals table. Degrade gracefully like the CRM columns above if it hasn't
// been run yet, rather than breaking the whole page.
let dealsAvailable = true;
let { data: dealsRaw, error: dealsError } = leadIds.length
  ? await db.from('deals').select('id, lead_id, title, value, stage, probability, recurring, expected_close_date, closed_at, created_at').in('lead_id', leadIds).order('created_at', { ascending: false })
  : { data: [] as any[], error: null };
if (dealsError) { dealsAvailable = false; dealsRaw = []; }
const deals = dealsRaw ?? [];

const STAGE_ORDER = ['new_lead', 'qualified', 'proposal_sent', 'negotiation', 'closed_won', 'closed_lost'] as const;
const STAGE_LABELS: Record<string, string> = {
  new_lead: 'New Lead', qualified: 'Qualified', proposal_sent: 'Proposal Sent',
  negotiation: 'Negotiation', closed_won: 'Closed Won', closed_lost: 'Closed Lost',
};
const dealsByStage: Record<string, typeof deals> = {};
STAGE_ORDER.forEach((s) => (dealsByStage[s] = []));
deals.forEach((d) => { (dealsByStage[d.stage] ??= []).push(d); });

const openDeals = deals.filter((d) => d.stage !== 'closed_won' && d.stage !== 'closed_lost');
const openPipelineValue = openDeals.reduce((s, d) => s + Number(d.value || 0), 0);
const weightedForecast = openDeals.reduce((s, d) => s + Number(d.value || 0) * (Number(d.probability || 0) / 100), 0);
const mrr = deals.filter((d) => d.stage === 'closed_won' && d.recurring).reduce((s, d) => s + Number(d.value || 0), 0);
const now = new Date();
const dealsWonThisMonth = deals.filter((d) => d.stage === 'closed_won' && d.closed_at && new Date(d.closed_at).getMonth() === now.getMonth() && new Date(d.closed_at).getFullYear() === now.getFullYear());
const wonCount = deals.filter((d) => d.stage === 'closed_won').length;
const lostCount = deals.filter((d) => d.stage === 'closed_lost').length;
const closedCount = wonCount + lostCount;
const winRate = closedCount > 0 ? Math.round((wonCount / closedCount) * 100) : 0;
const avgDealSize = wonCount > 0 ? deals.filter((d) => d.stage === 'closed_won').reduce((s, d) => s + Number(d.value || 0), 0) / wonCount : 0;
function fmtMoney(n: number) {
  return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);
}

// Defaults to the largest range Search Console's API actually retains
// (~16 months, its own hard limit, not a choice made here) so the page
// opens showing full available history rather than an arbitrary 30 days.
// The range pills below can narrow this down.
const DEFAULT_DAYS = 480;
const [traffic, search, bing] = await Promise.all([fetchTrafficOverview(DEFAULT_DAYS), fetchSearchOverview(DEFAULT_DAYS), fetchBingOverview(DEFAULT_DAYS)]);
const bingClicksDelta = bing.available ? pctChange(bing.clicks, bing.prevClicks) : null;
const bingImpressionsDelta = bing.available ? pctChange(bing.impressions, bing.prevImpressions) : null;
const emailsSent = sequences.filter((s) => s.status === 'sent').length;
const emailsPending = sequences.filter((s) => s.status === 'pending').length;
const emailsFailed = sequences.filter((s) => s.status === 'failed').length;

const sessionsDelta = traffic.available ? pctChange(traffic.sessions, traffic.prevSessions) : null;
const usersDelta = traffic.available ? pctChange(traffic.users, traffic.prevUsers) : null;
const clicksDelta = search.available ? pctChange(search.clicks, search.prevClicks) : null;
const impressionsDelta = search.available ? pctChange(search.impressions, search.prevImpressions) : null;
const positionDelta = search.available ? (search.prevAvgPosition ? search.prevAvgPosition - search.avgPosition : null) : null;
const bounceDelta = traffic.available ? (traffic.bounceRate - traffic.prevBounceRate) * 100 : null; // pp change, lower is better
const engagementDelta = traffic.available ? pctChange(traffic.avgEngagementSec, traffic.prevAvgEngagementSec) : null;
// GA4's `newUsers` can exceed `users` in a given window (a known GA4 data
// quirk from how new-user attribution is computed), which would otherwise
// push this negative or over 100. Clamp both ends of the split.
const rawNewPct = traffic.available && traffic.users > 0 ? Math.round((traffic.newUsers / traffic.users) * 100) : 0;
const newPct = Math.max(0, Math.min(100, rawNewPct));
const returningPct = 100 - newPct;
const brandTotal = search.brandClicks + search.nonBrandClicks;
const brandPct = brandTotal > 0 ? Math.round((search.brandClicks / brandTotal) * 100) : 0;
function fmtDuration(sec: number) {
  const m = Math.floor(sec / 60);
  const s = Math.round(sec % 60);
  return `${m}:${String(s).padStart(2, '0')}`;
}
// Curated categorical palette (fixed order, never cycled by rank) for the leads-by-category breakdown.
const CATEGORY_PALETTE = ['#6C5CE7', '#22B07D', '#DB9B2E', '#E0554F', '#4FA3D1', '#8B7CF0', '#1E1B2E', '#C97BE0'];

const leadsById: Record<string, (typeof leads)[number]> = {};
leads.forEach((l) => (leadsById[l.id] = l));

// ── Group events and sequences per lead for the expandable detail row ──
const eventsByLead: Record<string, typeof events> = {};
events.forEach((e) => {
  (eventsByLead[e.lead_id] ??= []).push(e);
});
const sequencesByLead: Record<string, typeof sequences> = {};
sequences.forEach((s) => {
  (sequencesByLead[s.lead_id] ??= []).push(s);
});

// ── KPIs ──
const totalLeads = leads.length;
const avgScore = totalLeads ? Math.round(leads.reduce((sum, l) => sum + (l.score ?? 0), 0) / totalLeads) : 0;

const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
const newThisWeek = leads.filter((l) => new Date(l.created_at) >= sevenDaysAgo).length;

const hotLeads = leads.filter((l) => (l.score ?? 0) >= 50);
const auditRequests = events.filter((e) => e.event_type === 'audit_request').length;

const categoryCounts: Record<string, number> = {};
const categoryScores: Record<string, number[]> = {};
leads.forEach((l) => {
  const c = l.category || 'Unspecified';
  categoryCounts[c] = (categoryCounts[c] || 0) + 1;
  (categoryScores[c] ??= []).push(l.score ?? 0);
});
const topCategoryEntry = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1])[0];
const topCategory = topCategoryEntry ? topCategoryEntry[0] : 'None yet';
const categoryBreakdown = Object.entries(categoryCounts)
  .map(([cat, count]) => ({
    category: cat,
    count,
    avgScore: Math.round(categoryScores[cat].reduce((s, v) => s + v, 0) / categoryScores[cat].length),
  }))
  .sort((a, b) => b.count - a.count);

const categories = [...new Set(leads.map((l) => l.category).filter(Boolean))].sort();

// ── Funnel: event type breakdown (ordered by intent, matches lead-scoring.ts) ──
const EVENT_ORDER = ['newsletter_signup', 'guide_download', 'report_download', 'roi_calculator', 'audit_request'];
const EVENT_LABELS: Record<string, string> = {
  newsletter_signup: 'Newsletter signup',
  guide_download: 'Guide download',
  report_download: 'Report download',
  roi_calculator: 'ROI calculator',
  audit_request: 'Audit request',
};
const funnelCounts: Record<string, number> = {};
EVENT_ORDER.forEach((k) => (funnelCounts[k] = 0));
events.forEach((e) => {
  if (funnelCounts[e.event_type] !== undefined) funnelCounts[e.event_type]++;
});
const maxFunnelCount = Math.max(1, ...Object.values(funnelCounts));

function topN(items: (string | null | undefined)[], n: number) {
  const counts: Record<string, number> = {};
  items.forEach((v) => {
    const key = v || 'Direct / unknown';
    counts[key] = (counts[key] || 0) + 1;
  });
  return Object.entries(counts).sort((a, b) => b[1] - a[1]).slice(0, n);
}
const topSources = topN(events.map((e) => e.source), 6);
const maxSourceCount = Math.max(1, ...topSources.map(([, c]) => c));
const topProfessions = topN(leads.map((l) => l.profession_slug), 6);
const maxProfessionCount = Math.max(1, ...topProfessions.map(([, c]) => c));

// Real score distribution across all leads (no assumed dollar values, just the actual histogram).
const SCORE_BUCKETS = [
  { label: '0-9', min: 0, max: 9 },
  { label: '10-24', min: 10, max: 24 },
  { label: '25-49', min: 25, max: 49 },
  { label: '50-74', min: 50, max: 74 },
  { label: '75+', min: 75, max: Infinity },
];
const scoreDistribution = SCORE_BUCKETS.map((b) => ({
  label: b.label,
  count: leads.filter((l) => (l.score ?? 0) >= b.min && (l.score ?? 0) <= b.max).length,
}));
const maxScoreBucket = Math.max(1, ...scoreDistribution.map((b) => b.count));

// ── 30-day activity chart (events per day) ──
const DAYS = 30;
const dayBuckets: { date: string; label: string; count: number }[] = [];
for (let i = DAYS - 1; i >= 0; i--) {
  const d = new Date();
  d.setDate(d.getDate() - i);
  const key = d.toISOString().slice(0, 10);
  dayBuckets.push({ date: key, label: d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }), count: 0 });
}
const dayIndex: Record<string, number> = {};
dayBuckets.forEach((b, i) => (dayIndex[b.date] = i));
events.forEach((e) => {
  const key = new Date(e.created_at).toISOString().slice(0, 10);
  if (dayIndex[key] !== undefined) dayBuckets[dayIndex[key]].count++;
});

function fmtDate(d: string) {
  return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}
function fmtDateTime(d: string) {
  return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
}
function fmtDelta(v: number | null) {
  if (v === null) return null;
  const sign = v > 0 ? '+' : '';
  return `${sign}${v.toFixed(0)}%`;
}

const SEQUENCE_LABELS: Record<number, string> = { 0: 'J0', 2: 'J2', 5: 'J5' };

const hour = new Date().getUTCHours();
const greeting = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';

// Serialize small datasets for client-side JS (tab switching, granularity, email compose)
const clientData = {
  trafficDaily: traffic.daily,
  searchDaily: search.daily,
  leads: leads.map((l) => ({ id: l.id, email: l.email, company: l.company, score: l.score })),
  sequences: sequences.map((s) => ({ id: s.id, leadId: s.lead_id, step: s.step, status: s.status, sentAt: s.sent_at, scheduledAt: s.scheduled_at })),
};
---

<BaseLayout title="PURIST Intelligence | PURIST" description="Internal analytics and lead intelligence center." noindex>

<Fragment slot="head">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fira+Code:wght@400;500;600&family=Fraunces:opsz,wght@9..144,400;9..144,500&display=swap" rel="stylesheet" />
</Fragment>

<style>
  .pi {
    /* Reference: light-lavender SaaS dashboard, white cards, indigo accent,
       generous rounded corners, gradient bars, donut progress rings. */
    --bg: #F5F4FB;
    --bg-2: #ECEAF8;
    --surface: #FFFFFF;
    --surface-2: #FBFAFE;
    --border: #E8E6F5;
    --border-soft: #F0EEFA;
    --text-1: #1E1B2E;
    --text-2: #6F6C87;
    --text-3: #A5A2BE;
    --accent: #6C5CE7;
    --accent-2: #8B7CF0;
    --accent-deep: #5647C7;
    --accent-soft: #EDEBFB;
    --success: #22B07D;
    --success-bg: #E4F7EF;
    --danger: #E0554F;
    --danger-bg: #FBEAEA;
    --warning: #DB9B2E;
    --warning-bg: #FBF1DD;
    --shadow-sm: 0 1px 2px rgba(30,27,60,0.04);
    --shadow: 0 1px 2px rgba(30,27,60,0.03), 0 10px 24px -10px rgba(76,60,180,0.12);
    --shadow-lg: 0 4px 10px rgba(30,27,60,0.04), 0 20px 40px -16px rgba(76,60,180,0.18);
    --ring: 0 0 0 1px rgba(255,255,255,0.6) inset;
    --font-num: 'Fira Code', 'SF Mono', ui-monospace, monospace;
    max-width: 1520px;
    margin: 0 auto;
    display: flex;
    align-items: flex-start;
    background: var(--bg);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    color: var(--text-1);
  }
  .pi-main { flex: 1; min-width: 0; padding: 28px 28px 100px; }
  .pi * { box-sizing: border-box; }
  .pi svg { display: block; }
  .pi .icon { width: 15px; height: 15px; flex-shrink: 0; }
  .pi button, .pi input, .pi select, .pi textarea { font-family: inherit; }
  .pi-panel-view.active .pi-kpi,
  .pi-panel-view.active .pi-panel,
  .pi-panel-view.active .pi-hero,
  .pi-panel-view.active .pi-chart { animation: pi-rise 0.55s cubic-bezier(0.22,1,0.36,1) both; }
  .pi-panel-view.active .pi-kpi:nth-child(1) { animation-delay: 0.02s; }
  .pi-panel-view.active .pi-kpi:nth-child(2) { animation-delay: 0.05s; }
  .pi-panel-view.active .pi-kpi:nth-child(3) { animation-delay: 0.08s; }
  .pi-panel-view.active .pi-kpi:nth-child(4) { animation-delay: 0.11s; }
  .pi-panel-view.active .pi-kpi:nth-child(5) { animation-delay: 0.14s; }
  .pi-panel-view.active .pi-kpi:nth-child(6) { animation-delay: 0.17s; }
  .pi-panel-view.active .pi-panel:nth-child(2) { animation-delay: 0.06s; }
  .pi-panel-view.active .pi-panel:nth-child(3) { animation-delay: 0.12s; }

  @keyframes pi-rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) {
    .pi-panel-view.active .pi-kpi, .pi-panel-view.active .pi-panel, .pi-panel-view.active .pi-hero, .pi-panel-view.active .pi-chart { animation: none; }
  }

  .pi-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 8px; }
  .pi-h1 { font-family: 'Fraunces', 'Inter', serif; font-size: 26px; font-weight: 500; color: var(--text-1); margin: 0; letter-spacing: -0.01em; }
  .pi-sub { color: var(--text-2); font-size: 13.5px; margin: 4px 0 0; }
  .pi-demo-link { font-size: 12px; font-weight: 500; color: var(--accent); text-decoration: none; border: 1px solid var(--border); border-radius: 12px; padding: 8px 14px; white-space: nowrap; background: var(--surface); transition: all 0.25s cubic-bezier(0.22,1,0.36,1); display: inline-flex; align-items: center; gap: 6px; justify-content: center; }
  .pi-demo-link:hover { background: var(--accent-soft); }

  /* Sidebar */
  .pi-sidebar { width: 216px; flex-shrink: 0; min-height: 100vh; background: var(--surface); border-right: 1px solid var(--border-soft); padding: 24px 16px; display: flex; flex-direction: column; position: sticky; top: 0; }
  .pi-sidebar-brand { padding: 0 8px; margin-bottom: 28px; opacity: 0.9; }
  .pi-sidebar-nav { display: flex; flex-direction: column; gap: 3px; }
  .pi-sidebar-foot { margin-top: auto; padding-top: 20px; display: flex; flex-direction: column; gap: 10px; }
  @media (max-width: 900px) {
    .pi { flex-direction: column; }
    .pi-sidebar { width: 100%; min-height: auto; position: static; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 10px; padding: 14px 16px; }
    .pi-sidebar-brand { margin-bottom: 0; }
    .pi-sidebar-nav { flex-direction: row; flex-wrap: wrap; }
    .pi-sidebar-foot { margin-top: 0; flex-direction: row; margin-left: auto; }
    .pi-main { padding: 20px 16px 80px; }
  }

  /* Realtime widget */
  .pi-live { display: inline-flex; align-items: center; gap: 8px; background: var(--bg-2); border-radius: 20px; padding: 7px 14px 7px 10px; font-size: 12px; font-weight: 600; color: var(--text-1); }
  .pi-live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); position: relative; }
  .pi-live-dot::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; background: var(--success); opacity: 0.35; animation: pi-pulse 1.8s cubic-bezier(0.4,0,0.6,1) infinite; }
  @keyframes pi-pulse { 0% { transform: scale(0.6); opacity: 0.5; } 70%, 100% { transform: scale(1.8); opacity: 0; } }
  .pi-live span.n { font-family: var(--font-num); color: var(--accent-deep); }

  /* Sidebar tab navigation */
  .pi-tab { border: none; background: transparent; font-size: 13.5px; font-weight: 500; color: var(--text-2); padding: 10px 14px; border-radius: 10px; cursor: pointer; font-family: inherit; white-space: nowrap; display: flex; align-items: center; gap: 10px; transition: all 0.2s cubic-bezier(0.22,1,0.36,1); text-align: left; width: 100%; }
  .pi-tab.active { background: var(--accent-soft); color: var(--accent-deep); font-weight: 600; }
  .pi-tab.active .icon { color: var(--accent); }
  .pi-tab:not(.active):hover { background: var(--bg-2); color: var(--text-1); }
  .pi-tab:active { transform: scale(0.98); }
  .pi-panel-view { display: none; margin-top: 20px; }
  .pi-panel-view.active { display: block; }

  .pi-section-h { font-family: 'Fraunces', 'Inter', serif; font-size: 17px; font-weight: 500; color: var(--text-1); margin: 28px 0 4px; letter-spacing: -0.005em; }
  .pi-section-sub { font-size: 11px; color: var(--text-3); font-weight: 400; }
  .pi-notice { margin-top: 14px; padding: 12px 16px; border: 1px solid var(--warning-bg); border-radius: 12px; font-size: 12.5px; color: var(--text-2); background: var(--warning-bg); }
  .pi-ring-row { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 14px; }
  .pi-ring-card { display: flex; align-items: center; gap: 20px; flex: 0 0 320px; }
  .pi-ring-wrap { position: relative; width: 120px; height: 120px; flex-shrink: 0; }
  .pi-ring-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .pi-ring-num { font-family: var(--font-num); font-size: 22px; font-weight: 700; color: var(--text-1); }
  .pi-ring-label { font-size: 10.5px; color: var(--text-3); margin-top: 2px; }
  .pi-ring-side-h { font-size: 11px; font-weight: 600; color: var(--text-2); margin: 0 0 8px; }
  .pi-ring-side-stat { font-size: 12.5px; color: var(--text-1); margin: 0 0 6px; display: flex; align-items: center; gap: 8px; font-family: var(--font-num); }
  .pi-ring-side-stat .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .pi-ring-side-stat .dot.won { background: var(--success); }
  .pi-ring-side-stat .dot.lost { background: var(--danger); }
  .pi-pipeline-board { display: grid; grid-template-columns: repeat(6, minmax(180px, 1fr)); gap: 12px; margin-top: 18px; overflow-x: auto; }
  @media (max-width: 1100px) { .pi-pipeline-board { grid-template-columns: repeat(3, minmax(200px, 1fr)); } }
  @media (max-width: 640px) { .pi-pipeline-board { grid-template-columns: 1fr; } }
  .pi-pipeline-col { background: var(--bg-2); border-radius: 14px; padding: 12px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .pi-pipeline-col-head { display: flex; justify-content: space-between; align-items: center; font-size: 12px; font-weight: 600; color: var(--text-1); }
  .pi-pipeline-count { background: var(--surface); border-radius: 20px; padding: 1px 8px; font-size: 11px; color: var(--text-2); }
  .pi-pipeline-col-total { font-family: var(--font-num); font-size: 12px; color: var(--text-3); margin-top: -4px; }
  .pi-pipeline-cards { display: flex; flex-direction: column; gap: 8px; }
  .pi-deal-card { background: var(--surface); border-radius: 12px; padding: 10px 12px; box-shadow: var(--shadow-sm); border: 1px solid var(--border-soft); }
  .pi-deal-title { font-size: 12px; font-weight: 600; color: var(--text-1); margin: 0 0 4px; }
