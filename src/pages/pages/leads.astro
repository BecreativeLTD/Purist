    </div>

    <div class="pi-panel" style="margin-top:12px;">
      <h3>Position distribution <span id="queries-tracked-label" style="color:var(--text-3);font-weight:400;">{search.available && `(${search.queriesTracked} queries tracked)`}</span></h3>
      <div id="panel-position-buckets">
      {!search.available || search.positionBuckets.length === 0 ? <p class="pi-empty-panel">Not connected.</p> : (
