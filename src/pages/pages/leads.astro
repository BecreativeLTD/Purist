---
export const prerender = false;
import BaseLayout from '~/layouts/BaseLayout.astro';
import { createSupabaseAdminClient } from '~/lib/supabase-admin';
import { fetchTrafficOverview, fetchSearchOverview, pctChange } from '~/lib/site-metrics';

// This route is gated by src/middleware.ts (PROTECTED_ROUTES), a visitor
// only reaches this code after a valid Supabase Auth session was
// confirmed. Using the service-role client here is safe because of that
// gate, it is never exposed to the browser.
const db = createSupabaseAdminClient();

const { data: leadsRaw, error } = await db
  .from('leads')
  .select('id, email, name, company, category, profession_slug, source, page, status, score, touch_count, created_at, last_seen_at')
  .order('score', { ascending: false });

const leads = leadsRaw ?? [];
const leadIds = leads.map((l) => l.id);

const { data: eventsRaw } = leadIds.length
  ? await db
      .from('lead_events')
      .select('id, lead_id, event_type, source, page, metadata, points, created_at')
      .in('lead_id', leadIds)
      .order('created_at', { ascending: false })
  : { data: [] as any[] };
const events = eventsRaw ?? [];

const { data: sequencesRaw } = leadIds.length
  ? await db
      .from('email_sequences')
      .select('id, lead_id, step, scheduled_at, sent_at, status')
      .in('lead_id', leadIds)
      .order('step', { ascending: true })
  : { data: [] as any[] };
const sequences = sequencesRaw ?? [];

const [traffic, search] = await Promise.all([fetchTrafficOverview(30), fetchSearchOverview(30)]);
const emailsSent = sequences.filter((s) => s.status === 'sent').length;
const emailsPending = sequences.filter((s) => s.status === 'pending').length;
const emailsFailed = sequences.filter((s) => s.status === 'failed').length;

const sessionsDelta = traffic.available ? pctChange(traffic.sessions, traffic.prevSessions) : null;
const usersDelta = traffic.available ? pctChange(traffic.users, traffic.prevUsers) : null;
const clicksDelta = search.available ? pctChange(search.clicks, search.prevClicks) : null;
const impressionsDelta = search.available ? pctChange(search.impressions, search.prevImpressions) : null;
const positionDelta = search.available ? (search.prevAvgPosition ? search.prevAvgPosition - search.avgPosition : null) : null; // lower position = better, so invert

// ── Group events and sequences per lead for the expandable detail row ──
const eventsByLead: Record<string, typeof events> = {};
events.forEach((e) => {
  (eventsByLead[e.lead_id] ??= []).push(e);
});
const sequencesByLead: Record<string, typeof sequences> = {};
sequences.forEach((s) => {
  (sequencesByLead[s.lead_id] ??= []).push(s);
});

// ── KPIs ──
const totalLeads = leads.length;
const avgScore = totalLeads ? Math.round(leads.reduce((sum, l) => sum + (l.score ?? 0), 0) / totalLeads) : 0;

const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
const newThisWeek = leads.filter((l) => new Date(l.created_at) >= sevenDaysAgo).length;

const hotLeads = leads.filter((l) => (l.score ?? 0) >= 50);
const auditRequests = events.filter((e) => e.event_type === 'audit_request').length;

const categoryCounts: Record<string, number> = {};
const categoryScores: Record<string, number[]> = {};
leads.forEach((l) => {
  const c = l.category || 'Unspecified';
  categoryCounts[c] = (categoryCounts[c] || 0) + 1;
  (categoryScores[c] ??= []).push(l.score ?? 0);
});
const topCategoryEntry = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1])[0];
const topCategory = topCategoryEntry ? topCategoryEntry[0] : 'None yet';
const categoryBreakdown = Object.entries(categoryCounts)
  .map(([cat, count]) => ({
    category: cat,
    count,
    avgScore: Math.round(categoryScores[cat].reduce((s, v) => s + v, 0) / categoryScores[cat].length),
  }))
  .sort((a, b) => b.count - a.count);

const categories = [...new Set(leads.map((l) => l.category).filter(Boolean))].sort();

// ── Funnel: event type breakdown (ordered by intent, matches lead-scoring.ts) ──
const EVENT_ORDER = ['newsletter_signup', 'guide_download', 'report_download', 'roi_calculator', 'audit_request'];
const EVENT_LABELS: Record<string, string> = {
  newsletter_signup: 'Newsletter signup',
  guide_download: 'Guide download',
  report_download: 'Report download',
  roi_calculator: 'ROI calculator',
  audit_request: 'Audit request',
};
const funnelCounts: Record<string, number> = {};
EVENT_ORDER.forEach((k) => (funnelCounts[k] = 0));
events.forEach((e) => {
  if (funnelCounts[e.event_type] !== undefined) funnelCounts[e.event_type]++;
});
const maxFunnelCount = Math.max(1, ...Object.values(funnelCounts));

// ── Top sources & pages ──
function topN(items: (string | null | undefined)[], n: number) {
  const counts: Record<string, number> = {};
  items.forEach((v) => {
    const key = v || 'Direct / unknown';
    counts[key] = (counts[key] || 0) + 1;
  });
  return Object.entries(counts).sort((a, b) => b[1] - a[1]).slice(0, n);
}
const topSources = topN(events.map((e) => e.source), 6);
const maxSourceCount = Math.max(1, ...topSources.map(([, c]) => c));

const topProfessions = topN(leads.map((l) => l.profession_slug), 6);
const maxProfessionCount = Math.max(1, ...topProfessions.map(([, c]) => c));

// ── 30-day activity chart (events per day) ──
const DAYS = 30;
const dayBuckets: { date: string; label: string; count: number }[] = [];
for (let i = DAYS - 1; i >= 0; i--) {
  const d = new Date();
  d.setDate(d.getDate() - i);
  const key = d.toISOString().slice(0, 10);
  dayBuckets.push({ date: key, label: d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }), count: 0 });
}
const dayIndex: Record<string, number> = {};
dayBuckets.forEach((b, i) => (dayIndex[b.date] = i));
events.forEach((e) => {
  const key = new Date(e.created_at).toISOString().slice(0, 10);
  if (dayIndex[key] !== undefined) dayBuckets[dayIndex[key]].count++;
});
const maxDayCount = Math.max(1, ...dayBuckets.map((b) => b.count));

const maxSessionsDay = Math.max(1, ...traffic.daily.map((d) => d.sessions));
const maxClicksDay = Math.max(1, ...search.daily.map((d) => d.clicks));

function fmtDate(d: string) {
  return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}
function fmtDateTime(d: string) {
  return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
}
function fmtDelta(v: number | null) {
  if (v === null) return null;
  const sign = v > 0 ? '+' : '';
  return `${sign}${v.toFixed(0)}%`;
}

const SEQUENCE_LABELS: Record<number, string> = { 0: 'J0', 2: 'J2', 5: 'J5' };
---

<BaseLayout title="Command Center | PURIST" description="Internal analytics and lead intelligence dashboard." noindex>

<style>
  .cc-wrap {
    --bg: #F8F9FA;
    --surface: #FFFFFF;
    --border: #DADCE0;
    --border-light: #E8EAED;
    --text-1: #202124;
    --text-2: #5F6368;
    --text-3: #80868B;
    --accent: #1A73E8;
    --accent-bg: #E8F0FE;
    --accent-2: #669DF6;
    --success: #188038;
    --success-bg: #E6F4EA;
    --danger: #D93025;
    --danger-bg: #FCE8E6;
    --warning: #E37400;
    --warning-bg: #FEF7E0;
    max-width: 1240px;
    margin: 0 auto;
    padding: 32px 24px 100px;
    background: var(--bg);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    color: var(--text-1);
  }
  .cc-h1 { font-size: 22px; font-weight: 500; color: var(--text-1); margin: 0; letter-spacing: -0.01em; }
  .cc-sub { color: var(--text-2); font-size: 13px; margin: 4px 0 0; }
  .cc-demo-link { font-size: 12.5px; font-weight: 500; color: var(--accent); text-decoration: none; border: 1px solid var(--border); border-radius: 6px; padding: 7px 14px; white-space: nowrap; background: var(--surface); }
  .cc-demo-link:hover { background: var(--accent-bg); border-color: var(--accent); }

  .cc-section-h { font-size: 15px; font-weight: 500; color: var(--text-1); margin: 36px 0 4px; display: flex; align-items: baseline; gap: 8px; }
  .cc-section-sub { font-size: 11px; color: var(--text-3); font-weight: 400; }

  .cc-notice { margin-top: 14px; padding: 12px 16px; border: 1px solid var(--warning-bg); border-radius: 8px; font-size: 12.5px; color: var(--text-2); background: var(--warning-bg); }
  .cc-notice code { background: rgba(0,0,0,0.06); padding: 1px 6px; border-radius: 4px; font-size: 11.5px; color: var(--text-1); }

  .cc-kpis { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; margin-top: 12px; }
  @media (max-width: 900px) { .cc-kpis { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 500px) { .cc-kpis { grid-template-columns: repeat(2, 1fr); } }
  .cc-kpi { background: var(--surface); border: 1px solid var(--border-light); border-radius: 8px; padding: 14px 16px; }
  .cc-kpi .num { font-size: 24px; font-weight: 500; color: var(--text-1); font-variant-numeric: tabular-nums; line-height: 1.1; }
  .cc-kpi .label { font-size: 11px; color: var(--text-2); margin-top: 5px; }
  .cc-delta { font-size: 11px; font-weight: 500; margin-top: 4px; display: inline-flex; align-items: center; gap: 2px; }
  .cc-delta.up { color: var(--success); }
  .cc-delta.down { color: var(--danger); }
  .cc-delta.flat { color: var(--text-3); }

  .cc-panels { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin-top: 16px; }
  @media (max-width: 900px) { .cc-panels { grid-template-columns: 1fr; } }
  .cc-panel { border: 1px solid var(--border-light); border-radius: 8px; padding: 16px 18px; background: var(--surface); }
  .cc-panel h3 { font-size: 12px; font-weight: 500; color: var(--text-2); margin: 0 0 12px; text-transform: none; }
  .cc-bar-row { display: flex; align-items: center; gap: 8px; margin-bottom: 9px; font-size: 12.5px; }
  .cc-bar-row .lbl { flex: 0 0 130px; color: var(--text-1); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cc-bar-row .track { flex: 1; height: 6px; border-radius: 3px; background: var(--border-light); overflow: hidden; }
  .cc-bar-row .fill { height: 100%; border-radius: 3px; background: var(--accent); }
  .cc-bar-row .fill.alt { background: var(--accent-2); }
  .cc-bar-row .val { flex: 0 0 30px; text-align: right; font-variant-numeric: tabular-nums; color: var(--text-2); font-size: 11.5px; }
  .cc-empty-panel { color: var(--text-3); font-size: 12.5px; }

  .cc-sparkline { display: flex; align-items: flex-end; gap: 2px; height: 56px; margin-top: 4px; }
  .cc-sparkline .bar { flex: 1; min-width: 2px; background: var(--accent); border-radius: 1px 1px 0 0; opacity: 0.85; }
  .cc-sparkline .bar[data-zero="1"] { background: var(--border-light); }

  .cc-chart { margin-top: 16px; border: 1px solid var(--border-light); border-radius: 8px; padding: 18px 18px 12px; background: var(--surface); }
  .cc-chart h3 { font-size: 12px; font-weight: 500; color: var(--text-2); margin: 0 0 14px; }
  .cc-chart-bars { display: flex; align-items: flex-end; gap: 3px; height: 84px; overflow-x: auto; padding-bottom: 4px; }
  .cc-chart-bar { flex: 1 0 8px; min-width: 8px; background: var(--accent); border-radius: 2px 2px 0 0; opacity: 0.85; }
  .cc-chart-bar:hover { opacity: 1; }
  .cc-chart-bar[data-count="0"] { background: var(--border-light); }
  .cc-chart-labels { display: flex; justify-content: space-between; font-size: 10.5px; color: var(--text-3); margin-top: 6px; }

  .cc-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 28px 0 12px; }
  .cc-controls input, .cc-controls select { font-size: 13px; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border); background: var(--surface); color: var(--text-1); font-family: inherit; }
  .cc-controls input:focus, .cc-controls select:focus { outline: 2px solid var(--accent-bg); border-color: var(--accent); }
  .cc-controls input { flex: 1; min-width: 200px; }
  .cc-controls label.chk { display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-2); white-space: nowrap; }
  .cc-export { font-size: 12.5px; font-weight: 500; color: var(--accent); text-decoration: none; border: 1px solid var(--border); border-radius: 6px; padding: 8px 14px; white-space: nowrap; background: var(--surface); cursor: pointer; font-family: inherit; }
  .cc-export:hover { background: var(--accent-bg); border-color: var(--accent); }

  .cc-table-scroll { overflow-x: auto; border: 1px solid var(--border-light); border-radius: 8px; }
  table.cc-table { width: 100%; border-collapse: collapse; font-size: 13px; white-space: nowrap; }
  table.cc-table th { text-align: left; font-size: 11px; font-weight: 500; color: var(--text-2); padding: 10px 14px; border-bottom: 1px solid var(--border); background: #FAFAFA; cursor: pointer; user-select: none; }
  table.cc-table th:hover { color: var(--accent); }
  table.cc-table td { padding: 10px 14px; border-bottom: 1px solid var(--border-light); font-variant-numeric: tabular-nums; color: var(--text-1); }
  table.cc-table tbody tr.cc-row { cursor: pointer; }
  table.cc-table tbody tr.cc-row:hover { background: var(--accent-bg); }
  .cc-score { font-weight: 600; color: var(--accent); }
  .cc-status { font-size: 10.5px; font-weight: 500; padding: 2px 8px; border-radius: 10px; text-transform: capitalize; }
  .cc-status.active { background: var(--success-bg); color: var(--success); }
  .cc-status.converted { background: var(--accent-bg); color: var(--accent); }
  .cc-status.unsubscribed { background: var(--border-light); color: var(--text-3); }
  .cc-hot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--danger); margin-right: 6px; vertical-align: middle; }
  .cc-caret { display: inline-block; transition: transform 0.15s; color: var(--text-3); margin-right: 8px; font-size: 10px; }
  tr.cc-row.open .cc-caret { transform: rotate(90deg); }

  .cc-detail-cell { background: #FAFBFC; padding: 0 !important; }
  .cc-detail-inner { padding: 16px 24px; display: none; white-space: normal; }
  tr.cc-detail.open .cc-detail-inner { display: block; }
  .cc-detail-grid { display: grid; grid-template-columns: 1fr 200px; gap: 24px; }
  @media (max-width: 700px) { .cc-detail-grid { grid-template-columns: 1fr; } }
  .cc-timeline { list-style: none; margin: 0; padding: 0; }
  .cc-timeline li { display: flex; gap: 10px; padding: 7px 0; border-bottom: 1px solid var(--border-light); font-size: 12.5px; }
  .cc-timeline li:last-child { border-bottom: none; }
  .cc-timeline .ev-type { font-weight: 500; color: var(--text-1); flex: 0 0 150px; }
  .cc-timeline .ev-meta { color: var(--text-3); flex: 1; }
  .cc-timeline .ev-pts { color: var(--accent); font-variant-numeric: tabular-nums; flex: 0 0 40px; text-align: right; }
  .cc-seq { list-style: none; margin: 0; padding: 0; }
  .cc-seq li { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; font-size: 12px; }
  .cc-seq-badge { font-size: 10px; font-weight: 500; text-transform: capitalize; padding: 2px 8px; border-radius: 10px; }
  .cc-seq-badge.sent { background: var(--success-bg); color: var(--success); }
  .cc-seq-badge.pending { background: var(--border-light); color: var(--text-2); }
  .cc-seq-badge.failed { background: var(--danger-bg); color: var(--danger); }
  .cc-seq-badge.skipped { background: var(--border-light); color: var(--text-3); }
  .cc-detail-h { font-size: 11px; font-weight: 500; color: var(--text-2); margin: 0 0 8px; }

  .cc-empty { text-align: center; padding: 60px 20px; color: var(--text-2); border: 1px dashed var(--border); border-radius: 8px; margin-top: 24px; background: var(--surface); }
  .cc-empty h2 { font-size: 16px; font-weight: 500; color: var(--text-1); margin: 0 0 8px; }
</style>

<div class="cc-wrap">
  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;">
    <div>
      <h1 class="cc-h1">Command Center</h1>
      <p class="cc-sub">Traffic, search performance, email delivery, and lead intelligence, one page. Internal use only.</p>
    </div>
    <a href="/pages/dashboard" class="cc-demo-link">View client demo →</a>
  </div>

  <h2 class="cc-section-h">Site Overview <span class="cc-section-sub">last 30 days vs. previous 30 days</span></h2>

  <div class="cc-kpis">
    <div class="cc-kpi">
      <div class="num">{traffic.available ? traffic.sessions.toLocaleString() : '—'}</div>
      <div class="label">Sessions (GA4)</div>
      {sessionsDelta !== null && <div class={`cc-delta ${sessionsDelta > 0 ? 'up' : sessionsDelta < 0 ? 'down' : 'flat'}`}>{sessionsDelta > 0 ? '▲' : sessionsDelta < 0 ? '▼' : '–'} {fmtDelta(sessionsDelta)}</div>}
    </div>
    <div class="cc-kpi">
      <div class="num">{traffic.available ? traffic.users.toLocaleString() : '—'}</div>
      <div class="label">Users (GA4)</div>
      {usersDelta !== null && <div class={`cc-delta ${usersDelta > 0 ? 'up' : usersDelta < 0 ? 'down' : 'flat'}`}>{usersDelta > 0 ? '▲' : usersDelta < 0 ? '▼' : '–'} {fmtDelta(usersDelta)}</div>}
    </div>
    <div class="cc-kpi">
      <div class="num">{search.available ? search.clicks.toLocaleString() : '—'}</div>
      <div class="label">Search clicks</div>
      {clicksDelta !== null && <div class={`cc-delta ${clicksDelta > 0 ? 'up' : clicksDelta < 0 ? 'down' : 'flat'}`}>{clicksDelta > 0 ? '▲' : clicksDelta < 0 ? '▼' : '–'} {fmtDelta(clicksDelta)}</div>}
    </div>
    <div class="cc-kpi">
      <div class="num">{search.available ? search.impressions.toLocaleString() : '—'}</div>
      <div class="label">Impressions</div>
      {impressionsDelta !== null && <div class={`cc-delta ${impressionsDelta > 0 ? 'up' : impressionsDelta < 0 ? 'down' : 'flat'}`}>{impressionsDelta > 0 ? '▲' : impressionsDelta < 0 ? '▼' : '–'} {fmtDelta(impressionsDelta)}</div>}
    </div>
    <div class="cc-kpi">
      <div class="num">{search.available ? search.avgPosition.toFixed(1) : '—'}</div>
      <div class="label">Avg. position</div>
      {positionDelta !== null && <div class={`cc-delta ${positionDelta > 0 ? 'up' : positionDelta < 0 ? 'down' : 'flat'}`}>{positionDelta > 0 ? '▲' : positionDelta < 0 ? '▼' : '–'} {Math.abs(positionDelta).toFixed(1)}</div>}
    </div>
    <div class="cc-kpi">
      <div class="num">{emailsSent}</div>
      <div class="label">Nurture emails sent</div>
    </div>
  </div>

  {!traffic.available && !search.available && (
    <div class="cc-notice">
      <strong>Traffic and Search Console data not connected yet.</strong> Set the <code>GOOGLE_SERVICE_ACCOUNT_JSON</code> environment variable in Vercel, then redeploy. Lead intelligence below is unaffected, it runs on Supabase alone.
    </div>
  )}

  <div class="cc-panels">
    <div class="cc-panel">
      <h3>Sessions, last 30 days</h3>
      {!traffic.available ? <p class="cc-empty-panel">Not connected.</p> : (
        <div class="cc-sparkline">
          {traffic.daily.map((d) => (
            <div class="bar" data-zero={d.sessions === 0 ? '1' : '0'} title={`${d.date}: ${d.sessions}`} style={`height:${Math.max(2, (d.sessions / maxSessionsDay) * 56)}px`}></div>
          ))}
        </div>
      )}
    </div>
    <div class="cc-panel">
      <h3>Search clicks, last 30 days</h3>
      {!search.available ? <p class="cc-empty-panel">Not connected.</p> : (
        <div class="cc-sparkline">
          {search.daily.map((d) => (
            <div class="bar" data-zero={d.clicks === 0 ? '1' : '0'} title={`${d.date}: ${d.clicks}`} style={`height:${Math.max(2, (d.clicks / maxClicksDay) * 56)}px`}></div>
          ))}
        </div>
      )}
    </div>
    <div class="cc-panel" style="display:flex;flex-direction:column;justify-content:center;">
      <h3 style="margin-bottom:10px;">Nurture email delivery</h3>
      <div style="display:flex;flex-direction:column;gap:8px;">
        <div style="display:flex;justify-content:space-between;font-size:12.5px;"><span style="color:var(--text-2);">Sent</span><strong style="color:var(--success);">{emailsSent}</strong></div>
        <div style="display:flex;justify-content:space-between;font-size:12.5px;"><span style="color:var(--text-2);">Pending</span><strong style="color:var(--text-2);">{emailsPending}</strong></div>
        <div style="display:flex;justify-content:space-between;font-size:12.5px;"><span style="color:var(--text-2);">Failed</span><strong style="color:var(--danger);">{emailsFailed}</strong></div>
      </div>
    </div>
  </div>

  <div class="cc-panels">
    <div class="cc-panel">
      <h3>Traffic by channel (GA4)</h3>
      {!traffic.available ? <p class="cc-empty-panel">Not connected.</p> : traffic.channels.length === 0 ? <p class="cc-empty-panel">No sessions in this window.</p> : (() => {
        const maxCh = Math.max(1, ...traffic.channels.map((c) => c.sessions));
        return traffic.channels.map((c) => (
          <div class="cc-bar-row">
            <span class="lbl">{c.channel}</span>
            <span class="track"><span class="fill" style={`width:${(c.sessions / maxCh) * 100}%`}></span></span>
            <span class="val">{c.sessions}</span>
          </div>
        ));
      })()}
    </div>
    <div class="cc-panel">
      <h3>Top pages by sessions (GA4)</h3>
      {!traffic.available ? <p class="cc-empty-panel">Not connected.</p> : traffic.topPages.length === 0 ? <p class="cc-empty-panel">No sessions in this window.</p> : (() => {
        const maxP = Math.max(1, ...traffic.topPages.map((p) => p.sessions));
        return traffic.topPages.map((p) => (
          <div class="cc-bar-row">
            <span class="lbl" title={p.page}>{p.page}</span>
            <span class="track"><span class="fill alt" style={`width:${(p.sessions / maxP) * 100}%`}></span></span>
            <span class="val">{p.sessions}</span>
          </div>
        ));
      })()}
    </div>
    <div class="cc-panel">
      <h3>Top search queries (GSC)</h3>
      {!search.available ? <p class="cc-empty-panel">Not connected.</p> : search.topQueries.length === 0 ? <p class="cc-empty-panel">No queries in this window.</p> : (
        <ul class="cc-timeline" style="margin-top:-4px;">
          {search.topQueries.map((q) => (
            <li>
              <span class="ev-type" style="flex:1;">{q.query}</span>
              <span class="ev-meta" style="flex:0 0 auto;">pos {q.position.toFixed(1)}</span>
              <span class="ev-pts">{q.clicks}c</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <h2 class="cc-section-h">Lead Intelligence</h2>

  <div class="cc-kpis">
    <div class="cc-kpi"><div class="num">{totalLeads}</div><div class="label">Total leads</div></div>
    <div class="cc-kpi"><div class="num">{avgScore}</div><div class="label">Avg. score</div></div>
    <div class="cc-kpi"><div class="num">{newThisWeek}</div><div class="label">New this week</div></div>
    <div class="cc-kpi"><div class="num">{hotLeads.length}</div><div class="label">Hot leads (50+)</div></div>
    <div class="cc-kpi"><div class="num">{auditRequests}</div><div class="label">Audit requests</div></div>
    <div class="cc-kpi"><div class="num" style="font-size:16px;">{topCategory}</div><div class="label">Top category</div></div>
  </div>

  {error && <p style="color:var(--danger);margin-top:20px;">Could not load leads: {error.message}</p>}

  {totalLeads === 0 ? (
    <div class="cc-empty">
      <h2>No leads recorded yet</h2>
      <p>Once someone downloads a guide, uses the ROI calculator, requests an audit, or downloads the State of Automation report, they will appear here automatically.</p>
    </div>
  ) : (
    <>
      <div class="cc-panels">
        <div class="cc-panel">
          <h3>Funnel by action</h3>
          {EVENT_ORDER.map((k) => (
            <div class="cc-bar-row">
              <span class="lbl">{EVENT_LABELS[k]}</span>
              <span class="track"><span class="fill" style={`width:${(funnelCounts[k] / maxFunnelCount) * 100}%`}></span></span>
              <span class="val">{funnelCounts[k]}</span>
            </div>
          ))}
        </div>
        <div class="cc-panel">
          <h3>Top sources</h3>
          {topSources.length === 0 ? <p class="cc-empty-panel">No event data yet.</p> : topSources.map(([src, c]) => (
            <div class="cc-bar-row">
              <span class="lbl">{src}</span>
              <span class="track"><span class="fill alt" style={`width:${(c / maxSourceCount) * 100}%`}></span></span>
              <span class="val">{c}</span>
            </div>
          ))}
        </div>
        <div class="cc-panel">
          <h3>Top profession pages</h3>
          {topProfessions.length === 0 ? <p class="cc-empty-panel">No profession data yet.</p> : topProfessions.map(([prof, c]) => (
            <div class="cc-bar-row">
              <span class="lbl">{prof}</span>
              <span class="track"><span class="fill" style={`width:${(c / maxProfessionCount) * 100}%`}></span></span>
              <span class="val">{c}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="cc-panel" style="margin-top:16px;">
        <h3>Leads by category</h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;">
          {categoryBreakdown.map((c) => (
            <div style="border:1px solid var(--border-light);border-radius:6px;padding:10px 12px;">
              <div style="font-size:12px;color:var(--text-2);margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{c.category}</div>
              <div style="display:flex;align-items:baseline;gap:8px;">
                <span style="font-size:18px;font-weight:500;color:var(--text-1);">{c.count}</span>
                <span style="font-size:11px;color:var(--text-3);">avg score {c.avgScore}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="cc-chart">
        <h3>Activity, last 30 days ({events.length} total events)</h3>
        <div class="cc-chart-bars">
          {dayBuckets.map((b) => (
            <div class="cc-chart-bar" data-count={b.count} title={`${b.label}: ${b.count}`} style={`height:${Math.max(3, (b.count / maxDayCount) * 84)}px`}></div>
          ))}
        </div>
        <div class="cc-chart-labels">
          <span>{dayBuckets[0].label}</span>
          <span>{dayBuckets[Math.floor(dayBuckets.length / 2)].label}</span>
          <span>{dayBuckets[dayBuckets.length - 1].label}</span>
        </div>
      </div>

      <div class="cc-controls">
        <input id="cc-search" type="text" placeholder="Search email, name, or company..." />
        <select id="cc-filter-cat">
          <option value="">All categories</option>
          {categories.map((c) => <option value={c as string}>{c}</option>)}
        </select>
        <select id="cc-filter-status">
          <option value="">All statuses</option>
          <option value="active">Active</option>
          <option value="converted">Converted</option>
          <option value="unsubscribed">Unsubscribed</option>
        </select>
        <label class="chk"><input type="checkbox" id="cc-filter-hot" /> Hot leads only</label>
        <button class="cc-export" id="cc-export">Export CSV ↓</button>
      </div>

      <div class="cc-table-scroll">
        <table class="cc-table" id="cc-table">
          <thead>
            <tr>
              <th></th>
              <th data-sort="email">Email</th>
              <th data-sort="company">Company</th>
              <th data-sort="category">Category</th>
              <th data-sort="score">Score</th>
              <th data-sort="touch_count">Touches</th>
              <th data-sort="status">Status</th>
              <th data-sort="last_seen_at">Last seen</th>
            </tr>
          </thead>
          <tbody>
            {leads.map((l) => {
              const leadEvents = eventsByLead[l.id] ?? [];
              const leadSeqs = sequencesByLead[l.id] ?? [];
              const isHot = (l.score ?? 0) >= 50;
              return (
                <>
                  <tr class="cc-row" data-lead-id={l.id} data-email={l.email.toLowerCase()} data-name={(l.name || '').toLowerCase()} data-company={(l.company || '').toLowerCase()} data-category={l.category || ''} data-status={l.status} data-score={l.score} data-touches={l.touch_count} data-last-seen={l.last_seen_at} data-hot={isHot ? '1' : '0'}>
                    <td style="width:20px;"><span class="cc-caret">▶</span></td>
                    <td>{isHot && <span class="cc-hot" title="Hot lead (score 50+)"></span>}{l.email}</td>
                    <td>{l.company || '-'}</td>
                    <td>{l.category || '-'}</td>
                    <td class="cc-score">{l.score}</td>
                    <td>{l.touch_count}</td>
                    <td><span class={`cc-status ${l.status}`}>{l.status}</span></td>
                    <td>{fmtDate(l.last_seen_at)}</td>
                  </tr>
                  <tr class="cc-detail" data-detail-for={l.id}>
                    <td colspan="8" class="cc-detail-cell">
                      <div class="cc-detail-inner">
                        <div class="cc-detail-grid">
                          <div>
                            <p class="cc-detail-h">Event history ({leadEvents.length})</p>
                            {leadEvents.length === 0 ? <p class="cc-empty-panel">No events recorded.</p> : (
                              <ul class="cc-timeline">
                                {leadEvents.map((e) => (
                                  <li>
                                    <span class="ev-type">{EVENT_LABELS[e.event_type] ?? e.event_type}</span>
                                    <span class="ev-meta">{e.page || e.source || '—'} · {fmtDateTime(e.created_at)}</span>
                                    <span class="ev-pts">+{e.points}</span>
                                  </li>
                                ))}
                              </ul>
                            )}
                          </div>
                          <div>
                            <p class="cc-detail-h">Nurture sequence</p>
                            {leadSeqs.length === 0 ? <p class="cc-empty-panel">Not scheduled.</p> : (
                              <ul class="cc-seq">
                                {leadSeqs.map((s) => (
                                  <li>
                                    <span>{SEQUENCE_LABELS[s.step] ?? `Step ${s.step}`}</span>
                                    <span class={`cc-seq-badge ${s.status}`}>{s.status}</span>
                                  </li>
                                ))}
                              </ul>
                            )}
                          </div>
                        </div>
                      </div>
                    </td>
                  </tr>
                </>
              );
            })}
          </tbody>
        </table>
      </div>
      <p id="cc-count" style="font-size:12px;color:var(--text-3);margin-top:10px;">{totalLeads} leads</p>
    </>
  )}
</div>

<script>
  const search = document.getElementById('cc-search') as HTMLInputElement | null;
  const filterCat = document.getElementById('cc-filter-cat') as HTMLSelectElement | null;
  const filterStatus = document.getElementById('cc-filter-status') as HTMLSelectElement | null;
  const filterHot = document.getElementById('cc-filter-hot') as HTMLInputElement | null;
  const table = document.getElementById('cc-table') as HTMLTableElement | null;
  const count = document.getElementById('cc-count');
  const exportBtn = document.getElementById('cc-export');

  if (table) {
    const tbody = table.tBodies[0];
    const rows = Array.from(tbody.querySelectorAll('tr.cc-row')) as HTMLTableRowElement[];

    function detailFor(row: HTMLTableRowElement) {
      return tbody.querySelector(`tr.cc-detail[data-detail-for="${row.dataset.leadId}"]`) as HTMLTableRowElement | null;
    }

    rows.forEach((row) => {
      row.addEventListener('click', () => {
        const detail = detailFor(row);
        if (!detail) return;
        const willOpen = !row.classList.contains('open');
        row.classList.toggle('open', willOpen);
        detail.classList.toggle('open', willOpen);
      });
    });

    function applyFilters() {
      const q = (search?.value || '').toLowerCase().trim();
      const cat = filterCat?.value || '';
      const status = filterStatus?.value || '';
      const hotOnly = filterHot?.checked || false;
      let visible = 0;
      rows.forEach((row) => {
        const email = row.dataset.email || '';
        const name = row.dataset.name || '';
        const company = row.dataset.company || '';
        const rowCat = row.dataset.category || '';
        const rowStatus = row.dataset.status || '';
        const isHot = row.dataset.hot === '1';
        const matches =
          (!q || email.includes(q) || name.includes(q) || company.includes(q)) &&
          (!cat || rowCat === cat) &&
          (!status || rowStatus === status) &&
          (!hotOnly || isHot);
        row.style.display = matches ? '' : 'none';
        const detail = detailFor(row);
        if (detail && !matches) {
          detail.classList.remove('open');
          row.classList.remove('open');
        }
        if (detail) detail.style.display = matches ? '' : 'none';
        if (matches) visible++;
      });
      if (count) count.textContent = `${visible} lead${visible === 1 ? '' : 's'}`;
    }
    search?.addEventListener('input', applyFilters);
    filterCat?.addEventListener('change', applyFilters);
    filterStatus?.addEventListener('change', applyFilters);
    filterHot?.addEventListener('change', applyFilters);

    let sortKey = 'score';
    let sortDir = -1;
    table.querySelectorAll('th[data-sort]').forEach((th) => {
      th.addEventListener('click', () => {
        const key = (th as HTMLElement).dataset.sort as string;
        sortDir = key === sortKey ? -sortDir : -1;
        sortKey = key;
        const attrKey = key === 'touch_count' ? 'touches' : key === 'last_seen_at' ? 'lastSeen' : key;
        rows.sort((a, b) => {
          const av = (a.dataset as any)[attrKey] ?? '';
          const bv = (b.dataset as any)[attrKey] ?? '';
          const an = Number(av), bn = Number(bv);
          if (!isNaN(an) && !isNaN(bn) && av !== '' && bv !== '') return (an - bn) * sortDir;
          return String(av).localeCompare(String(bv)) * sortDir;
        });
        rows.forEach((r) => {
          const detail = detailFor(r);
          tbody.appendChild(r);
          if (detail) tbody.appendChild(detail);
        });
      });
    });

    exportBtn?.addEventListener('click', () => {
      const header = ['Email', 'Company', 'Category', 'Score', 'Touches', 'Status', 'Last seen'];
      const lines = [header.join(',')];
      rows.forEach((row) => {
        if (row.style.display === 'none') return;
        const vals = [
          row.dataset.email || '',
          row.dataset.company || '',
          row.dataset.category || '',
          row.dataset.score || '',
          row.dataset.touches || '',
          row.dataset.status || '',
          row.dataset.lastSeen || '',
        ].map((v) => `"${String(v).replace(/"/g, '""')}"`);
        lines.push(vals.join(','));
      });
      const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `purist-leads-${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  }
</script>

</BaseLayout>
