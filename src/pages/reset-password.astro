---
export const prerender = false;
import { createSupabaseServerClient } from '~/lib/supabase';

let errorMsg = '';
let successMsg = '';
let ready = false; // true once we have a valid recovery session to act on
const cookieHeaders = new Headers();
const supabase = createSupabaseServerClient(Astro.request, cookieHeaders);

const code = Astro.url.searchParams.get('code');

if (Astro.request.method === 'POST') {
 try {
   const text = await Astro.request.text();
   const params = new URLSearchParams(text);
   const password = params.get('password') ?? '';
   const confirm = params.get('confirm') ?? '';

   if (!password || password.length < 6) {
     errorMsg = 'Password must be at least 6 characters.';
     ready = true;
   } else if (password !== confirm) {
     errorMsg = 'Passwords do not match.';
     ready = true;
   } else {
     const { error } = await supabase.auth.updateUser({ password });
     if (error) {
       errorMsg = error.message;
       ready = true;
     } else {
       successMsg = 'Password updated. You can now sign in with your new password.';
     }
   }
 } catch (e: any) {
   errorMsg = e?.message ?? 'An error occurred.';
   ready = true;
 }
} else if (code) {
 const { error } = await supabase.auth.exchangeCodeForSession(code);
 if (error) {
   errorMsg = 'This reset link is invalid or has expired. Request a new one.';
 } else {
   ready = true;
 }
} else {
 const { data: { user } } = await supabase.auth.getUser();
 if (user) {
   ready = true;
 } else {
   errorMsg = 'This reset link is invalid or has expired. Request a new one.';
 }
}

cookieHeaders.forEach((val, key) => Astro.response.headers.append(key, val));
---
<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8"/>
 <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
 <title>Set new password PURIST</title>
 <meta name="robots" content="noindex, nofollow" />
 <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
 <style>
   *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
   body {
     font-family: 'Inter Variable', Inter, sans-serif;
     background: #F7F4EF;
     min-height: 100vh;
     display: flex;
     align-items: center;
     justify-content: center;
     padding: 2rem 1rem;
   }
   .wrap { width: 100%; max-width: 420px; }
   .logo { text-align: center; margin-bottom: 2rem; }
   .logo a { font-family: 'Fraunces Variable', Fraunces, Georgia, serif; font-size: 1.6rem; font-weight: 600; color: #0A0A0A; text-decoration: none; letter-spacing: -0.02em; }
   .logo span { color: #2D5016; }
   .logo p { font-size: 11px; color: #9ca3af; margin-top: 4px; letter-spacing: 0.05em; text-transform: uppercase; }
   .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 20px; padding: 2rem; box-shadow: 0 2px 16px rgba(0,0,0,0.06); }
   .card h1 { font-size: 15px; font-weight: 600; color: #0A0A0A; margin-bottom: 6px; }
   .card p.lead { font-size: 12.5px; color: #6b7280; margin-bottom: 1.25rem; line-height: 1.5; }
   .alert-err { background: rgba(220,38,38,0.06); border: 1px solid rgba(220,38,38,0.15); color: #dc2626; border-radius: 10px; padding: 10px 14px; font-size: 12px; margin-bottom: 1.25rem; }
   .alert-ok { background: rgba(45,80,22,0.06); border: 1px solid rgba(45,80,22,0.15); color: #2D5016; border-radius: 10px; padding: 10px 14px; font-size: 12px; margin-bottom: 1.25rem; }
   form { display: flex; flex-direction: column; gap: 1rem; }
   .field label { display: block; font-size: 10.5px; font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 6px; }
   .field input {
     width: 100%; border: 1.5px solid #e5e7eb; border-radius: 10px;
     padding: 11px 14px; font-size: 13.5px; color: #0A0A0A;
     background: #fafaf8; outline: none; transition: border-color 0.15s;
     font-family: 'Inter Variable', Inter, sans-serif;
   }
   .field input:focus { border-color: #0A0A0A; background: #fff; }
   .btn-submit {
     width: 100%; padding: 13px; background: #0A0A0A; color: #fff;
     border: none; border-radius: 10px; font-size: 13.5px; font-weight: 600;
     cursor: pointer; transition: background 0.15s; letter-spacing: 0.01em;
   }
   .btn-submit:hover { background: #222; }
   .link-row { text-align: center; margin-top: 1rem; }
   .link-row a { font-size: 12px; color: #6b7280; text-decoration: none; }
   .link-row a:hover { color: #0A0A0A; }
   .logo-link { text-align: center; }
 </style>
</head>
<body>
<div class="wrap">
 <div class="logo">
   <a href="/">PURIST<span>.</span></a>
   <p>Client Portal</p>
 </div>
 <div class="card">
   <h1>Set a new password</h1>
   {successMsg && <div class="alert-ok">{successMsg}</div>}
   {errorMsg && <div class="alert-err">{errorMsg}</div>}
   {ready && !successMsg && (
     <>
       <p class="lead">Choose a new password for your account.</p>
       <form method="POST">
         <div class="field">
           <label>New password</label>
           <input type="password" name="password" required minlength="6" autocomplete="new-password" placeholder="Min. 6 characters"/>
         </div>
         <div class="field">
           <label>Confirm password</label>
           <input type="password" name="confirm" required minlength="6" autocomplete="new-password" placeholder="Repeat password"/>
         </div>
         <button type="submit" class="btn-submit">Update password →</button>
       </form>
     </>
   )}
   {(successMsg || (!ready && errorMsg)) && (
     <div class="link-row"><a href="/login">← Back to sign in</a></div>
   )}
   {!ready && errorMsg && (
     <div class="link-row"><a href="/forgot-password">Request a new link →</a></div>
   )}
 </div>
</div>
</body>
</html>
