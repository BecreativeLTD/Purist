---
import { professions } from '~/data/automations';
const count = professions.length;
---

<section class="bg-brand-cream py-16 lg:py-20">
  <div class="container-x">
    <div class="rounded-[24px] px-6 py-12 lg:px-16 lg:py-16 text-center" style="background:#0A0A0A;">
      <p class="text-[11px] uppercase tracking-[0.2em] font-semibold mb-4" style="color:#E8B4B0;">Free · Instant PDF · No cost</p>
      <h2 class="font-display text-2xl lg:text-4xl text-white mb-4 text-balance">
        {count}+ free automation guides,<br class="hidden sm:block" /> <em class="font-medium" style="color:#E8B4B0;">built for your exact profession.</em>
      </h2>
      <p class="text-sm text-white/45 max-w-lg mx-auto mb-8 leading-relaxed">
        Search your profession, get a free 15-page PDF: priority workflows, tool stack, ROI math, and a 90-day deployment roadmap. No email spam, no sales call required to download.
      </p>
      <a href="/pages/free-guides" class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-button text-[14px] font-bold transition" style="background:#E8B4B0;color:#0A0A0A;">
        Get my free guide
        <svg class="w-4 h-4" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M2 7h10M8 3l4 4-4 4"/></svg>
      </a>
    </div>
  </div>
</section>
