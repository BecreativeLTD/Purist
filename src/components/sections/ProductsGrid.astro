---
import productsData from '~/data/products.json';
import Button from '~/components/ui/Button.astro';
import StarRating from '~/components/ui/StarRating.astro';
import { formatPrice } from '~/lib/format';
const { products } = productsData;

// Quick-glance specs per plan, so visitors don't have to click through to
// /pages/pricing's comparison table to see how many workflows/agents/
// integrations are actually included.
const planSpecs: Record<string, { workflows: string; agents: string; integrations: string; sla: string }> = {
  'automation-pro': { workflows: '12 workflows', agents: '—', integrations: '2 integrations', sla: '24h SLA' },
  'ai-agent-deploy': { workflows: '—', agents: '5 AI agents', integrations: '2 integrations', sla: '24h SLA' },
  'full-stack': { workflows: '12+ workflows', agents: '5+ AI agents', integrations: 'Unlimited', sla: '12h SLA' },
};
---

<section class="bg-white py-20 lg:py-28">
 <div class="container-x">
   <div class="max-w-2xl mb-12">
     <p class="eyebrow mb-4">The system</p>
     <h2 class="font-display text-h1 text-balance">
       Three plans. <em class="font-medium">One complete operations stack.</em>
     </h2>
   </div>

   <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
     {products.map((p, idx) => (
       <article class={`group/card relative flex flex-col rounded-card overflow-hidden border transition ${idx === 0 ? 'border-brand-black shadow-xl scale-[1.02] bg-brand-cream' : 'border-brand-gray-100 hover:border-brand-gray-200 bg-white'}`}>
         {p.badge && (
           <div class={`px-4 py-2.5 text-center text-[10px] tracking-wider uppercase font-medium ${idx === 0 ? 'bg-brand-black text-white' : 'bg-brand-cream text-brand-gray-600'}`}>
             {p.badge}
           </div>
         )}

         <a href={`/plans/${p.slug}`} class="block aspect-[4/3] overflow-hidden bg-brand-sand">
           <img
             src={p.images[0]}
             alt={`${p.title} packaging`}
             width="600"
             height="450"
             class="w-full h-full object-cover transition-transform duration-700 group-hover/card:scale-[1.02]"
             loading="lazy"
           />
         </a>

         <div class="p-6 lg:p-8 flex flex-col flex-1">
           <p class="eyebrow mb-2">{p.eyebrow}</p>
           <h3 class="font-display text-2xl mb-2">
             <a href={`/plans/${p.slug}`} class="hover:opacity-70 transition">{p.title}</a>
           </h3>
           <div class="mb-3">
             <StarRating rating={p.rating} size="sm" reviewCount={p.reviewCount} />
           </div>
           <p class="text-sm text-brand-gray-600 mb-4 text-pretty">{p.shortDescription}</p>

           <div class="mb-1">
             <div class="flex items-baseline gap-3">
               <span class="font-display text-2xl">From <span data-price={p.price.subscription}>€{p.price.subscription.toLocaleString('en')}</span>/mo</span>
               {p.price.discount > 0 && (
                 <span class="text-[11px] uppercase tracking-wider bg-brand-green/10 text-brand-green px-2 py-0.5 rounded font-medium">
                   {p.price.discount}% OFF
                 </span>
               )}
             </div>
             <p class="text-xs text-brand-gray-600 mt-1">Or <span data-price={p.price.oneTime}>€{p.price.oneTime.toLocaleString('en')}</span> one-time deployment</p>
           </div>
           <div class="mb-4"></div>

           {planSpecs[p.slug] && (
             <div class="grid grid-cols-2 gap-2 mb-5 pb-5 border-b border-brand-gray-100">
               {Object.values(planSpecs[p.slug]).filter((v) => v !== '—').map((v) => (
                 <div class="flex items-center gap-1.5 text-[11.5px] text-brand-gray-700">
                   <span class="w-1.5 h-1.5 rounded-full bg-brand-black/30 shrink-0"></span>
                   <span class="font-medium">{v}</span>
                 </div>
               ))}
             </div>
           )}

           <ul class="space-y-2 mb-6 text-sm flex-1">
             {p.bullets.map((b) => (
               <li class="flex items-start gap-2">
                 <span class="text-brand-green mt-0.5">✓</span>
                 <span class="text-brand-black/80">{b}</span>
               </li>
             ))}
           </ul>

           <Button href={`/plans/${p.slug}`} full variant={idx === 0 ? 'primary' : 'secondary'}>
             Get started with {p.title} →
           </Button>
           <a
             href={`/plans/${p.slug}`}
             class="text-xs text-center mt-3 underline underline-offset-4 hover:opacity-70"
           >
             {p.id === 'foundation-pro'
               ? 'Also included in The Full Stack →'
               : 'See full workflow details →'}
           </a>
           <p class="text-[11px] text-center text-brand-gray-600 mt-3">
             30-day money-back guarantee
           </p>
         </div>
       </article>
     ))}
   </div>

   <!-- Enterprise row -->
   <div class="mt-6 rounded-card border border-brand-gray-100 bg-brand-black text-white p-8 lg:p-10 grid lg:grid-cols-12 gap-6 lg:gap-10 items-center">
     <div class="lg:col-span-2 flex items-center justify-center lg:justify-start">
       <div class="w-16 h-16 rounded-[18px] flex items-center justify-center" style="background:rgba(232,180,176,0.10);border:1px solid rgba(232,180,176,0.18);">
         <svg class="w-7 h-7" viewBox="0 0 28 28" fill="none" stroke="#E8B4B0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
           <rect x="3" y="8" width="22" height="17" rx="3"/>
           <path d="M9 8V6a5 5 0 0 1 10 0v2"/>
           <circle cx="14" cy="16.5" r="2.5"/>
           <path d="M14 19v3"/>
         </svg>
       </div>
     </div>
     <div class="lg:col-span-7">
       <p class="text-[10px] uppercase tracking-[0.20em] font-medium mb-2" style="color:rgba(232,180,176,0.60);">Enterprise</p>
       <h3 class="font-display text-2xl lg:text-3xl mb-2 text-white">Multi-location. Multi-team. <em class="font-medium" style="color:#E8B4B0;">Custom-built.</em></h3>
       <p class="text-sm leading-relaxed" style="color:rgba(255,255,255,0.55);">
         White-glove deployment for groups, franchises, and high-volume operations. Dedicated engineer, SLA above 99.97%, compliance documentation, and priority response.
       </p>
     </div>
     <div class="lg:col-span-3 flex flex-col gap-3 items-start lg:items-end">
       <a
         href="/pages/contact-us"
         class="inline-flex items-center gap-2 px-5 py-3 rounded-button text-sm font-medium transition"
         style="background:#E8B4B0;color:#0A0A0A;"
         onmouseover="this.style.background='#d9a09b'"
         onmouseout="this.style.background='#E8B4B0'"
       >
         Talk to our team →
       </a>
       <p class="text-[11px]" style="color:rgba(255,255,255,0.30);">Custom pricing · POC in 72h</p>
     </div>
   </div>
 </div>
</section>
