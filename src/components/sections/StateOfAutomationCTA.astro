---
import { professions } from '~/data/automations';
const totalWorkflows = professions.length * 4;
---

<section class="bg-white py-14 lg:py-18">
  <div class="container-x">
    <div class="rounded-[24px] px-6 py-10 lg:px-14 lg:py-12 grid lg:grid-cols-[1fr_auto] items-center gap-8" style="background:#0A0A0A;border:1px solid rgba(139,64,56,0.35);">
      <div>
        <p class="text-[11px] uppercase tracking-[0.2em] font-semibold mb-3" style="color:#E8B4B0;">PURIST Research &middot; 2026 Edition</p>
        <h2 class="font-display text-2xl lg:text-[2rem] text-white mb-3 text-balance leading-[1.15]">
          The State of Business Automation, <em class="font-medium" style="color:#E8B4B0;">2026.</em>
        </h2>
        <p class="text-sm text-white/50 max-w-xl leading-relaxed mb-5 lg:mb-0">
          {professions.length} professions, {totalWorkflows} documented workflows analysed: time saved, revenue impact, deployment speed, and where AI agents are still underused. Free to read, full PDF by email.
        </p>
        <div class="flex flex-wrap gap-x-6 gap-y-2 lg:hidden mb-5">
          <div><span class="font-display text-lg text-white">{professions.length}</span> <span class="text-[11px] text-white/40">professions</span></div>
          <div><span class="font-display text-lg text-white">{totalWorkflows}</span> <span class="text-[11px] text-white/40">workflows</span></div>
          <div><span class="font-display text-lg text-white">25</span> <span class="text-[11px] text-white/40">page PDF</span></div>
        </div>
      </div>
      <div class="flex flex-col items-start lg:items-end gap-4">
        <div class="hidden lg:flex flex-col items-end gap-1 mb-1">
          <span class="font-display text-2xl text-white">{professions.length} professions &middot; {totalWorkflows} workflows &middot; 25-page PDF</span>
        </div>
        <a href="/pages/state-of-automation-report-2026" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-button text-[13.5px] font-bold whitespace-nowrap transition" style="background:#8B4038;color:#fff;">
          Read the full report
          <svg class="w-4 h-4" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M2 7h10M8 3l4 4-4 4"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>
