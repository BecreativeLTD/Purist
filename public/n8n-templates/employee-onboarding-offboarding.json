{
  "name": "Employee Onboarding & Offboarding (28 nodes)",
  "nodes": [
    { "id": "1", "name": "HRIS New Hire Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, -150],
      "parameters": { "path": "new-hire", "httpMethod": "POST" } },
    { "id": "2", "name": "HRIS Termination Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 250],
      "parameters": { "path": "termination", "httpMethod": "POST" } },
    { "id": "3", "name": "Extract New Hire Details", "type": "n8n-nodes-base.set", "typeVersion": 3, "position": [220, -150],
      "parameters": { "assignments": { "assignments": [
        { "name": "startDate", "value": "={{$json.startDate}}", "type": "string" },
        { "name": "role", "value": "={{$json.role}}", "type": "string" },
        { "name": "department", "value": "={{$json.department}}", "type": "string" }
      ] } } },
    { "id": "4", "name": "Days Until Start", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [440, -150],
      "parameters": { "jsCode": "const days = Math.ceil((new Date($json.startDate) - new Date()) / 86400000);\nreturn [{ json: { ...$json, daysUntilStart: days } }];" } },
    { "id": "5", "name": "Start Date Within 5 Days?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [660, -150],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.daysUntilStart}}", "rightValue": 5, "operator": { "type": "number", "operation": "lte" } } ] } } },
    { "id": "6", "name": "Wait Until 5 Days Before", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [880, -50],
      "parameters": { "amount": 1, "unit": "days" },
      "notes": "Provisioning too early wastes license seats, this holds until 5 business days out." },
    { "id": "7", "name": "Create Google Workspace Account", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1100, -250],
      "parameters": { "method": "POST", "url": "https://admin.googleapis.com/admin/directory/v1/users" } },
    { "id": "8", "name": "Add To Department Group", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1320, -250],
      "parameters": { "method": "POST", "url": "https://admin.googleapis.com/admin/directory/v1/groups/{{$json.department}}/members" } },
    { "id": "9", "name": "Create Slack Account & Add Channels", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1100, -50],
      "parameters": { "method": "POST", "url": "https://slack.com/api/admin.users.invite" } },
    { "id": "10", "name": "Role-Specific Provisioning", "type": "n8n-nodes-base.switch", "typeVersion": 3, "position": [1100, 150],
      "parameters": { "mode": "rules", "rules": { "values": [
        { "outputKey": "engineering", "conditions": { "conditions": [ { "leftValue": "={{$json.department}}", "rightValue": "Engineering", "operator": { "type": "string", "operation": "equals" } } ] } },
        { "outputKey": "sales", "conditions": { "conditions": [ { "leftValue": "={{$json.department}}", "rightValue": "Sales", "operator": { "type": "string", "operation": "equals" } } ] } }
      ] } } },
    { "id": "11", "name": "Provision GitHub + AWS Access", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1320, 100],
      "parameters": { "method": "POST", "url": "https://api.github.com/orgs/{{ORG}}/memberships/{{$json.githubHandle}}" } },
    { "id": "12", "name": "Provision CRM + Dialer Access", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1320, 250],
      "parameters": { "method": "POST", "url": "https://api.hubapi.com/settings/v3/users" } },
    { "id": "13", "name": "Order Laptop & Equipment", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1540, 150],
      "parameters": { "method": "POST", "url": "https://api.assetpanda.com/v2/orders" } },
    { "id": "14", "name": "Merge Provisioning Paths", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [1760, -50],
      "parameters": { "mode": "combine", "numberInputs": 4 } },
    { "id": "15", "name": "Schedule Day-1 Calendar Events", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1980, -50],
      "parameters": { "method": "POST", "url": "https://www.googleapis.com/calendar/v3/calendars/primary/events" },
      "notes": "IT setup, manager 1:1, team intro, HR paperwork, benefits walkthrough, all pre-scheduled before day one." },
    { "id": "16", "name": "Assign Onboarding Buddy", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2200, -50],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/buddy_assignments" } },
    { "id": "17", "name": "Send Welcome Email With Access Details", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2420, -50],
      "parameters": { "method": "POST", "url": "https://api.resend.com/emails" } },
    { "id": "18", "name": "Notify Manager Provisioning Complete", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2640, -50],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" } },
    { "id": "19", "name": "Log Onboarding Record", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2860, -50],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/onboarding_log" } },
    { "id": "20", "name": "Extract Termination Details", "type": "n8n-nodes-base.set", "typeVersion": 3, "position": [220, 250],
      "parameters": { "assignments": { "assignments": [
        { "name": "lastDay", "value": "={{$json.lastDay}}", "type": "string" },
        { "name": "isVoluntary", "value": "={{$json.isVoluntary}}", "type": "boolean" }
      ] } } },
    { "id": "21", "name": "Involuntary Departure?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [440, 250],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.isVoluntary}}", "rightValue": false, "operator": { "type": "boolean", "operation": "true" } } ] } },
      "notes": "Involuntary offboarding revokes access immediately. Voluntary offboarding revokes at end of last day." },
    { "id": "22", "name": "Revoke Access Immediately", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, 150],
      "parameters": { "method": "DELETE", "url": "https://admin.googleapis.com/admin/directory/v1/users/{{$json.email}}" },
      "notes": "For involuntary departures, revocation happens before the employee is even notified, standard security practice." },
    { "id": "23", "name": "Schedule Revocation For Last Day", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [660, 350],
      "parameters": { "resume": "specificTime" } },
    { "id": "24", "name": "Revoke All System Access", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [880, 250],
      "parameters": { "method": "DELETE", "url": "https://admin.googleapis.com/admin/directory/v1/users/{{$json.email}}" } },
    { "id": "25", "name": "Retrieve Company Equipment", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1100, 250],
      "parameters": { "method": "POST", "url": "https://api.assetpanda.com/v2/return-requests" } },
    { "id": "26", "name": "Transfer File Ownership To Manager", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1320, 250],
      "parameters": { "method": "POST", "url": "https://www.googleapis.com/drive/v3/files/transferOwnership" },
      "notes": "Without this step, departed employees' Drive files routinely become permanently inaccessible." },
    { "id": "27", "name": "Setup Notes", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -450],
      "parameters": { "content": "## Setup\n1. Connect this workflow's two webhooks to your HRIS 'new hire' and 'termination' events.\n2. Configure department-specific provisioning in Role-Specific Provisioning.\n3. Set your security team's policy for involuntary vs voluntary revocation timing.", "height": 210, "width": 420 } },
    { "id": "28", "name": "Credential Requirements", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -200],
      "parameters": { "content": "## Credentials needed\n- Google Workspace Admin SDK\n- Slack Enterprise Grid admin token\n- GitHub org admin token, HubSpot admin\n- Asset management API (AssetPanda or equivalent)\n- Airtable PAT, Resend API key", "height": 200, "width": 420 } }
  ],
  "connections": {
    "HRIS New Hire Webhook": { "main": [[{ "node": "Extract New Hire Details", "type": "main", "index": 0 }]] },
    "Extract New Hire Details": { "main": [[{ "node": "Days Until Start", "type": "main", "index": 0 }]] },
    "Days Until Start": { "main": [[{ "node": "Start Date Within 5 Days?", "type": "main", "index": 0 }]] },
    "Start Date Within 5 Days?": { "main": [
      [{ "node": "Create Google Workspace Account", "type": "main", "index": 0 }, { "node": "Create Slack Account & Add Channels", "type": "main", "index": 0 }, { "node": "Role-Specific Provisioning", "type": "main", "index": 0 }],
      [{ "node": "Wait Until 5 Days Before", "type": "main", "index": 0 }]
    ] },
    "Wait Until 5 Days Before": { "main": [[{ "node": "Start Date Within 5 Days?", "type": "main", "index": 0 }]] },
    "Create Google Workspace Account": { "main": [[{ "node": "Add To Department Group", "type": "main", "index": 0 }]] },
    "Add To Department Group": { "main": [[{ "node": "Merge Provisioning Paths", "type": "main", "index": 0 }]] },
    "Create Slack Account & Add Channels": { "main": [[{ "node": "Merge Provisioning Paths", "type": "main", "index": 1 }]] },
    "Role-Specific Provisioning": { "main": [
      [{ "node": "Provision GitHub + AWS Access", "type": "main", "index": 0 }],
      [{ "node": "Provision CRM + Dialer Access", "type": "main", "index": 0 }]
    ] },
    "Provision GitHub + AWS Access": { "main": [[{ "node": "Order Laptop & Equipment", "type": "main", "index": 0 }]] },
    "Provision CRM + Dialer Access": { "main": [[{ "node": "Order Laptop & Equipment", "type": "main", "index": 0 }]] },
    "Order Laptop & Equipment": { "main": [[{ "node": "Merge Provisioning Paths", "type": "main", "index": 2 }]] },
    "Merge Provisioning Paths": { "main": [[{ "node": "Schedule Day-1 Calendar Events", "type": "main", "index": 0 }]] },
    "Schedule Day-1 Calendar Events": { "main": [[{ "node": "Assign Onboarding Buddy", "type": "main", "index": 0 }]] },
    "Assign Onboarding Buddy": { "main": [[{ "node": "Send Welcome Email With Access Details", "type": "main", "index": 0 }]] },
    "Send Welcome Email With Access Details": { "main": [[{ "node": "Notify Manager Provisioning Complete", "type": "main", "index": 0 }]] },
    "Notify Manager Provisioning Complete": { "main": [[{ "node": "Log Onboarding Record", "type": "main", "index": 0 }]] },
    "HRIS Termination Webhook": { "main": [[{ "node": "Extract Termination Details", "type": "main", "index": 0 }]] },
    "Extract Termination Details": { "main": [[{ "node": "Involuntary Departure?", "type": "main", "index": 0 }]] },
    "Involuntary Departure?": { "main": [
      [{ "node": "Revoke Access Immediately", "type": "main", "index": 0 }],
      [{ "node": "Schedule Revocation For Last Day", "type": "main", "index": 0 }]
    ] },
    "Revoke Access Immediately": { "main": [[{ "node": "Retrieve Company Equipment", "type": "main", "index": 0 }]] },
    "Schedule Revocation For Last Day": { "main": [[{ "node": "Revoke All System Access", "type": "main", "index": 0 }]] },
    "Revoke All System Access": { "main": [[{ "node": "Retrieve Company Equipment", "type": "main", "index": 0 }]] },
    "Retrieve Company Equipment": { "main": [[{ "node": "Transfer File Ownership To Manager", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCreatedBy": "PURIST", "instanceId": "purist-template-employee-onboarding-offboarding" }
}
