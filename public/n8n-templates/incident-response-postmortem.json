      [{ "node": "Log Only, Create Ticket", "type": "main", "index": 0 }]
    ] },
    "Create Incident Channel": { "main": [[{ "node": "Page On-Call", "type": "main", "index": 0 }]] },
    "Page On-Call": { "main": [[{ "node": "Update Status Page: Investigating", "type": "main", "index": 0 }]] },
    "Update Status Page: Investigating": { "main": [[{ "node": "Merge Severity Paths", "type": "main", "index": 0 }]] },
    "Notify Team Channel": { "main": [[{ "node": "Merge Severity Paths", "type": "main", "index": 1 }]] },
    "Log Only, Create Ticket": { "main": [[{ "node": "Merge Severity Paths", "type": "main", "index": 2 }]] },
    "Merge Severity Paths": { "main": [[{ "node": "Start Incident Timeline Log", "type": "main", "index": 0 }]] },
    "Resolution Webhook": { "main": [[{ "node": "Update Status Page: Resolved", "type": "main", "index": 0 }]] },
    "Update Status Page: Resolved": { "main": [[{ "node": "Calculate MTTR", "type": "main", "index": 0 }]] },
    "Calculate MTTR": { "main": [[{ "node": "Wait 24 Hours", "type": "main", "index": 0 }]] },
    "Wait 24 Hours": { "main": [[{ "node": "Get Full Incident Timeline", "type": "main", "index": 0 }]] },
