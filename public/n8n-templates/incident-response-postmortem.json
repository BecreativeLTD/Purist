{
  "name": "Incident Response & Postmortem Automation (26 nodes)",
  "nodes": [
    { "id": "1", "name": "Monitoring Alert Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0],
      "parameters": { "path": "monitoring-alert", "httpMethod": "POST" } },
    { "id": "2", "name": "Severity Classification", "type": "n8n-nodes-base.switch", "typeVersion": 3, "position": [220, 0],
      "parameters": { "mode": "rules", "rules": { "values": [
        { "outputKey": "sev1", "conditions": { "conditions": [ { "leftValue": "={{$json.severity}}", "rightValue": "SEV1", "operator": { "type": "string", "operation": "equals" } } ] } },
        { "outputKey": "sev2", "conditions": { "conditions": [ { "leftValue": "={{$json.severity}}", "rightValue": "SEV2", "operator": { "type": "string", "operation": "equals" } } ] } },
        { "outputKey": "sev3", "conditions": { "conditions": [ { "leftValue": "={{$json.severity}}", "rightValue": "SEV3", "operator": { "type": "string", "operation": "equals" } } ] } }
      ] } } },
    { "id": "3", "name": "Create Incident Channel", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [440, -200],
      "parameters": { "method": "POST", "url": "https://slack.com/api/conversations.create" } },
    { "id": "4", "name": "Page On-Call", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, -200],
      "parameters": { "method": "POST", "url": "https://api.pagerduty.com/incidents" } },
    { "id": "5", "name": "Update Status Page: Investigating", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [880, -200],
      "parameters": { "method": "POST", "url": "https://api.statuspage.io/v1/pages/{{PAGE_ID}}/incidents" },
      "notes": "Customers see this within seconds of a SEV1 firing, before support tickets even start arriving." },
    { "id": "6", "name": "Notify Team Channel", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [440, 0],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" } },
    { "id": "7", "name": "Log Only, Create Ticket", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [440, 200],
      "parameters": { "method": "POST", "url": "https://api.linear.app/graphql" } },
    { "id": "8", "name": "Merge Severity Paths", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [1100, 0],
      "parameters": { "mode": "combine", "numberInputs": 3 } },
    { "id": "9", "name": "Start Incident Timeline Log", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1320, 0],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/incident_timeline" },
      "notes": "Every subsequent Slack update in the incident channel gets logged here automatically, building the postmortem's raw material as the incident unfolds, not reconstructed afterward from memory." },
    { "id": "10", "name": "Resolution Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [1540, 0],
      "parameters": { "path": "incident-resolved", "httpMethod": "POST" } },
    { "id": "11", "name": "Update Status Page: Resolved", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1760, 0],
      "parameters": { "method": "PATCH", "url": "https://api.statuspage.io/v1/pages/{{PAGE_ID}}/incidents/{{$json.incidentId}}" } },
    { "id": "12", "name": "Calculate MTTR", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1980, 0],
      "parameters": { "jsCode": "const detectedAt = new Date($json.detectedAt);\nconst resolvedAt = new Date($json.resolvedAt);\nconst mttrMinutes = Math.round((resolvedAt - detectedAt) / 60000);\nreturn [{ json: { ...$json, mttrMinutes } }];" } },
    { "id": "13", "name": "Wait 24 Hours", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [2200, 0],
      "parameters": { "amount": 24, "unit": "hours" },
      "notes": "Gives the team time to decompress before drafting the postmortem, and lets any delayed downstream effects surface first." },
    { "id": "14", "name": "Get Full Incident Timeline", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2420, 0],
      "parameters": { "method": "GET", "url": "https://api.airtable.com/v0/{{BASE_ID}}/incident_timeline" } },
    { "id": "15", "name": "AI Draft Postmortem", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2640, 0],
      "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages" },
      "notes": "Drafts what happened, the timeline, and likely contributing factors from the logged updates, a starting point for the team to correct and refine, not a final document." },
    { "id": "16", "name": "Schedule Postmortem Review Meeting", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2860, 0],
      "parameters": { "method": "POST", "url": "https://www.googleapis.com/calendar/v3/calendars/primary/events" } },
    { "id": "17", "name": "Postmortem Doc Finalized Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [3080, 0],
      "parameters": { "path": "postmortem-finalized", "httpMethod": "POST" } },
    { "id": "18", "name": "AI Extract Action Items", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3300, 0],
      "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages" } },
    { "id": "19", "name": "Create Tickets For Action Items", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3520, 0],
      "parameters": { "method": "POST", "url": "https://api.linear.app/graphql" },
      "notes": "Every action item becomes a tracked ticket with an owner immediately, the single most common postmortem failure is action items that exist only in a document nobody revisits." },
    { "id": "20", "name": "Log Incident To Registry", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3740, 0],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/incident_registry" } },
    { "id": "21", "name": "Archive Incident Channel", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3960, 0],
      "parameters": { "method": "POST", "url": "https://slack.com/api/conversations.archive" } },
    { "id": "22", "name": "Quarterly MTTR Trend Schedule", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1, "position": [220, 400],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 8 1 */3 *" }] } } },
    { "id": "23", "name": "Compile MTTR Trend Report", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [440, 400],
      "parameters": { "method": "GET", "url": "https://api.airtable.com/v0/{{BASE_ID}}/incident_registry" } },
    { "id": "24", "name": "Send Trend Report To Leadership", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, 400],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" } },
    { "id": "25", "name": "Setup Notes", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -450],
      "parameters": { "content": "## Setup\n1. Connect your monitoring/alerting tool's webhook (Datadog, PagerDuty, Grafana all support this).\n2. Confirm severity classification matches your existing incident taxonomy.\n3. Statuspage integration is optional but strongly recommended for SEV1/2 customer-facing incidents.", "height": 210, "width": 440 } },
    { "id": "26", "name": "Credential Requirements", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -190],
      "parameters": { "content": "## Credentials needed\n- PagerDuty API\n- Statuspage.io API\n- Anthropic API key\n- Linear or Jira API, Google Calendar OAuth2\n- Airtable PAT, Slack Bot Token (with channel management scopes)", "height": 200, "width": 440 } }
  ],
  "connections": {
    "Monitoring Alert Webhook": { "main": [[{ "node": "Severity Classification", "type": "main", "index": 0 }]] },
    "Severity Classification": { "main": [
      [{ "node": "Create Incident Channel", "type": "main", "index": 0 }],
