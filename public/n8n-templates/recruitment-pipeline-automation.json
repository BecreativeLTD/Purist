      [{ "node": "Final Rejection", "type": "main", "index": 0 }]
    ] },
    "Generate Offer Letter": { "main": [[{ "node": "Send Offer Via DocuSign", "type": "main", "index": 0 }]] },
    "Send Offer Via DocuSign": { "main": [[{ "node": "Offer Accepted Webhook", "type": "main", "index": 0 }]] },
    "Offer Accepted Webhook": { "main": [[{ "node": "Trigger Onboarding Workflow", "type": "main", "index": 0 }]] },
