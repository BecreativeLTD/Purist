    "Schedule Panel Interview": { "main": [[{ "node": "Merge Assessment Paths", "type": "main", "index": 1 }]] },
    "Merge Assessment Paths": { "main": [[{ "node": "Final Decision Gate", "type": "main", "index": 0 }]] },
    "Log Rejection At This Stage": { "main": [[{ "node": "Merge Rejection Paths", "type": "main", "index": 0 }]] },
    "Final Decision Gate": { "main": [[{ "node": "Hired?", "type": "main", "index": 0 }]] },
    "Hired?": { "main": [
