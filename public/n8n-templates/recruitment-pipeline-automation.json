{
  "name": "Recruitment Pipeline Automation (28 nodes)",
  "nodes": [
    { "id": "1", "name": "New Application Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0],
      "parameters": { "path": "new-application", "httpMethod": "POST" } },
    { "id": "2", "name": "Parse Resume", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [220, 0],
      "parameters": { "method": "POST", "url": "https://api.affinda.com/v3/resumes" } },
    { "id": "3", "name": "AI Score Against Requirements", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [440, 0],
      "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages" },
      "notes": "Scores against the actual role requirements, not a generic resume quality score." },
    { "id": "4", "name": "Screening Threshold Met?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [660, 0],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.score}}", "rightValue": 60, "operator": { "type": "number", "operation": "gte" } } ] } } },
    { "id": "5", "name": "Auto-Schedule Screening Call", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [880, -150],
      "parameters": { "method": "POST", "url": "https://api.cal.com/v1/bookings" } },
    { "id": "6", "name": "Send Confirmation Email", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1100, -150],
      "parameters": { "method": "POST", "url": "https://api.resend.com/emails" } },
    { "id": "7", "name": "Send Polite Rejection", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [880, 150],
      "parameters": { "method": "POST", "url": "https://api.resend.com/emails" } },
    { "id": "8", "name": "Tag For Future Roles", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1100, 150],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/candidate_pool" },
      "notes": "A rejected candidate for this role may be a strong fit for a different one, this keeps them searchable instead of lost." },
    { "id": "9", "name": "Screening Completed Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [1320, -150],
      "parameters": { "path": "screening-complete", "httpMethod": "POST" } },
    { "id": "10", "name": "Collect Interviewer Feedback", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1540, -150],
      "parameters": { "method": "GET", "url": "https://api.greenhouse.io/v1/applications/{{$json.applicationId}}/scorecards" } },
    { "id": "11", "name": "Advance To Next Stage?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1760, -150],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.recommendAdvance}}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } } ] } } },
    { "id": "12", "name": "Role Type Router", "type": "n8n-nodes-base.switch", "typeVersion": 3, "position": [1980, -300],
      "parameters": { "mode": "rules", "rules": { "values": [
        { "outputKey": "technical", "conditions": { "conditions": [ { "leftValue": "={{$json.roleType}}", "rightValue": "technical", "operator": { "type": "string", "operation": "equals" } } ] } },
        { "outputKey": "nontechnical", "conditions": { "conditions": [ { "leftValue": "={{$json.roleType}}", "rightValue": "non-technical", "operator": { "type": "string", "operation": "equals" } } ] } }
      ] } } },
    { "id": "13", "name": "Send Coding Assessment", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2200, -400],
      "parameters": { "method": "POST", "url": "https://api.codesignal.com/assessments" } },
    { "id": "14", "name": "Wait For Assessment Completion", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [2420, -400],
      "parameters": { "resume": "webhook" } },
    { "id": "15", "name": "Schedule Panel Interview", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2200, -200],
      "parameters": { "method": "POST", "url": "https://www.googleapis.com/calendar/v3/calendars/primary/events" },
      "notes": "Coordinates multiple interviewer calendars into one panel slot instead of back-and-forth scheduling emails." },
    { "id": "16", "name": "Merge Assessment Paths", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [2640, -300],
      "parameters": { "mode": "chooseBranch" } },
    { "id": "17", "name": "Log Rejection At This Stage", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1980, 0],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/candidate_pool" } },
    { "id": "18", "name": "Final Decision Gate", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [2860, -300],
      "parameters": { "resume": "webhook" },
      "notes": "Hiring manager makes the final call with full interview history in front of them, not the workflow." },
    { "id": "19", "name": "Hired?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [3080, -300],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.decision}}", "rightValue": "hire", "operator": { "type": "string", "operation": "equals" } } ] } } },
    { "id": "20", "name": "Generate Offer Letter", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3300, -400],
      "parameters": { "method": "POST", "url": "https://api.pandadoc.com/public/v1/documents" } },
    { "id": "21", "name": "Send Offer Via DocuSign", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3520, -400],
      "parameters": { "method": "POST", "url": "https://api.docusign.com/restapi/v2.1/accounts/{{ACCOUNT_ID}}/envelopes" } },
    { "id": "22", "name": "Offer Accepted Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [3740, -400],
      "parameters": { "path": "offer-accepted", "httpMethod": "POST" } },
    { "id": "23", "name": "Trigger Onboarding Workflow", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3960, -400],
      "parameters": { "method": "POST", "url": "https://your-n8n-instance.com/webhook/new-hire" },
      "notes": "Hands off directly into the Employee Onboarding & Offboarding template, new hire fields pass through unchanged." },
    { "id": "24", "name": "Final Rejection", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3300, -200],
      "parameters": { "method": "POST", "url": "https://api.resend.com/emails" } },
    { "id": "25", "name": "Log To ATS Registry", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [4180, -400],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/hires_registry" } },
    { "id": "26", "name": "Merge Rejection Paths", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [2200, 100],
      "parameters": { "mode": "chooseBranch" } },
    { "id": "27", "name": "Setup Notes", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -500],
      "parameters": { "content": "## Setup\n1. Connect your ATS (Greenhouse used here) and a resume parser.\n2. Set the screening score threshold (default 60) per role.\n3. Chain the offer-accepted webhook into the Employee Onboarding & Offboarding template for a fully connected hire-to-day-one pipeline.", "height": 220, "width": 420 } },
    { "id": "28", "name": "Credential Requirements", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -230],
      "parameters": { "content": "## Credentials needed\n- Affinda or equivalent resume parsing API\n- Anthropic API key\n- Greenhouse/Lever ATS API\n- Cal.com or Google Calendar, CodeSignal or equivalent assessment platform\n- PandaDoc, DocuSign, Resend, Airtable PAT", "height": 210, "width": 420 } }
  ],
  "connections": {
    "New Application Webhook": { "main": [[{ "node": "Parse Resume", "type": "main", "index": 0 }]] },
    "Parse Resume": { "main": [[{ "node": "AI Score Against Requirements", "type": "main", "index": 0 }]] },
    "AI Score Against Requirements": { "main": [[{ "node": "Screening Threshold Met?", "type": "main", "index": 0 }]] },
    "Screening Threshold Met?": { "main": [
      [{ "node": "Auto-Schedule Screening Call", "type": "main", "index": 0 }],
      [{ "node": "Send Polite Rejection", "type": "main", "index": 0 }]
    ] },
    "Auto-Schedule Screening Call": { "main": [[{ "node": "Send Confirmation Email", "type": "main", "index": 0 }]] },
    "Send Polite Rejection": { "main": [[{ "node": "Tag For Future Roles", "type": "main", "index": 0 }]] },
    "Screening Completed Webhook": { "main": [[{ "node": "Collect Interviewer Feedback", "type": "main", "index": 0 }]] },
    "Collect Interviewer Feedback": { "main": [[{ "node": "Advance To Next Stage?", "type": "main", "index": 0 }]] },
    "Advance To Next Stage?": { "main": [
      [{ "node": "Role Type Router", "type": "main", "index": 0 }],
      [{ "node": "Log Rejection At This Stage", "type": "main", "index": 0 }]
    ] },
    "Role Type Router": { "main": [
      [{ "node": "Send Coding Assessment", "type": "main", "index": 0 }],
      [{ "node": "Schedule Panel Interview", "type": "main", "index": 0 }]
    ] },
    "Send Coding Assessment": { "main": [[{ "node": "Wait For Assessment Completion", "type": "main", "index": 0 }]] },
