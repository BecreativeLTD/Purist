{
  "name": "Contract Lifecycle Management (26 nodes)",
  "nodes": [
    { "id": "1", "name": "New Contract Request Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0],
      "parameters": { "path": "contract-request", "httpMethod": "POST" } },
    { "id": "2", "name": "Extract Contract Details", "type": "n8n-nodes-base.set", "typeVersion": 3, "position": [220, 0],
      "parameters": { "assignments": { "assignments": [
        { "name": "counterparty", "value": "={{$json.counterparty}}", "type": "string" },
        { "name": "contractType", "value": "={{$json.contractType}}", "type": "string" }
      ] } } },
    { "id": "3", "name": "Contract Type Router", "type": "n8n-nodes-base.switch", "typeVersion": 3, "position": [440, 0],
      "parameters": { "mode": "rules", "rules": { "values": [
        { "outputKey": "nda", "conditions": { "conditions": [ { "leftValue": "={{$json.contractType}}", "rightValue": "NDA", "operator": { "type": "string", "operation": "equals" } } ] } },
        { "outputKey": "msa", "conditions": { "conditions": [ { "leftValue": "={{$json.contractType}}", "rightValue": "MSA", "operator": { "type": "string", "operation": "equals" } } ] } },
        { "outputKey": "sow", "conditions": { "conditions": [ { "leftValue": "={{$json.contractType}}", "rightValue": "SOW", "operator": { "type": "string", "operation": "equals" } } ] } }
      ] } } },
    { "id": "4", "name": "Generate From NDA Template", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, -200],
      "parameters": { "method": "POST", "url": "https://api.pandadoc.com/public/v1/documents" } },
    { "id": "5", "name": "Generate From MSA Template", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, 0],
      "parameters": { "method": "POST", "url": "https://api.pandadoc.com/public/v1/documents" } },
    { "id": "6", "name": "Generate From SOW Template", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, 200],
      "parameters": { "method": "POST", "url": "https://api.pandadoc.com/public/v1/documents" } },
    { "id": "7", "name": "Merge Template Paths", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [880, 0],
      "parameters": { "mode": "chooseBranch" } },
    { "id": "8", "name": "AI Risk-Clause Extraction", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1100, 0],
      "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages" },
      "notes": "Scans the generated document text for non-standard clauses: unusual liability caps, missing termination rights, non-standard indemnification." },
    { "id": "9", "name": "Parse Risk Flags", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1320, 0],
      "parameters": { "jsCode": "// Extracts a list of flagged clauses and an overall risk boolean\nreturn $input.all();" } },
    { "id": "10", "name": "Non-Standard Clauses Found?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1540, 0],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.flaggedClauses.length}}", "rightValue": 0, "operator": { "type": "number", "operation": "gt" } } ] } } },
    { "id": "11", "name": "Route To Legal Review", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1760, -150],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" },
      "notes": "Legal sees exactly which clauses were flagged and why, not the whole document from scratch." },
    { "id": "12", "name": "Wait For Legal Approval", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [1980, -150],
      "parameters": { "resume": "webhook" } },
    { "id": "13", "name": "Merge Review Path", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [2200, 0],
      "parameters": { "mode": "chooseBranch" } },
    { "id": "14", "name": "Send For Signature", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2420, 0],
      "parameters": { "method": "POST", "url": "https://api.docusign.com/restapi/v2.1/accounts/{{ACCOUNT_ID}}/envelopes" } },
    { "id": "15", "name": "Wait For Signature Status", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [2640, 0],
      "parameters": { "resume": "webhook" } },
    { "id": "16", "name": "Fully Executed?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [2860, 0],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.envelopeStatus}}", "rightValue": "completed", "operator": { "type": "string", "operation": "equals" } } ] } } },
    { "id": "17", "name": "Wait 3 Days", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [3080, 150],
      "parameters": { "amount": 3, "unit": "days" } },
    { "id": "18", "name": "Send Signature Reminder", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3300, 150],
      "parameters": { "method": "POST", "url": "https://api.docusign.com/restapi/v2.1/accounts/{{ACCOUNT_ID}}/envelopes/{{$json.envelopeId}}/recipients" } },
    { "id": "19", "name": "File Executed Contract", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3080, -150],
      "parameters": { "method": "POST", "url": "https://www.googleapis.com/drive/v3/files" } },
    { "id": "20", "name": "Extract Key Dates", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [3300, -150],
      "parameters": { "jsCode": "// Pulls effective date, term length and renewal/expiry date from the executed document\nreturn $input.all();" } },
    { "id": "21", "name": "Schedule Renewal Reminder", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [3520, -150],
      "parameters": { "resume": "specificTime" },
      "notes": "Fires 90 days before contract expiry, giving real negotiation runway instead of a last-minute scramble." },
    { "id": "22", "name": "Notify Account Owner Of Renewal", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3740, -150],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" } },
    { "id": "23", "name": "Log To Contract Registry", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3960, -150],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/contract_registry" } },
    { "id": "24", "name": "Escalate Unsigned Contract", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3520, 150],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" },
      "notes": "After 3 reminder cycles with no signature, this becomes a human follow-up problem, not an automation problem." },
    { "id": "25", "name": "Setup Notes", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -450],
      "parameters": { "content": "## Setup\n1. Connect PandaDoc (or your template tool), DocuSign, and Anthropic.\n2. Load your NDA/MSA/SOW templates with merge fields matching Extract Contract Details.\n3. Tune the AI risk-clause prompt to your legal team's actual red-flag list.", "height": 200, "width": 420 } },
    { "id": "26", "name": "Credential Requirements", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -220],
      "parameters": { "content": "## Credentials needed\n- PandaDoc or DocuSign template API\n- DocuSign eSignature API\n- Anthropic API key\n- Google Drive OAuth2, Airtable PAT, Slack Bot Token", "height": 180, "width": 420 } }
  ],
  "connections": {
    "New Contract Request Webhook": { "main": [[{ "node": "Extract Contract Details", "type": "main", "index": 0 }]] },
    "Extract Contract Details": { "main": [[{ "node": "Contract Type Router", "type": "main", "index": 0 }]] },
    "Contract Type Router": { "main": [
      [{ "node": "Generate From NDA Template", "type": "main", "index": 0 }],
      [{ "node": "Generate From MSA Template", "type": "main", "index": 0 }],
      [{ "node": "Generate From SOW Template", "type": "main", "index": 0 }]
    ] },
    "Generate From NDA Template": { "main": [[{ "node": "Merge Template Paths", "type": "main", "index": 0 }]] },
    "Generate From MSA Template": { "main": [[{ "node": "Merge Template Paths", "type": "main", "index": 1 }]] },
    "Generate From SOW Template": { "main": [[{ "node": "Merge Template Paths", "type": "main", "index": 2 }]] },
    "Merge Template Paths": { "main": [[{ "node": "AI Risk-Clause Extraction", "type": "main", "index": 0 }]] },
    "AI Risk-Clause Extraction": { "main": [[{ "node": "Parse Risk Flags", "type": "main", "index": 0 }]] },
    "Parse Risk Flags": { "main": [[{ "node": "Non-Standard Clauses Found?", "type": "main", "index": 0 }]] },
    "Non-Standard Clauses Found?": { "main": [
      [{ "node": "Route To Legal Review", "type": "main", "index": 0 }],
      [{ "node": "Merge Review Path", "type": "main", "index": 1 }]
    ] },
    "Route To Legal Review": { "main": [[{ "node": "Wait For Legal Approval", "type": "main", "index": 0 }]] },
    "Wait For Legal Approval": { "main": [[{ "node": "Merge Review Path", "type": "main", "index": 0 }]] },
    "Merge Review Path": { "main": [[{ "node": "Send For Signature", "type": "main", "index": 0 }]] },
    "Send For Signature": { "main": [[{ "node": "Wait For Signature Status", "type": "main", "index": 0 }]] },
    "Wait For Signature Status": { "main": [[{ "node": "Fully Executed?", "type": "main", "index": 0 }]] },
    "Fully Executed?": { "main": [
      [{ "node": "File Executed Contract", "type": "main", "index": 0 }],
      [{ "node": "Wait 3 Days", "type": "main", "index": 0 }]
    ] },
    "Wait 3 Days": { "main": [[{ "node": "Send Signature Reminder", "type": "main", "index": 0 }]] },
    "Send Signature Reminder": { "main": [[{ "node": "Wait For Signature Status", "type": "main", "index": 0 }, { "node": "Escalate Unsigned Contract", "type": "main", "index": 0 }]] },
    "File Executed Contract": { "main": [[{ "node": "Extract Key Dates", "type": "main", "index": 0 }]] },
    "Extract Key Dates": { "main": [[{ "node": "Schedule Renewal Reminder", "type": "main", "index": 0 }]] },
    "Schedule Renewal Reminder": { "main": [[{ "node": "Notify Account Owner Of Renewal", "type": "main", "index": 0 }]] },
    "Notify Account Owner Of Renewal": { "main": [[{ "node": "Log To Contract Registry", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCreatedBy": "PURIST", "instanceId": "purist-template-contract-lifecycle-management" }
}
