{
  "name": "Order-to-Cash with Failure Recovery (32 nodes)",
  "nodes": [
    { "id": "1", "name": "Shopify Order Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0],
      "parameters": { "path": "shopify-order-created", "httpMethod": "POST" } },
    { "id": "2", "name": "Log Raw Order", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [220, 0],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/raw_orders" } },
    { "id": "3", "name": "Extract Order Fields", "type": "n8n-nodes-base.set", "typeVersion": 3, "position": [440, 0],
      "parameters": { "assignments": { "assignments": [
        { "name": "orderId", "value": "={{$json.id}}", "type": "string" },
        { "name": "customerEmail", "value": "={{$json.email}}", "type": "string" },
        { "name": "grossAmount", "value": "={{$json.total_price}}", "type": "number" }
      ] } } },
    { "id": "4", "name": "Capture Stripe Payment", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, 0],
      "parameters": { "method": "POST", "url": "https://api.stripe.com/v1/payment_intents/{{$json.paymentIntentId}}/capture" } },
    { "id": "5", "name": "Payment Success?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [880, 0],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.status}}", "rightValue": "succeeded", "operator": { "type": "string", "operation": "equals" } } ] } } },
    { "id": "6", "name": "Wait 5 Min Before Retry 1", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [1100, 150],
      "parameters": { "amount": 5, "unit": "minutes" } },
    { "id": "7", "name": "Retry Stripe Payment 1", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1320, 150],
      "parameters": { "method": "POST", "url": "https://api.stripe.com/v1/payment_intents/{{$json.paymentIntentId}}/capture" } },
    { "id": "8", "name": "Retry 1 Success?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1540, 150],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.status}}", "rightValue": "succeeded", "operator": { "type": "string", "operation": "equals" } } ] } } },
    { "id": "9", "name": "Wait 30 Min Before Retry 2", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [1760, 300],
      "parameters": { "amount": 30, "unit": "minutes" } },
    { "id": "10", "name": "Retry Stripe Payment 2", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1980, 300],
      "parameters": { "method": "POST", "url": "https://api.stripe.com/v1/payment_intents/{{$json.paymentIntentId}}/capture" } },
    { "id": "11", "name": "Retry 2 Success?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [2200, 300],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.status}}", "rightValue": "succeeded", "operator": { "type": "string", "operation": "equals" } } ] } } },
    { "id": "12", "name": "Escalate Payment Failure To Slack", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2420, 450],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" },
      "notes": "Posted only after 2 automatic retries fail, includes order ID, customer, and both retry timestamps." },
    { "id": "13", "name": "Stop - Payment Failed", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [2640, 450] },
    { "id": "14", "name": "Merge Payment Success Paths", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [2420, 0],
      "parameters": { "mode": "combine", "numberInputs": 3 } },
    { "id": "15", "name": "Check Stock Availability", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2640, 0],
      "parameters": { "method": "GET", "url": "https://api.warehouse-provider.com/v1/inventory/{{$json.sku}}" } },
    { "id": "16", "name": "In Stock?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [2860, 0],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.available}}", "rightValue": "={{$json.quantity}}", "operator": { "type": "number", "operation": "gte" } } ] } } },
    { "id": "17", "name": "Send Backorder ETA Email", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3080, 150],
      "parameters": { "method": "POST", "url": "https://a.klaviyo.com/api/events" },
      "notes": "Customer hears about the delay immediately, with a real ETA, instead of finding out when the order doesn't arrive." },
    { "id": "18", "name": "Flag Order As Backorder", "type": "n8n-nodes-base.set", "typeVersion": 3, "position": [3300, 150],
      "parameters": { "assignments": { "assignments": [ { "name": "orderStatus", "value": "backorder", "type": "string" } ] } } },
    { "id": "19", "name": "Reserve Stock", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3080, -150],
      "parameters": { "method": "POST", "url": "https://api.warehouse-provider.com/v1/inventory/reserve" } },
    { "id": "20", "name": "Merge Stock Path", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [3520, 0],
      "parameters": { "mode": "chooseBranch" } },
    { "id": "21", "name": "Create Xero Invoice", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3740, 0],
      "parameters": { "method": "PUT", "url": "https://api.xero.com/api.xro/2.0/Invoices" } },
    { "id": "22", "name": "Calculate Stripe Fee Line", "type": "n8n-nodes-base.set", "typeVersion": 3, "position": [3960, 0],
      "parameters": { "assignments": { "assignments": [ { "name": "stripeFee", "value": "={{$json.grossAmount * 0.029 + 0.30}}", "type": "number" } ] } } },
    { "id": "23", "name": "Post Fee As Expense Line", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [4180, 0],
      "parameters": { "method": "PUT", "url": "https://api.xero.com/api.xro/2.0/BankTransactions" } },
    { "id": "24", "name": "Request Pick Pack", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [4400, 0],
      "parameters": { "method": "POST", "url": "https://api.warehouse-provider.com/v1/fulfillment/pick-pack" } },
    { "id": "25", "name": "Wait For Tracking Number", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [4620, 0],
      "parameters": { "resume": "webhook" },
      "notes": "Pauses the execution until the warehouse's fulfillment webhook confirms a tracking number, rather than polling." },
    { "id": "26", "name": "Get Tracking Number", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [4840, 0],
      "parameters": { "method": "GET", "url": "https://api.warehouse-provider.com/v1/fulfillment/{{$json.fulfillmentId}}" } },
    { "id": "27", "name": "Send Order Confirmation Email", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [5060, 0],
      "parameters": { "method": "POST", "url": "https://a.klaviyo.com/api/events" } },
    { "id": "28", "name": "Send Shipping Confirmation Email", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [5280, 0],
      "parameters": { "method": "POST", "url": "https://a.klaviyo.com/api/events" } },
    { "id": "29", "name": "Log Order To Ops Dashboard", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [5500, 0],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/orders_processed" },
      "notes": "Final record: every order that reached this point, with full timing data for each step it passed through." },
    { "id": "30", "name": "Setup Notes", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -450],
      "parameters": { "content": "## Setup\n1. Register this workflow's URL as a Shopify 'order creation' webhook.\n2. Configure your warehouse/3PL API base URL and auth in every 'warehouse-provider' node.\n3. Set retry timing (5 min / 30 min) to match your payment provider's guidance.\n4. Confirm the warehouse fulfillment webhook target matches Wait For Tracking Number.", "height": 260, "width": 440 } },
    { "id": "31", "name": "Credential Requirements", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -170],
      "parameters": { "content": "## Credentials needed\n- Shopify Admin API\n- Stripe secret key\n- Warehouse/3PL API key (provider-specific)\n- Xero OAuth2\n- Klaviyo Private API key\n- Slack Bot Token\n- Airtable Personal Access Token", "height": 230, "width": 440 } },
    { "id": "32", "name": "Escalation Runbook", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [2420, 620],
      "parameters": { "content": "## When this fires\nA human needs to manually retry or refund via the Stripe dashboard, then re-trigger fulfillment from Log Raw Order using n8n's 'retry from node' feature.", "height": 160, "width": 340 } }
  ],
  "connections": {
    "Shopify Order Webhook": { "main": [[{ "node": "Log Raw Order", "type": "main", "index": 0 }]] },
    "Log Raw Order": { "main": [[{ "node": "Extract Order Fields", "type": "main", "index": 0 }]] },
    "Extract Order Fields": { "main": [[{ "node": "Capture Stripe Payment", "type": "main", "index": 0 }]] },
    "Capture Stripe Payment": { "main": [[{ "node": "Payment Success?", "type": "main", "index": 0 }]] },
    "Payment Success?": { "main": [
      [{ "node": "Merge Payment Success Paths", "type": "main", "index": 0 }],
      [{ "node": "Wait 5 Min Before Retry 1", "type": "main", "index": 0 }]
    ] },
    "Wait 5 Min Before Retry 1": { "main": [[{ "node": "Retry Stripe Payment 1", "type": "main", "index": 0 }]] },
    "Retry Stripe Payment 1": { "main": [[{ "node": "Retry 1 Success?", "type": "main", "index": 0 }]] },
    "Retry 1 Success?": { "main": [
      [{ "node": "Merge Payment Success Paths", "type": "main", "index": 1 }],
      [{ "node": "Wait 30 Min Before Retry 2", "type": "main", "index": 0 }]
    ] },
    "Wait 30 Min Before Retry 2": { "main": [[{ "node": "Retry Stripe Payment 2", "type": "main", "index": 0 }]] },
    "Retry Stripe Payment 2": { "main": [[{ "node": "Retry 2 Success?", "type": "main", "index": 0 }]] },
    "Retry 2 Success?": { "main": [
      [{ "node": "Merge Payment Success Paths", "type": "main", "index": 2 }],
      [{ "node": "Escalate Payment Failure To Slack", "type": "main", "index": 0 }]
    ] },
    "Escalate Payment Failure To Slack": { "main": [[{ "node": "Stop - Payment Failed", "type": "main", "index": 0 }]] },
    "Merge Payment Success Paths": { "main": [[{ "node": "Check Stock Availability", "type": "main", "index": 0 }]] },
    "Check Stock Availability": { "main": [[{ "node": "In Stock?", "type": "main", "index": 0 }]] },
    "In Stock?": { "main": [
      [{ "node": "Reserve Stock", "type": "main", "index": 0 }],
      [{ "node": "Send Backorder ETA Email", "type": "main", "index": 0 }]
    ] },
    "Send Backorder ETA Email": { "main": [[{ "node": "Flag Order As Backorder", "type": "main", "index": 0 }]] },
    "Reserve Stock": { "main": [[{ "node": "Merge Stock Path", "type": "main", "index": 0 }]] },
    "Flag Order As Backorder": { "main": [[{ "node": "Merge Stock Path", "type": "main", "index": 1 }]] },
    "Merge Stock Path": { "main": [[{ "node": "Create Xero Invoice", "type": "main", "index": 0 }]] },
    "Create Xero Invoice": { "main": [[{ "node": "Calculate Stripe Fee Line", "type": "main", "index": 0 }]] },
    "Calculate Stripe Fee Line": { "main": [[{ "node": "Post Fee As Expense Line", "type": "main", "index": 0 }]] },
    "Post Fee As Expense Line": { "main": [[{ "node": "Request Pick Pack", "type": "main", "index": 0 }]] },
    "Request Pick Pack": { "main": [[{ "node": "Wait For Tracking Number", "type": "main", "index": 0 }]] },
    "Wait For Tracking Number": { "main": [[{ "node": "Get Tracking Number", "type": "main", "index": 0 }]] },
    "Get Tracking Number": { "main": [[{ "node": "Send Order Confirmation Email", "type": "main", "index": 0 }]] },
    "Send Order Confirmation Email": { "main": [[{ "node": "Send Shipping Confirmation Email", "type": "main", "index": 0 }]] },
    "Send Shipping Confirmation Email": { "main": [[{ "node": "Log Order To Ops Dashboard", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCreatedBy": "PURIST", "instanceId": "purist-template-order-to-cash-failure-recovery" }
}
