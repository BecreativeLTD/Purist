{
  "name": "AI Lead Qualification & Routing (24 nodes)",
  "nodes": [
    { "id": "1", "name": "Typeform Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0],
      "parameters": { "path": "lead-form", "httpMethod": "POST" } },
    { "id": "2", "name": "Log Raw Submission", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [220, 0],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/raw_submissions" } },
    { "id": "3", "name": "Extract Form Fields", "type": "n8n-nodes-base.set", "typeVersion": 3, "position": [440, 0],
      "parameters": { "assignments": { "assignments": [
        { "name": "email", "value": "={{$json.answers.email}}", "type": "string" },
        { "name": "company", "value": "={{$json.answers.company}}", "type": "string" },
        { "name": "statedBudget", "value": "={{$json.answers.budget}}", "type": "string" }
      ] } } },
    { "id": "4", "name": "Company Enrichment Lookup", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, 0],
      "parameters": { "method": "GET", "url": "https://company.clearbit.com/v2/companies/find" } },
    { "id": "5", "name": "Enrichment Succeeded?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [880, 0],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.statusCode}}", "rightValue": 200, "operator": { "type": "number", "operation": "equals" } } ] } } },
    { "id": "6", "name": "Use Fallback Enrichment Data", "type": "n8n-nodes-base.set", "typeVersion": 3, "position": [1100, 150],
      "parameters": { "assignments": { "assignments": [ { "name": "companySize", "value": "unknown", "type": "string" } ] } },
      "notes": "If Clearbit has no record, the lead still gets scored on form data alone rather than dropped." },
    { "id": "7", "name": "Merge Enrichment Path", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [1320, 0],
      "parameters": { "mode": "chooseBranch" } },
    { "id": "8", "name": "Build AI Scoring Prompt", "type": "n8n-nodes-base.set", "typeVersion": 3, "position": [1540, 0],
      "parameters": { "assignments": { "assignments": [ { "name": "prompt", "value": "=Score this lead 0-100 against our ICP: {{$json}}", "type": "string" } ] } } },
    { "id": "9", "name": "Claude Score Lead", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1760, 0],
      "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages" },
      "notes": "Calls Claude to score the lead 0-100 against the configured ICP and return a one-line reason." },
    { "id": "10", "name": "Parse AI Response", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1980, 0],
      "parameters": { "jsCode": "const body = JSON.parse($input.first().json.content[0].text);\nreturn [{ json: { score: body.score, reason: body.reason, confidence: body.confidence } }];" } },
    { "id": "11", "name": "Score Confident Enough?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [2200, 0],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.confidence}}", "rightValue": 0.6, "operator": { "type": "number", "operation": "gte" } } ] } } },
    { "id": "12", "name": "Flag For Manual Review", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [2420, 250],
      "notes": "Low-confidence scores never get auto-routed either way, a human decides." },
    { "id": "13", "name": "Hot Lead?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [2420, -100],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.score}}", "rightValue": 70, "operator": { "type": "number", "operation": "gte" } } ] } } },
    { "id": "14", "name": "Create HubSpot MQL", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2640, -200],
      "parameters": { "method": "POST", "url": "https://api.hubapi.com/crm/v3/objects/deals" } },
    { "id": "15", "name": "Assign To Rep Round Robin", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2860, -200],
      "parameters": { "method": "PATCH", "url": "https://api.hubapi.com/crm/v3/objects/deals/{{$json.id}}" } },
    { "id": "16", "name": "Format Slack Alert", "type": "n8n-nodes-base.set", "typeVersion": 3, "position": [3080, -200],
      "parameters": { "assignments": { "assignments": [ { "name": "message", "value": "=🔥 Hot lead: {{$json.company}} scored {{$json.score}}/100, {{$json.reason}}", "type": "string" } ] } } },
    { "id": "17", "name": "Post Hot Lead Slack Alert", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3300, -200],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" },
      "notes": "Target: under 90 seconds from form submission to this alert landing." },
    { "id": "18", "name": "Add To Nurture List", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2640, 0],
      "parameters": { "method": "PUT", "url": "https://api.hubapi.com/crm/v3/lists" } },
    { "id": "19", "name": "Trigger Nurture Email Sequence", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2860, 0],
      "parameters": { "method": "POST", "url": "https://api.hubapi.com/automation/v4/workflows/{{NURTURE_WORKFLOW_ID}}/enrollments" } },
    { "id": "20", "name": "Merge Routing Outcomes", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [3520, 0],
      "parameters": { "mode": "combine", "numberInputs": 3 } },
    { "id": "21", "name": "Log Lead Score To Airtable", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3740, 0],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/lead_scores" },
      "notes": "Every lead is logged with its score and outcome, hot, nurture or manual review, for later accuracy review." },
    { "id": "22", "name": "Update Typeform Response Tag", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3960, 0],
      "parameters": { "method": "PATCH", "url": "https://api.typeform.com/forms/{{FORM_ID}}/responses/{{$json.responseId}}" } },
    { "id": "23", "name": "Setup Notes", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -400],
      "parameters": { "content": "## Setup\n1. Connect this workflow's webhook URL as a Typeform 'webhook' integration on your lead form.\n2. Configure the ICP criteria inside Build AI Scoring Prompt.\n3. Set the score threshold in Hot Lead? (default 70).\n4. Point Assign To Rep Round Robin at your actual rep rotation logic.", "height": 240, "width": 420 } },
    { "id": "24", "name": "Credential Requirements", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -140],
      "parameters": { "content": "## Credentials needed\n- Typeform (webhook, no auth)\n- Clearbit API key\n- Anthropic API key (Claude)\n- HubSpot Private App token\n- Slack Bot Token\n- Airtable Personal Access Token", "height": 210, "width": 420 } }
  ],
  "connections": {
    "Typeform Webhook": { "main": [[{ "node": "Log Raw Submission", "type": "main", "index": 0 }]] },
    "Log Raw Submission": { "main": [[{ "node": "Extract Form Fields", "type": "main", "index": 0 }]] },
    "Extract Form Fields": { "main": [[{ "node": "Company Enrichment Lookup", "type": "main", "index": 0 }]] },
    "Company Enrichment Lookup": { "main": [[{ "node": "Enrichment Succeeded?", "type": "main", "index": 0 }]] },
    "Enrichment Succeeded?": { "main": [
      [{ "node": "Merge Enrichment Path", "type": "main", "index": 0 }],
      [{ "node": "Use Fallback Enrichment Data", "type": "main", "index": 0 }]
    ] },
    "Use Fallback Enrichment Data": { "main": [[{ "node": "Merge Enrichment Path", "type": "main", "index": 1 }]] },
    "Merge Enrichment Path": { "main": [[{ "node": "Build AI Scoring Prompt", "type": "main", "index": 0 }]] },
    "Build AI Scoring Prompt": { "main": [[{ "node": "Claude Score Lead", "type": "main", "index": 0 }]] },
    "Claude Score Lead": { "main": [[{ "node": "Parse AI Response", "type": "main", "index": 0 }]] },
    "Parse AI Response": { "main": [[{ "node": "Score Confident Enough?", "type": "main", "index": 0 }]] },
    "Score Confident Enough?": { "main": [
      [{ "node": "Hot Lead?", "type": "main", "index": 0 }],
      [{ "node": "Flag For Manual Review", "type": "main", "index": 0 }]
    ] },
    "Flag For Manual Review": { "main": [[{ "node": "Merge Routing Outcomes", "type": "main", "index": 2 }]] },
    "Hot Lead?": { "main": [
      [{ "node": "Create HubSpot MQL", "type": "main", "index": 0 }],
      [{ "node": "Add To Nurture List", "type": "main", "index": 0 }]
    ] },
    "Create HubSpot MQL": { "main": [[{ "node": "Assign To Rep Round Robin", "type": "main", "index": 0 }]] },
    "Assign To Rep Round Robin": { "main": [[{ "node": "Format Slack Alert", "type": "main", "index": 0 }]] },
    "Format Slack Alert": { "main": [[{ "node": "Post Hot Lead Slack Alert", "type": "main", "index": 0 }]] },
    "Post Hot Lead Slack Alert": { "main": [[{ "node": "Merge Routing Outcomes", "type": "main", "index": 0 }]] },
    "Add To Nurture List": { "main": [[{ "node": "Trigger Nurture Email Sequence", "type": "main", "index": 0 }]] },
    "Trigger Nurture Email Sequence": { "main": [[{ "node": "Merge Routing Outcomes", "type": "main", "index": 1 }]] },
    "Merge Routing Outcomes": { "main": [[{ "node": "Log Lead Score To Airtable", "type": "main", "index": 0 }]] },
    "Log Lead Score To Airtable": { "main": [[{ "node": "Update Typeform Response Tag", "type": "main", "index": 0 }]] }
  },
