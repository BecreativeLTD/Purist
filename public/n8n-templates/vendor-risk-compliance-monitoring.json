{
  "name": "Vendor Risk & Compliance Monitoring (24 nodes)",
  "nodes": [
    { "id": "1", "name": "New Vendor Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, -150],
      "parameters": { "path": "new-vendor", "httpMethod": "POST" } },
    { "id": "2", "name": "Quarterly Review Schedule", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1, "position": [0, 250],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 6 1 */3 *" }] } } },
    { "id": "3", "name": "Send Risk Questionnaire", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [220, -150],
      "parameters": { "method": "POST", "url": "https://api.hsforms.com/submissions/v3/integration/submit" } },
    { "id": "4", "name": "Questionnaire Response Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [440, -150],
      "parameters": { "path": "vendor-questionnaire-response", "httpMethod": "POST" } },
    { "id": "5", "name": "AI Risk Scoring", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, -150],
      "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages" },
      "notes": "Scores data handling, sub-processor use, security certifications and financial stability signals from the questionnaire." },
    { "id": "6", "name": "Risk Tier Router", "type": "n8n-nodes-base.switch", "typeVersion": 3, "position": [880, -150],
      "parameters": { "mode": "rules", "rules": { "values": [
        { "outputKey": "high", "conditions": { "conditions": [ { "leftValue": "={{$json.riskScore}}", "rightValue": 70, "operator": { "type": "number", "operation": "gte" } } ] } },
        { "outputKey": "medium", "conditions": { "conditions": [ { "leftValue": "={{$json.riskScore}}", "rightValue": 40, "operator": { "type": "number", "operation": "gte" } } ] } },
        { "outputKey": "low", "conditions": { "conditions": [ { "leftValue": "={{$json.riskScore}}", "rightValue": 40, "operator": { "type": "number", "operation": "lt" } } ] } }
      ] } } },
    { "id": "7", "name": "Request Additional Docs", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1100, -300],
      "parameters": { "method": "POST", "url": "https://api.resend.com/emails" },
      "notes": "High-risk vendors must provide insurance certificates and a current SOC 2 or ISO 27001 report before approval." },
    { "id": "8", "name": "Route To Legal Review", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1320, -300],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" } },
    { "id": "9", "name": "Wait For Legal Sign-Off", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [1540, -300],
      "parameters": { "resume": "webhook" } },
    { "id": "10", "name": "Standard Approval", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1100, -150],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" } },
    { "id": "11", "name": "Auto-Approve", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [1100, 0] },
    { "id": "12", "name": "Merge Approval Paths", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [1760, -150],
      "parameters": { "mode": "combine", "numberInputs": 3 } },
    { "id": "13", "name": "Store Vendor Record", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1980, -150],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/vendor_registry" } },
    { "id": "14", "name": "Set Next Review Date", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2200, -150],
      "parameters": { "jsCode": "// High risk: review in 6 months. Medium: 12 months. Low: 24 months.\nreturn $input.all();" } },
    { "id": "15", "name": "Get Vendors Due For Review", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [220, 250],
      "parameters": { "method": "GET", "url": "https://api.airtable.com/v0/{{BASE_ID}}/vendor_registry" } },
    { "id": "16", "name": "Split In Batches", "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [440, 250],
      "parameters": { "batchSize": 10 } },
    { "id": "17", "name": "Check Insurance/Cert Expiry", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [660, 250],
      "parameters": { "jsCode": "const daysToExpiry = Math.ceil((new Date($json.certExpiryDate) - new Date()) / 86400000);\nreturn [{ json: { ...$json, daysToExpiry } }];" } },
    { "id": "18", "name": "Expiring Within 30 Days?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [880, 250],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.daysToExpiry}}", "rightValue": 30, "operator": { "type": "number", "operation": "lte" } } ] } } },
    { "id": "19", "name": "Request Renewed Documentation", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1100, 150],
      "parameters": { "method": "POST", "url": "https://api.resend.com/emails" } },
    { "id": "20", "name": "Wait 14 Days For Response", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [1320, 150],
      "parameters": { "amount": 14, "unit": "days" } },
    { "id": "21", "name": "Documentation Received?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1540, 150],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.docsReceived}}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } } ] } } },
    { "id": "22", "name": "Escalate To Procurement", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1760, 300],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" },
      "notes": "An expired certification with no renewal on file is a genuine compliance exposure, not a reminder to snooze." },
    { "id": "23", "name": "Update Risk Registry", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1760, 150],
      "parameters": { "method": "PATCH", "url": "https://api.airtable.com/v0/{{BASE_ID}}/vendor_registry/{{$json.recordId}}" } },
    { "id": "24", "name": "Setup Notes", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -500],
      "parameters": { "content": "## Setup\n1. Build your risk questionnaire (Typeform/HubSpot forms) covering data handling, sub-processors, certifications.\n2. Tune AI Risk Scoring thresholds (default 70/40) to your actual risk appetite.\n3. Set review cadence per tier in Set Next Review Date.", "height": 210, "width": 420 } }
  ],
  "connections": {
    "New Vendor Webhook": { "main": [[{ "node": "Send Risk Questionnaire", "type": "main", "index": 0 }]] },
    "Send Risk Questionnaire": { "main": [[{ "node": "Questionnaire Response Webhook", "type": "main", "index": 0 }]] },
    "Questionnaire Response Webhook": { "main": [[{ "node": "AI Risk Scoring", "type": "main", "index": 0 }]] },
    "AI Risk Scoring": { "main": [[{ "node": "Risk Tier Router", "type": "main", "index": 0 }]] },
    "Risk Tier Router": { "main": [
      [{ "node": "Request Additional Docs", "type": "main", "index": 0 }],
      [{ "node": "Standard Approval", "type": "main", "index": 0 }],
      [{ "node": "Auto-Approve", "type": "main", "index": 0 }]
    ] },
    "Request Additional Docs": { "main": [[{ "node": "Route To Legal Review", "type": "main", "index": 0 }]] },
    "Route To Legal Review": { "main": [[{ "node": "Wait For Legal Sign-Off", "type": "main", "index": 0 }]] },
    "Wait For Legal Sign-Off": { "main": [[{ "node": "Merge Approval Paths", "type": "main", "index": 0 }]] },
    "Standard Approval": { "main": [[{ "node": "Merge Approval Paths", "type": "main", "index": 1 }]] },
    "Auto-Approve": { "main": [[{ "node": "Merge Approval Paths", "type": "main", "index": 2 }]] },
    "Merge Approval Paths": { "main": [[{ "node": "Store Vendor Record", "type": "main", "index": 0 }]] },
    "Store Vendor Record": { "main": [[{ "node": "Set Next Review Date", "type": "main", "index": 0 }]] },
    "Quarterly Review Schedule": { "main": [[{ "node": "Get Vendors Due For Review", "type": "main", "index": 0 }]] },
    "Get Vendors Due For Review": { "main": [[{ "node": "Split In Batches", "type": "main", "index": 0 }]] },
    "Split In Batches": { "main": [[{ "node": "Check Insurance/Cert Expiry", "type": "main", "index": 0 }]] },
    "Check Insurance/Cert Expiry": { "main": [[{ "node": "Expiring Within 30 Days?", "type": "main", "index": 0 }]] },
    "Expiring Within 30 Days?": { "main": [
      [{ "node": "Request Renewed Documentation", "type": "main", "index": 0 }],
      [{ "node": "Update Risk Registry", "type": "main", "index": 0 }]
    ] },
    "Request Renewed Documentation": { "main": [[{ "node": "Wait 14 Days For Response", "type": "main", "index": 0 }]] },
    "Wait 14 Days For Response": { "main": [[{ "node": "Documentation Received?", "type": "main", "index": 0 }]] },
    "Documentation Received?": { "main": [
      [{ "node": "Update Risk Registry", "type": "main", "index": 0 }],
      [{ "node": "Escalate To Procurement", "type": "main", "index": 0 }]
    ] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCreatedBy": "PURIST", "instanceId": "purist-template-vendor-risk-compliance-monitoring" }
}
