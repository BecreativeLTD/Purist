{
  "name": "Competitive Intelligence Monitoring (24 nodes)",
  "nodes": [
    { "id": "1", "name": "Daily Monitoring Schedule", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1, "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 7 * * *" }] } } },
    { "id": "2", "name": "Get Competitor List", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [220, 0],
      "parameters": { "method": "GET", "url": "https://api.airtable.com/v0/{{BASE_ID}}/competitors" } },
    { "id": "3", "name": "Split In Batches", "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [440, 0],
      "parameters": { "batchSize": 5 } },
    { "id": "4", "name": "Scrape Pricing Page", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, -200],
      "parameters": { "method": "GET", "url": "https://api.diffbot.com/v3/analyze" } },
    { "id": "5", "name": "Fetch Job Postings", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, 0],
      "parameters": { "method": "GET", "url": "https://api.greenhouse.io/v1/boards/{{$json.competitorSlug}}/jobs" },
      "notes": "Hiring signals (new roles for a product line, a new market, a new function) often precede public announcements by months." },
    { "id": "6", "name": "Fetch News Mentions", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, 200],
      "parameters": { "method": "GET", "url": "https://newsapi.org/v2/everything" } },
    { "id": "7", "name": "Merge All Sources", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [880, 0],
      "parameters": { "mode": "combine", "numberInputs": 3 } },
    { "id": "8", "name": "Get Previous Snapshot", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1100, 0],
      "parameters": { "method": "GET", "url": "https://api.airtable.com/v0/{{BASE_ID}}/competitor_snapshots" } },
    { "id": "9", "name": "AI Diff & Summarize", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1320, 0],
      "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages" },
      "notes": "Compares today's pull against the last snapshot and summarizes only what actually changed, not the full page content again." },
    { "id": "10", "name": "Change Detected?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1540, 0],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.hasChange}}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } } ] } } },
    { "id": "11", "name": "Classify Change Type", "type": "n8n-nodes-base.switch", "typeVersion": 3, "position": [1760, -150],
      "parameters": { "mode": "rules", "rules": { "values": [
        { "outputKey": "pricing", "conditions": { "conditions": [ { "leftValue": "={{$json.changeType}}", "rightValue": "pricing", "operator": { "type": "string", "operation": "equals" } } ] } },
        { "outputKey": "hiring", "conditions": { "conditions": [ { "leftValue": "={{$json.changeType}}", "rightValue": "hiring", "operator": { "type": "string", "operation": "equals" } } ] } },
        { "outputKey": "news", "conditions": { "conditions": [ { "leftValue": "={{$json.changeType}}", "rightValue": "news", "operator": { "type": "string", "operation": "equals" } } ] } }
      ] } } },
    { "id": "12", "name": "Alert Pricing Team", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1980, -300],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" } },
    { "id": "13", "name": "Alert Strategy Team", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1980, -150],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" },
      "notes": "A cluster of new senior hires in one function is one of the most reliable early signals of a competitor's next move." },
    { "id": "14", "name": "Alert PR/Marketing", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1980, 0],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" } },
    { "id": "15", "name": "Store Snapshot Only", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [1760, 150] },
    { "id": "16", "name": "Merge Alert Paths", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [2200, 0],
      "parameters": { "mode": "combine", "numberInputs": 4 } },
    { "id": "17", "name": "Log Snapshot & Diff", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2420, 0],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/competitor_snapshots" } },
    { "id": "18", "name": "Loop Next Competitor", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [2640, 0] },
    { "id": "19", "name": "Weekly Digest Schedule", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1, "position": [220, 300],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 8 * * 1" }] } } },
    { "id": "20", "name": "Compile Week's Changes", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [440, 300],
      "parameters": { "method": "GET", "url": "https://api.airtable.com/v0/{{BASE_ID}}/competitor_snapshots" } },
    { "id": "21", "name": "AI Generate Weekly Digest", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, 300],
      "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages" } },
    { "id": "22", "name": "Send Digest To Leadership", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [880, 300],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" } },
    { "id": "23", "name": "Setup Notes", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -450],
      "parameters": { "content": "## Setup\n1. Load your tracked competitor list (pricing page URL, careers page slug, brand name for news search) into competitors.\n2. Tune the AI diff prompt to ignore cosmetic page changes and flag substantive ones.\n3. Route each alert type to the team that actually acts on it.", "height": 210, "width": 420 } },
    { "id": "24", "name": "Credential Requirements", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -220],
      "parameters": { "content": "## Credentials needed\n- Diffbot or equivalent web-scraping/extraction API\n- Greenhouse or Lever public job board API (most companies' postings are public)\n- NewsAPI or equivalent news search API\n- Anthropic API key, Airtable PAT, Slack Bot Token", "height": 200, "width": 420 } }
  ],
