{
  "name": "Sales Commission Calculation & Payout (25 nodes)",
  "nodes": [
    { "id": "1", "name": "Monthly Payout Schedule Trigger", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1, "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 6 1 * *" }] } } },
    { "id": "2", "name": "Pull Closed-Won Deals", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [220, 0],
      "parameters": { "method": "GET", "url": "https://api.hubapi.com/crm/v3/objects/deals" } },
    { "id": "3", "name": "Pull Rep Commission Plans", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [220, 200],
      "parameters": { "method": "GET", "url": "https://api.airtable.com/v0/{{BASE_ID}}/commission_plans" } },
    { "id": "4", "name": "Merge Deals & Plans", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [440, 100],
      "parameters": { "mode": "combine", "numberInputs": 2 } },
    { "id": "5", "name": "Split In Batches By Rep", "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [660, 100],
      "parameters": { "batchSize": 1 } },
    { "id": "6", "name": "Calculate Base Commission", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [880, 100],
      "parameters": { "jsCode": "// Sums closed-won deal value for this rep and applies their base commission rate\nreturn $input.all();" } },
    { "id": "7", "name": "Quota Exceeded?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1100, 100],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.totalClosed}}", "rightValue": "={{$json.quota}}", "operator": { "type": "number", "operation": "gt" } } ] } } },
    { "id": "8", "name": "Apply Accelerator Multiplier", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1320, 0],
      "parameters": { "jsCode": "// Revenue above quota is paid at the accelerated rate defined in the rep's plan\nreturn $input.all();" },
      "notes": "Most commission disputes trace back to accelerator math done inconsistently between reps, calculating it in one place fixes that." },
    { "id": "9", "name": "Merge Rate Paths", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [1540, 100],
      "parameters": { "mode": "chooseBranch" } },
    { "id": "10", "name": "Check For Clawbacks", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1760, 100],
      "parameters": { "method": "GET", "url": "https://api.hubapi.com/crm/v3/objects/deals" },
      "notes": "Checks for deals from prior periods that were refunded or churned within their clawback window." },
    { "id": "11", "name": "Apply Clawback Deductions", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1980, 100],
      "parameters": { "jsCode": "// Deducts previously-paid commission on any deal refunded or churned inside the clawback period\nreturn $input.all();" } },
    { "id": "12", "name": "Calculate Final Payout", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2200, 100],
      "parameters": { "jsCode": "const finalPayout = $json.baseCommission + $json.acceleratorBonus - $json.clawbackDeduction;\nreturn [{ json: { ...$json, finalPayout } }];" } },
    { "id": "13", "name": "Deal Attribution Disputed?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [2420, 100],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.hasDispute}}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } } ] } } },
    { "id": "14", "name": "Hold For Manual Review", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2640, 250],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" } },
    { "id": "15", "name": "Generate Commission Statement", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2640, 0],
      "parameters": { "method": "POST", "url": "https://docs.google.com/document" },
      "notes": "Line-item statement showing every deal, base rate, accelerator, and any clawback, not just a final number." },
    { "id": "16", "name": "Send Statement To Rep", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2860, 0],
      "parameters": { "method": "POST", "url": "https://api.resend.com/emails" } },
    { "id": "17", "name": "Manager Approval Gate", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [3080, 0],
      "parameters": { "resume": "webhook" } },
    { "id": "18", "name": "Approved?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [3300, 0],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.approved}}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } } ] } } },
    { "id": "19", "name": "Submit To Payroll", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3520, -150],
      "parameters": { "method": "POST", "url": "https://api.gusto.com/v1/payrolls" } },
    { "id": "20", "name": "Return For Correction", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3520, 150],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" } },
    { "id": "21", "name": "Log Payout Record", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3740, -150],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/commission_payouts" } },
    { "id": "22", "name": "Loop Next Rep", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [3960, 0] },
    { "id": "23", "name": "All Reps Processed", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [660, -200] },
    { "id": "24", "name": "Setup Notes", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -400],
      "parameters": { "content": "## Setup\n1. Load each rep's plan (base rate, accelerator tiers, quota) into commission_plans.\n2. Define your clawback window (typically 90-180 days) in Apply Clawback Deductions.\n3. Wire Manager Approval Gate to a simple internal approval link.", "height": 200, "width": 420 } },
    { "id": "25", "name": "Credential Requirements", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -170],
      "parameters": { "content": "## Credentials needed\n- CRM API (HubSpot or Salesforce)\n- Airtable PAT\n- Payroll API (Gusto, Rippling, or your provider)\n- Slack Bot Token, Resend API key", "height": 180, "width": 420 } }
  ],
  "connections": {
    "Monthly Payout Schedule Trigger": { "main": [[{ "node": "Pull Closed-Won Deals", "type": "main", "index": 0 }, { "node": "Pull Rep Commission Plans", "type": "main", "index": 0 }]] },
    "Pull Closed-Won Deals": { "main": [[{ "node": "Merge Deals & Plans", "type": "main", "index": 0 }]] },
    "Pull Rep Commission Plans": { "main": [[{ "node": "Merge Deals & Plans", "type": "main", "index": 1 }]] },
    "Merge Deals & Plans": { "main": [[{ "node": "Split In Batches By Rep", "type": "main", "index": 0 }]] },
    "Split In Batches By Rep": { "main": [
      [{ "node": "All Reps Processed", "type": "main", "index": 0 }],
      [{ "node": "Calculate Base Commission", "type": "main", "index": 0 }]
    ] },
    "Calculate Base Commission": { "main": [[{ "node": "Quota Exceeded?", "type": "main", "index": 0 }]] },
    "Quota Exceeded?": { "main": [
      [{ "node": "Apply Accelerator Multiplier", "type": "main", "index": 0 }],
      [{ "node": "Merge Rate Paths", "type": "main", "index": 1 }]
    ] },
    "Apply Accelerator Multiplier": { "main": [[{ "node": "Merge Rate Paths", "type": "main", "index": 0 }]] },
    "Merge Rate Paths": { "main": [[{ "node": "Check For Clawbacks", "type": "main", "index": 0 }]] },
    "Check For Clawbacks": { "main": [[{ "node": "Apply Clawback Deductions", "type": "main", "index": 0 }]] },
    "Apply Clawback Deductions": { "main": [[{ "node": "Calculate Final Payout", "type": "main", "index": 0 }]] },
    "Calculate Final Payout": { "main": [[{ "node": "Deal Attribution Disputed?", "type": "main", "index": 0 }]] },
    "Deal Attribution Disputed?": { "main": [
      [{ "node": "Generate Commission Statement", "type": "main", "index": 0 }],
      [{ "node": "Hold For Manual Review", "type": "main", "index": 0 }]
    ] },
    "Generate Commission Statement": { "main": [[{ "node": "Send Statement To Rep", "type": "main", "index": 0 }]] },
    "Send Statement To Rep": { "main": [[{ "node": "Manager Approval Gate", "type": "main", "index": 0 }]] },
    "Manager Approval Gate": { "main": [[{ "node": "Approved?", "type": "main", "index": 0 }]] },
    "Approved?": { "main": [
      [{ "node": "Submit To Payroll", "type": "main", "index": 0 }],
      [{ "node": "Return For Correction", "type": "main", "index": 0 }]
    ] },
    "Submit To Payroll": { "main": [[{ "node": "Log Payout Record", "type": "main", "index": 0 }]] },
    "Log Payout Record": { "main": [[{ "node": "Loop Next Rep", "type": "main", "index": 0 }]] },
    "Loop Next Rep": { "main": [[{ "node": "Split In Batches By Rep", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCreatedBy": "PURIST", "instanceId": "purist-template-sales-commission-calculation-payout" }
}
