{
  "name": "Customer Health Score & Churn Prediction (27 nodes)",
  "nodes": [
    { "id": "1", "name": "Daily Schedule Trigger", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1, "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 5 * * *" }] } } },
    { "id": "2", "name": "Get Active Customer List", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [220, 0],
      "parameters": { "method": "GET", "url": "https://api.hubapi.com/crm/v3/objects/companies" } },
    { "id": "3", "name": "Split In Batches", "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [440, 0],
      "parameters": { "batchSize": 25 },
      "notes": "Processes customers in batches of 25 to stay well within every downstream API's rate limits." },
    { "id": "4", "name": "Pull Product Usage Data", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, -200],
      "parameters": { "method": "GET", "url": "https://api.mixpanel.com/query/segmentation" } },
    { "id": "5", "name": "Pull Support Ticket History", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, 0],
      "parameters": { "method": "GET", "url": "https://api.zendesk.com/api/v2/search" } },
    { "id": "6", "name": "Pull Billing & Payment History", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, 200],
      "parameters": { "method": "GET", "url": "https://api.stripe.com/v1/invoices" } },
    { "id": "7", "name": "Pull Latest NPS Score", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, 400],
      "parameters": { "method": "GET", "url": "https://api.delighted.com/v1/survey_responses.json" } },
    { "id": "8", "name": "Merge All Signals", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [880, 100],
      "parameters": { "mode": "combine", "numberInputs": 4 } },
    { "id": "9", "name": "Calculate Usage Trend", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1100, 100],
      "parameters": { "jsCode": "// 28-day rolling usage trend, weighted toward core feature adoption\nreturn $input.all();" } },
    { "id": "10", "name": "Calculate Composite Health Score", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1320, 100],
      "parameters": { "jsCode": "// Weighted score: 40% usage trend, 25% support sentiment,\n// 20% payment health, 15% NPS. Returns 0-100.\nreturn $input.all();" },
      "notes": "The weighting is configurable, these defaults come from analysing which signal actually preceded churn most often historically." },
    { "id": "11", "name": "Score Changed Significantly?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1540, 100],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{Math.abs($json.score - $json.previousScore)}}", "rightValue": 15, "operator": { "type": "number", "operation": "gt" } } ] } },
      "notes": "Only meaningful score movements trigger action, avoids alert fatigue from noise." },
    { "id": "12", "name": "Health Tier", "type": "n8n-nodes-base.switch", "typeVersion": 3, "position": [1760, 0],
      "parameters": { "mode": "rules", "rules": { "values": [
        { "outputKey": "at_risk", "conditions": { "conditions": [ { "leftValue": "={{$json.score}}", "rightValue": 40, "operator": { "type": "number", "operation": "lt" } } ] } },
        { "outputKey": "healthy", "conditions": { "conditions": [ { "leftValue": "={{$json.score}}", "rightValue": 70, "operator": { "type": "number", "operation": "gte" } } ] } },
        { "outputKey": "watch", "conditions": { "conditions": [ { "leftValue": "={{$json.score}}", "rightValue": 40, "operator": { "type": "number", "operation": "gte" } } ] } }
      ] } } },
    { "id": "13", "name": "Trigger At-Risk Playbook", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1980, -200],
      "parameters": { "method": "POST", "url": "https://api.hubapi.com/automation/v4/workflows/{{AT_RISK_PLAYBOOK_ID}}/enrollments" } },
    { "id": "14", "name": "Alert Customer Success Manager", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2200, -200],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" },
      "notes": "Alert includes the score drop, the specific signal that moved most, and a suggested first action." },
    { "id": "15", "name": "Create Save Task In CRM", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2420, -200],
      "parameters": { "method": "POST", "url": "https://api.hubapi.com/crm/v3/objects/tasks" } },
    { "id": "16", "name": "Add To Watch List", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1980, 100],
      "parameters": { "method": "PATCH", "url": "https://api.hubapi.com/crm/v3/objects/companies/{{$json.companyId}}" } },
    { "id": "17", "name": "Schedule Proactive Check-In", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2200, 100],
      "parameters": { "method": "POST", "url": "https://www.googleapis.com/calendar/v3/calendars/primary/events" } },
    { "id": "18", "name": "Identify Expansion Opportunity", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1980, 350],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.usageTrend}}", "rightValue": 20, "operator": { "type": "number", "operation": "gt" } } ] } },
      "notes": "A healthy, growing account is also the moment to flag for upsell, not just churn prevention in reverse." },
    { "id": "19", "name": "Notify Account Manager Of Expansion Signal", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2200, 300],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" } },
    { "id": "20", "name": "Log No Action Needed", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [2200, 450] },
    { "id": "21", "name": "Merge Tier Outcomes", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [2640, 100],
      "parameters": { "mode": "combine", "numberInputs": 4 } },
    { "id": "22", "name": "Update Health Score Dashboard", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2860, 100],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/health_scores" } },
    { "id": "23", "name": "Log Score History", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3080, 100],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/score_history" },
      "notes": "Historical scores are what eventually let you validate and re-tune the weighting model against real churn outcomes." },
    { "id": "24", "name": "Loop Next Batch", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [3300, 100] },
    { "id": "25", "name": "All Batches Complete", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [660, -400] },
    { "id": "26", "name": "Setup Notes", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -450],
      "parameters": { "content": "## Setup\n1. Connect Mixpanel/Amplitude, Zendesk, Stripe and your NPS tool.\n2. Tune the scoring weights in Calculate Composite Health Score to your own churn data once you have 3+ months of history.\n3. Wire At-Risk Playbook and expansion alerts to your actual CS motions.", "height": 220, "width": 420 } },
    { "id": "27", "name": "Credential Requirements", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -200],
      "parameters": { "content": "## Credentials needed\n- HubSpot (or your CRM) private app token\n- Mixpanel/Amplitude API secret\n- Zendesk API token\n- Stripe secret key\n- Delighted or equivalent NPS API key\n- Slack Bot Token, Airtable PAT", "height": 200, "width": 420 } }
  ],
