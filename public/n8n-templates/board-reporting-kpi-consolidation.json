{
  "name": "Board Reporting & KPI Consolidation (26 nodes)",
  "nodes": [
    { "id": "1", "name": "Monthly Schedule Trigger", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1, "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 6 1 * *" }] } },
      "notes": "Fires at 06:00 on the 1st of each month, well before the board pack deadline." },
    { "id": "2", "name": "Pull Stripe MRR Data", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [220, -200],
      "parameters": { "method": "GET", "url": "https://api.stripe.com/v1/subscriptions" } },
    { "id": "3", "name": "Pull HubSpot Pipeline Data", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [220, 0],
      "parameters": { "method": "GET", "url": "https://api.hubapi.com/crm/v3/objects/deals" } },
    { "id": "4", "name": "Pull Xero P&L Data", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [220, 200],
      "parameters": { "method": "GET", "url": "https://api.xero.com/api.xro/2.0/Reports/ProfitAndLoss" } },
    { "id": "5", "name": "Merge Data Sources", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [440, 0],
      "parameters": { "mode": "combine", "numberInputs": 3 } },
    { "id": "6", "name": "Calculate MRR & Growth", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [660, 0],
      "parameters": { "jsCode": "// Computes MRR, net revenue retention, and month-over-month growth\nreturn $input.all();" },
      "notes": "Net revenue retention = (starting MRR + expansion - contraction - churn) / starting MRR." },
    { "id": "7", "name": "Calculate Pipeline Metrics", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [880, 0],
      "parameters": { "jsCode": "// Win rate, average deal size, pipeline coverage ratio vs quota\nreturn $input.all();" } },
    { "id": "8", "name": "Data Quality Check", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1100, 0],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.missingFields.length}}", "rightValue": 0, "operator": { "type": "number", "operation": "equals" } } ] } },
      "notes": "A board pack built on incomplete data is worse than a delayed one." },
    { "id": "9", "name": "Flag Missing Data To Finance", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1320, 150],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" } },
    { "id": "10", "name": "Wait For Correction", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [1540, 150],
      "parameters": { "resume": "webhook" } },
    { "id": "11", "name": "Compare Against Prior Month", "type": "n8n-nodes-base.set", "typeVersion": 3, "position": [1320, -150],
      "parameters": { "assignments": { "assignments": [ { "name": "momGrowth", "value": "={{($json.mrr - $json.priorMrr) / $json.priorMrr * 100}}", "type": "number" } ] } } },
    { "id": "12", "name": "Compare Against Budget", "type": "n8n-nodes-base.set", "typeVersion": 3, "position": [1540, -150],
      "parameters": { "assignments": { "assignments": [ { "name": "budgetVariance", "value": "={{($json.actual - $json.budget) / $json.budget * 100}}", "type": "number" } ] } } },
    { "id": "13", "name": "Variance Exceeds Threshold?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1760, -150],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{Math.abs($json.budgetVariance)}}", "rightValue": 10, "operator": { "type": "number", "operation": "gt" } } ] } } },
    { "id": "14", "name": "Generate Variance Commentary (AI)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1980, -250],
      "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages" },
      "notes": "Only material variances (>10%) get an AI-drafted explanation, not every line item." },
    { "id": "15", "name": "Merge Commentary Path", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [2200, -150],
      "parameters": { "mode": "chooseBranch" } },
    { "id": "16", "name": "Build KPI Summary Table", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2420, -150],
      "parameters": { "jsCode": "// Assembles the standard board KPI table: MRR, NRR, burn, runway, CAC, LTV\nreturn $input.all();" } },
    { "id": "17", "name": "Generate Board Deck (Google Slides)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2640, -150],
      "parameters": { "method": "POST", "url": "https://slides.googleapis.com/v1/presentations" } },
    { "id": "18", "name": "Populate Charts", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2860, -150],
      "parameters": { "method": "POST", "url": "https://slides.googleapis.com/v1/presentations/{{$json.presentationId}}:batchUpdate" } },
    { "id": "19", "name": "Export Deck As PDF", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3080, -150],
      "parameters": { "method": "GET", "url": "https://docs.google.com/presentation/d/{{$json.presentationId}}/export/pdf" } },
    { "id": "20", "name": "CEO Review Gate", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [3300, -150],
      "parameters": { "resume": "webhook" },
      "notes": "Nothing reaches the board without a human sign-off, this workflow drafts, it never sends unreviewed." },
    { "id": "21", "name": "Approved?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [3520, -150],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.approved}}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } } ] } } },
    { "id": "22", "name": "Request Revisions", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [3740, 0] },
    { "id": "23", "name": "Distribute To Board Members", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3740, -300],
      "parameters": { "method": "POST", "url": "https://api.docsend.com/v2/documents" },
      "notes": "Sent via a tracked data room link, not a plain email attachment, so open/view analytics are captured." },
    { "id": "24", "name": "Log Distribution Event", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3960, -300],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/board_reports" } },
    { "id": "25", "name": "Setup Notes", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -500],
      "parameters": { "content": "## Setup\n1. Connect Stripe, HubSpot and Xero read-only credentials.\n2. Set your board's variance-commentary threshold (default 10%).\n3. Point Generate Board Deck at your own Google Slides template ID.\n4. CEO Review Gate pauses until a webhook signals approval, wire this to a simple internal approval page.", "height": 240, "width": 420 } },
    { "id": "26", "name": "Credential Requirements", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -220],
      "parameters": { "content": "## Credentials needed\n- Stripe, HubSpot, Xero (read-only)\n- Anthropic API key\n- Google Slides/Docs OAuth2\n- DocSend or equivalent tracked-sharing API\n- Slack Bot Token, Airtable PAT", "height": 200, "width": 420 } }
  ],
  "connections": {
    "Monthly Schedule Trigger": { "main": [[{ "node": "Pull Stripe MRR Data", "type": "main", "index": 0 }, { "node": "Pull HubSpot Pipeline Data", "type": "main", "index": 0 }, { "node": "Pull Xero P&L Data", "type": "main", "index": 0 }]] },
    "Pull Stripe MRR Data": { "main": [[{ "node": "Merge Data Sources", "type": "main", "index": 0 }]] },
    "Pull HubSpot Pipeline Data": { "main": [[{ "node": "Merge Data Sources", "type": "main", "index": 1 }]] },
    "Pull Xero P&L Data": { "main": [[{ "node": "Merge Data Sources", "type": "main", "index": 2 }]] },
    "Merge Data Sources": { "main": [[{ "node": "Calculate MRR & Growth", "type": "main", "index": 0 }]] },
    "Calculate MRR & Growth": { "main": [[{ "node": "Calculate Pipeline Metrics", "type": "main", "index": 0 }]] },
    "Calculate Pipeline Metrics": { "main": [[{ "node": "Data Quality Check", "type": "main", "index": 0 }]] },
    "Data Quality Check": { "main": [
      [{ "node": "Compare Against Prior Month", "type": "main", "index": 0 }],
      [{ "node": "Flag Missing Data To Finance", "type": "main", "index": 0 }]
    ] },
    "Flag Missing Data To Finance": { "main": [[{ "node": "Wait For Correction", "type": "main", "index": 0 }]] },
    "Wait For Correction": { "main": [[{ "node": "Compare Against Prior Month", "type": "main", "index": 0 }]] },
    "Compare Against Prior Month": { "main": [[{ "node": "Compare Against Budget", "type": "main", "index": 0 }]] },
    "Compare Against Budget": { "main": [[{ "node": "Variance Exceeds Threshold?", "type": "main", "index": 0 }]] },
    "Variance Exceeds Threshold?": { "main": [
      [{ "node": "Generate Variance Commentary (AI)", "type": "main", "index": 0 }],
      [{ "node": "Merge Commentary Path", "type": "main", "index": 1 }]
    ] },
    "Generate Variance Commentary (AI)": { "main": [[{ "node": "Merge Commentary Path", "type": "main", "index": 0 }]] },
    "Merge Commentary Path": { "main": [[{ "node": "Build KPI Summary Table", "type": "main", "index": 0 }]] },
    "Build KPI Summary Table": { "main": [[{ "node": "Generate Board Deck (Google Slides)", "type": "main", "index": 0 }]] },
    "Generate Board Deck (Google Slides)": { "main": [[{ "node": "Populate Charts", "type": "main", "index": 0 }]] },
    "Populate Charts": { "main": [[{ "node": "Export Deck As PDF", "type": "main", "index": 0 }]] },
    "Export Deck As PDF": { "main": [[{ "node": "CEO Review Gate", "type": "main", "index": 0 }]] },
    "CEO Review Gate": { "main": [[{ "node": "Approved?", "type": "main", "index": 0 }]] },
