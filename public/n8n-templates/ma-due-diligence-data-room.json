{
  "name": "M&A Due Diligence Data Room (26 nodes)",
  "nodes": [
    { "id": "1", "name": "New DD Request Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0],
      "parameters": { "path": "dd-request", "httpMethod": "POST" } },
    { "id": "2", "name": "Send NDA For Signature", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [220, 0],
      "parameters": { "method": "POST", "url": "https://api.docusign.com/restapi/v2.1/accounts/{{ACCOUNT_ID}}/envelopes" } },
    { "id": "3", "name": "Wait For NDA Signature", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [440, 0],
      "parameters": { "resume": "webhook" },
      "notes": "No data room access exists until the NDA is fully executed, this gate is non-negotiable." },
    { "id": "4", "name": "Provision Data Room Folder Structure", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, 0],
      "parameters": { "method": "POST", "url": "https://www.googleapis.com/drive/v3/files" },
      "notes": "Creates the standard DD folder tree: Financials, Contracts, HR, IP, Litigation, Corporate, Other." },
    { "id": "5", "name": "Send Access & Checklist", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [880, 0],
      "parameters": { "method": "POST", "url": "https://api.resend.com/emails" } },
    { "id": "6", "name": "Document Uploaded Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [1100, 0],
      "parameters": { "path": "document-uploaded", "httpMethod": "POST" } },
    { "id": "7", "name": "AI Classify Document Type", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1320, 0],
      "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages" } },
    { "id": "8", "name": "DD Checklist Category Router", "type": "n8n-nodes-base.switch", "typeVersion": 3, "position": [1540, 0],
      "parameters": { "mode": "rules", "rules": { "values": [
        { "outputKey": "financials", "conditions": { "conditions": [ { "leftValue": "={{$json.docCategory}}", "rightValue": "financials", "operator": { "type": "string", "operation": "equals" } } ] } },
        { "outputKey": "contracts", "conditions": { "conditions": [ { "leftValue": "={{$json.docCategory}}", "rightValue": "contracts", "operator": { "type": "string", "operation": "equals" } } ] } },
        { "outputKey": "other", "conditions": { "conditions": [ { "leftValue": "={{$json.docCategory}}", "rightValue": "other", "operator": { "type": "string", "operation": "equals" } } ] } }
      ] } } },
    { "id": "9", "name": "Update Financials Checklist", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1760, -150],
      "parameters": { "method": "PATCH", "url": "https://api.airtable.com/v0/{{BASE_ID}}/dd_checklist" } },
    { "id": "10", "name": "Update Contracts Checklist", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1760, 0],
      "parameters": { "method": "PATCH", "url": "https://api.airtable.com/v0/{{BASE_ID}}/dd_checklist" } },
    { "id": "11", "name": "Update Other Checklist", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1760, 150],
      "parameters": { "method": "PATCH", "url": "https://api.airtable.com/v0/{{BASE_ID}}/dd_checklist" } },
    { "id": "12", "name": "Merge Checklist Updates", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [1980, 0],
      "parameters": { "mode": "combine", "numberInputs": 3 } },
    { "id": "13", "name": "AI Scan For Red Flags", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2200, 0],
      "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages" },
      "notes": "Scans for change-of-control clauses, undisclosed litigation, and material contract terms that could affect deal value." },
    { "id": "14", "name": "Red Flag Found?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [2420, 0],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.redFlagsFound}}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } } ] } } },
    { "id": "15", "name": "Alert Deal Team Immediately", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2640, -150],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" } },
    { "id": "16", "name": "Merge Red Flag Path", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [2860, 0],
      "parameters": { "mode": "chooseBranch" } },
    { "id": "17", "name": "Log Document Metadata & Summary", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [3080, 0],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/document_log" } },
    { "id": "18", "name": "Daily Checklist Check Schedule", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1, "position": [220, 300],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 9 * * *" }] } } },
    { "id": "19", "name": "Get Checklist Completion", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [440, 300],
      "parameters": { "method": "GET", "url": "https://api.airtable.com/v0/{{BASE_ID}}/dd_checklist" } },
    { "id": "20", "name": "Checklist 100% Complete?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [660, 300],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.completionPercent}}", "rightValue": 100, "operator": { "type": "number", "operation": "gte" } } ] } } },
    { "id": "21", "name": "Notify Deal Lead Complete", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [880, 250],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" } },
    { "id": "22", "name": "Send Missing Items Reminder", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [880, 400],
      "parameters": { "method": "POST", "url": "https://api.resend.com/emails" } },
    { "id": "23", "name": "Log Access Event", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [220, 550],
      "parameters": { "path": "data-room-access-event", "httpMethod": "POST" } },
    { "id": "24", "name": "Store Access Log", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [440, 550],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/access_log" },
      "notes": "Who viewed which document and when, a complete access audit trail is expected practice in any serious DD process." },
    { "id": "25", "name": "Setup Notes", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -450],
      "parameters": { "content": "## Setup\n1. Build your standard DD checklist (financials, contracts, HR, IP, litigation, corporate) in Airtable.\n2. Tune the AI red-flag prompt to your specific deal thesis, what would actually change valuation or kill the deal.\n3. Confirm your data room tool (Drive, DocSend, or a dedicated VDR) supports upload and access-event webhooks.", "height": 220, "width": 440 } },
    { "id": "26", "name": "Credential Requirements", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -190],
      "parameters": { "content": "## Credentials needed\n- DocuSign eSignature API\n- Google Drive OAuth2 (or your VDR's API)\n- Anthropic API key\n- Airtable PAT, Slack Bot Token, Resend API key", "height": 180, "width": 440 } }
  ],
