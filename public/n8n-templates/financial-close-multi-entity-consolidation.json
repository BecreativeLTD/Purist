{
  "name": "Financial Close & Multi-Entity Consolidation (28 nodes)",
  "nodes": [
    { "id": "1", "name": "Monthly Close Schedule Trigger", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1, "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 6 3 * *" }] } } },
    { "id": "2", "name": "Get Entity List", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [220, 0],
      "parameters": { "method": "GET", "url": "https://api.airtable.com/v0/{{BASE_ID}}/entities" } },
    { "id": "3", "name": "Split By Entity", "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [440, 0],
      "parameters": { "batchSize": 1 } },
    { "id": "4", "name": "Pull Entity Trial Balance", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [660, 0],
      "parameters": { "method": "GET", "url": "https://api.xero.com/api.xro/2.0/Reports/TrialBalance" } },
    { "id": "5", "name": "Validate Debits Equal Credits", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [880, 0],
      "parameters": { "jsCode": "const diff = Math.abs($json.totalDebits - $json.totalCredits);\nreturn [{ json: { ...$json, balanced: diff < 0.01, imbalance: diff } }];" } },
    { "id": "6", "name": "Trial Balance Balanced?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1100, 0],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.balanced}}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } } ] } } },
    { "id": "7", "name": "Alert Entity Controller", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1320, 150],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" },
      "notes": "An unbalanced trial balance stops that entity's close cold, better caught here than after consolidation." },
    { "id": "8", "name": "Wait For Correction", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [1540, 150],
      "parameters": { "resume": "webhook" } },
    { "id": "9", "name": "Is Foreign Entity?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1320, -150],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.reportingCurrency}}", "rightValue": "={{$json.groupCurrency}}", "operator": { "type": "string", "operation": "notEquals" } } ] } } },
    { "id": "10", "name": "Convert To Group Currency", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1540, -250],
      "parameters": { "method": "GET", "url": "https://api.exchangerate.host/latest" } },
    { "id": "11", "name": "Merge Currency Path", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [1760, -150],
      "parameters": { "mode": "chooseBranch" } },
    { "id": "12", "name": "Merge Validation Path", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [1980, 0],
      "parameters": { "mode": "chooseBranch" } },
    { "id": "13", "name": "Apply Intercompany Eliminations", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2200, 0],
      "parameters": { "jsCode": "// Matches intercompany receivables against intercompany payables across all entities in this run\nreturn $input.all();" },
      "notes": "Intercompany balances that do not net to zero are the single most common cause of a delayed close." },
    { "id": "14", "name": "Elimination Mismatch?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [2420, 0],
      "parameters": { "conditions": { "combinator": "and", "conditions": [ { "leftValue": "={{$json.eliminationVariance}}", "rightValue": 100, "operator": { "type": "number", "operation": "gt" } } ] } } },
    { "id": "15", "name": "Flag For Manual Reconciliation", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2640, 150],
      "parameters": { "method": "POST", "url": "https://slack.com/api/chat.postMessage" } },
    { "id": "16", "name": "Merge Elimination Path", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [2860, 0],
      "parameters": { "mode": "chooseBranch" } },
    { "id": "17", "name": "Loop Next Entity", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [3080, 0] },
    { "id": "18", "name": "All Entities Processed", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [660, -300] },
    { "id": "19", "name": "Consolidate Group Financials", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [880, -300],
      "parameters": { "jsCode": "// Aggregates all entity trial balances (post-elimination) into a single group P&L and balance sheet\nreturn $input.all();" } },
    { "id": "20", "name": "Compare Against Prior Month & Budget", "type": "n8n-nodes-base.set", "typeVersion": 3, "position": [1100, -300],
      "parameters": { "assignments": { "assignments": [ { "name": "variance", "value": "={{($json.actual - $json.budget) / $json.budget * 100}}", "type": "number" } ] } } },
    { "id": "21", "name": "AI Variance Commentary", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1320, -300],
      "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages" } },
    { "id": "22", "name": "Generate Close Package", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1540, -300],
      "parameters": { "method": "POST", "url": "https://slides.googleapis.com/v1/presentations" } },
    { "id": "23", "name": "CFO Review Gate", "type": "n8n-nodes-base.wait", "typeVersion": 1, "position": [1760, -300],
      "parameters": { "resume": "webhook" } },
    { "id": "24", "name": "Distribute Close Package", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1980, -300],
      "parameters": { "method": "POST", "url": "https://api.resend.com/emails" } },
    { "id": "25", "name": "Lock Accounting Period", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2200, -300],
      "parameters": { "method": "POST", "url": "https://api.xero.com/api.xro/2.0/Organisation" },
      "notes": "Locking the period after distribution prevents post-close edits from silently invalidating the reported numbers." },
    { "id": "26", "name": "Log Close Cycle Metrics", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [2420, -300],
      "parameters": { "method": "POST", "url": "https://api.airtable.com/v0/{{BASE_ID}}/close_cycle_log" } },
    { "id": "27", "name": "Setup Notes", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -550],
      "parameters": { "content": "## Setup\n1. Load your entity list with accounting system credentials and group/reporting currency per entity.\n2. Configure your intercompany chart-of-accounts mapping for the elimination logic.\n3. CFO Review Gate should be the only path to Distribute Close Package, never bypass it.", "height": 210, "width": 440 } },
    { "id": "28", "name": "Credential Requirements", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -300],
      "parameters": { "content": "## Credentials needed\n- Accounting API per entity (Xero, QuickBooks, NetSuite)\n- Exchange rate API for multi-currency entities\n- Anthropic API key, Google Slides OAuth2\n- Airtable PAT, Slack Bot Token, Resend API key", "height": 200, "width": 440 } }
  ],
  "connections": {
    "Monthly Close Schedule Trigger": { "main": [[{ "node": "Get Entity List", "type": "main", "index": 0 }]] },
    "Get Entity List": { "main": [[{ "node": "Split By Entity", "type": "main", "index": 0 }]] },
    "Split By Entity": { "main": [
      [{ "node": "All Entities Processed", "type": "main", "index": 0 }],
      [{ "node": "Pull Entity Trial Balance", "type": "main", "index": 0 }]
    ] },
    "Pull Entity Trial Balance": { "main": [[{ "node": "Validate Debits Equal Credits", "type": "main", "index": 0 }]] },
    "Validate Debits Equal Credits": { "main": [[{ "node": "Trial Balance Balanced?", "type": "main", "index": 0 }]] },
    "Trial Balance Balanced?": { "main": [
      [{ "node": "Is Foreign Entity?", "type": "main", "index": 0 }],
      [{ "node": "Alert Entity Controller", "type": "main", "index": 0 }]
    ] },
    "Alert Entity Controller": { "main": [[{ "node": "Wait For Correction", "type": "main", "index": 0 }]] },
    "Wait For Correction": { "main": [[{ "node": "Merge Validation Path", "type": "main", "index": 1 }]] },
    "Is Foreign Entity?": { "main": [
      [{ "node": "Convert To Group Currency", "type": "main", "index": 0 }],
      [{ "node": "Merge Currency Path", "type": "main", "index": 1 }]
    ] },
    "Convert To Group Currency": { "main": [[{ "node": "Merge Currency Path", "type": "main", "index": 0 }]] },
    "Merge Currency Path": { "main": [[{ "node": "Merge Validation Path", "type": "main", "index": 0 }]] },
    "Merge Validation Path": { "main": [[{ "node": "Apply Intercompany Eliminations", "type": "main", "index": 0 }]] },
    "Apply Intercompany Eliminations": { "main": [[{ "node": "Elimination Mismatch?", "type": "main", "index": 0 }]] },
    "Elimination Mismatch?": { "main": [
      [{ "node": "Flag For Manual Reconciliation", "type": "main", "index": 0 }],
      [{ "node": "Merge Elimination Path", "type": "main", "index": 1 }]
    ] },
    "Flag For Manual Reconciliation": { "main": [[{ "node": "Merge Elimination Path", "type": "main", "index": 0 }]] },
    "Merge Elimination Path": { "main": [[{ "node": "Loop Next Entity", "type": "main", "index": 0 }]] },
    "Loop Next Entity": { "main": [[{ "node": "Split By Entity", "type": "main", "index": 0 }]] },
    "All Entities Processed": { "main": [[{ "node": "Consolidate Group Financials", "type": "main", "index": 0 }]] },
    "Consolidate Group Financials": { "main": [[{ "node": "Compare Against Prior Month & Budget", "type": "main", "index": 0 }]] },
    "Compare Against Prior Month & Budget": { "main": [[{ "node": "AI Variance Commentary", "type": "main", "index": 0 }]] },
    "AI Variance Commentary": { "main": [[{ "node": "Generate Close Package", "type": "main", "index": 0 }]] },
    "Generate Close Package": { "main": [[{ "node": "CFO Review Gate", "type": "main", "index": 0 }]] },
    "CFO Review Gate": { "main": [[{ "node": "Distribute Close Package", "type": "main", "index": 0 }]] },
    "Distribute Close Package": { "main": [[{ "node": "Lock Accounting Period", "type": "main", "index": 0 }]] },
    "Lock Accounting Period": { "main": [[{ "node": "Log Close Cycle Metrics", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCreatedBy": "PURIST", "instanceId": "purist-template-financial-close-multi-entity-consolidation" }
}
